{"surah": {"id": 87, "nameArabic": "سُورَةُ الأَعۡلَىٰ", "nameLatin": "Al-A'laa", "translationId": "Yang Paling Tinggi", "revelationPlace": "Makkiyah", "totalAyahs": 19}, "ayahs": [{"id": 5949, "surahId": 87, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "translationId": "Sucikanlah nama Tuhanmu Yang Maha Tingi,", "textTajweed": "سَبِّحِ [h:14437[ٱ]سْمَ رَبِّكَ [h:14438[ٱ]لْأَعْلَى"}, {"id": 5950, "surahId": 87, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "translationId": "yang menciptakan, dan menyempurnakan (penciptaan-Nya),", "textTajweed": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"}, {"id": 5951, "surahId": 87, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "translationId": "dan yang menentukan kadar (masing-masing) dan memberi petunjuk,", "textTajweed": "وَ[h:9999[ٱ]لَّذِى قَدَّرَ فَهَدَىٰ"}, {"id": 5952, "surahId": 87, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "translationId": "dan yang menumbuhkan rumput-rumputan,", "textTajweed": "وَ[h:9999[ٱ]لَّذ[o[ِىٓ] أَخْرَجَ [h:14439[ٱ]لْمَرْعَىٰ"}, {"id": 5953, "surahId": 87, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "translationId": "lalu dijadikan-Nya rumput-rumput itu kering kehitam-hitaman.", "textTajweed": "فَجَعَلَهُ[n[ۥ] غُث[o[َا]ٓءً أَحْوَىٰ"}, {"id": 5954, "surahId": 87, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "translationId": "Kami akan membacakan (Al Quran) kepadamu (Muhammad) maka kamu tidak akan lupa,", "textTajweed": "سَنُ[q:14440[قْ]رِئُكَ فَلَا تَ[f:14441[نس]َىٰٓ"}, {"id": 5955, "surahId": 87, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "translationId": "kecuali kalau Allah menghendaki. Sesungguhnya Dia mengetahui yang terang dan yang tersembunyi.", "textTajweed": "إِلَّا مَا ش[o[َا]ٓءَ [h:78[ٱ]للَّهُ‌ۚ إِ[g[نّ]َهُ[n[ۥ] يَعْلَمُ [h:8891[ٱ]لْجَهْرَ وَمَا يَخْفَىٰ"}, {"id": 5956, "surahId": 87, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "translationId": "dan Kami akan memberi kamu taufik ke jalan yang mudah,", "textTajweed": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"}, {"id": 5957, "surahId": 87, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "translationId": "oleh sebab itu berikanlah peringatan karena peringatan itu bermanfaat,", "textTajweed": "فَذَكِّرْ إ[a:14442[ِن ن]َّفَعَتِ [h:14443[ٱ][l[ل]ذِّكْرَىٰ"}, {"id": 5958, "surahId": 87, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "translationId": "orang yang takut (kepada Allah) akan mendapat pelajaran,", "textTajweed": "سَيَذَّكَّرُ م[a:14444[َن ي]َخْشَىٰ"}, {"id": 5959, "surahId": 87, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "translationId": "dan orang-orang yang celaka (kafir) akan menjauhinya.", "textTajweed": "وَيَتَجَ[g[نّ]َبُهَا [h:14445[ٱ]لْأَشْقَى"}, {"id": 5960, "surahId": 87, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "translationId": "(Yaitu) orang yang akan memasuki api yang besar (neraka).", "textTajweed": "ٱلَّذِى يَصْلَى [h:14446[ٱ][l[ل][g[نّ]َارَ [h:14447[ٱ]لْكُ[q:8463[بْ]رَىٰ"}, {"id": 5961, "surahId": 87, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "translationId": "Kemudian dia tidak akan mati di dalamnya dan tidak (pula) hidup.", "textTajweed": "ثُ[g[مّ]َ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"}, {"id": 5962, "surahId": 87, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "translationId": "Sesungguhnya beruntunglah orang yang membersihkan diri (dengan beriman),", "textTajweed": "قَ[q:298[دْ] أَفْلَحَ مَ[f:8555[ن ت]َزَكَّىٰ"}, {"id": 5963, "surahId": 87, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "translationId": "dan dia ingat nama Tuhannya, lalu dia sembahyang.", "textTajweed": "وَذَكَرَ [h:14448[ٱ]سْمَ رَبِّه[n[ِۦ] فَصَلَّىٰ"}, {"id": 5964, "surahId": 87, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "translationId": "Tetapi kamu (orang-orang kafir) memilih kehidupan duniawi.", "textTajweed": "بَلْ تُؤْثِرُونَ [h:14449[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا"}, {"id": 5965, "surahId": 87, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "translationId": "Sedang kehidupan akhirat adalah lebih baik dan lebih kekal.", "textTajweed": "وَ[h:9999[ٱ]لْأَخِرَةُ خَيْ[a:8546[رٌ و]َأَ[q:8540[بْ]قَىٰٓ"}, {"id": 5966, "surahId": 87, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 529, "isAinEnd": false, "textUthmani": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "translationId": "Sesungguhnya ini benar-benar terdapat dalam kitab-kitab yang dahulu,", "textTajweed": "إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَفِى [h:14450[ٱ][l[ل]صُّحُفِ [h:8657[ٱ]لْأُولَىٰ"}, {"id": 5967, "surahId": 87, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 529, "isAinEnd": true, "textUthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "translationId": "(yaitu) Kitab-kitab Ibrahim dan Musa", "textTajweed": "صُحُفِ إِ[q:1860[بْ]ر[n[َٲ]هِيمَ وَمُوسَىٰ"}]}