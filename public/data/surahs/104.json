{"surah": {"id": 104, "nameArabic": "سُورَةُ الهُمَزَةِ", "nameLatin": "Al-Humaza", "translationId": "Pengumpat", "revelationPlace": "Makkiyah", "totalAyahs": 9}, "ayahs": [{"id": 6180, "surahId": 104, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "translationId": "Kecelakaanlah bagi setiap pengumpat lagi pencela,", "textTajweed": "وَيْ[u:12392[لٌ ل]ِّكُلِّ هُمَزَ[u:14633[ةٍ ل]ُّمَزَةٍ"}, {"id": 6181, "surahId": 104, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "translationId": "yang mengumpulkan harta dan menghitung-hitung,", "textTajweed": "ٱلَّذِى جَمَعَ مَال[a:14634[اً و]َعَدَّدَهُۥ"}, {"id": 6182, "surahId": 104, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "translationId": "dia mengira bahwa hartanya itu dapat mengkekalkannya,", "textTajweed": "يَحْسَبُ أَ[g[نّ]َ مَالَهُ[o[ۥٓ] أَخْلَدَهُۥ"}, {"id": 6183, "surahId": 104, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "translationId": "sekali-kali tidak! Sesungguhnya dia benar-benar akan dilemparkan ke dalam Huthamah.", "textTajweed": "كَلَّا‌ۖ لَيُ[i:14635[نۢب]َذَ[g[نّ]َ فِى [h:14636[ٱ]لْحُطَمَةِ"}, {"id": 6184, "surahId": 104, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "translationId": "Dan tahukah kamu apa Huthamah itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14637[ٱ]لْحُطَمَةُ"}, {"id": 6185, "surahId": 104, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "translationId": "(yaitu) api (yang disediakan) Allah yang dinyalakan,", "textTajweed": "نَارُ [h:14638[ٱ]للَّهِ [h:14639[ٱ]لْمُوقَدَةُ"}, {"id": 6186, "surahId": 104, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "translationId": "yang (membakar) sampai ke hati.", "textTajweed": "ٱلَّتِى تَطَّلِعُ عَلَى [h:14640[ٱ]لْأَفْــِٔدَةِ"}, {"id": 6187, "surahId": 104, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 546, "isAinEnd": false, "textUthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "translationId": "Sesungguhnya api itu ditutup rapat atas mereka,", "textTajweed": "إِ[g[نّ]َهَا عَلَيْه[w:14641[ِم م]ُّؤْصَدَةٌ"}, {"id": 6188, "surahId": 104, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 546, "isAinEnd": true, "textUthmani": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "translationId": "(sedang mereka itu) diikat pada tiang-tiang yang panjang.", "textTajweed": "فِى عَمَ[a:14642[دٍ م]ُّمَدَّدَةِۭ"}]}