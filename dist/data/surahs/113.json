{"surah": {"id": 113, "nameArabic": "سُورَةُ الفَلَقِ", "nameLatin": "Al-Falaq", "translationId": "Waktu Subuh", "revelationPlace": "Makkiyah", "totalAyahs": 5}, "ayahs": [{"id": 6226, "surahId": 113, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 555, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "translationId": "Katakanlah: \"Aku berlindung kepada Tuhan Yang Menguasai subuh,", "textTajweed": "قُلْ أَعُوذُ بِرَبِّ [h:14678[ٱ]لْفَلَ[q[ق]ِ"}, {"id": 6227, "surahId": 113, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 555, "isAinEnd": false, "textUthmani": "مِن شَرِّ مَا خَلَقَ", "translationId": "dari kejahatan makhluk-Nya,", "textTajweed": "مِ[f:14679[ن ش]َرِّ مَا خَلَ[q[ق]َ"}, {"id": 6228, "surahId": 113, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 555, "isAinEnd": false, "textUthmani": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "translationId": "dan dari kejahatan malam apabila telah gelap gulita,", "textTajweed": "وَمِ[f:14680[ن ش]َرِّ غَاسِقٍ إِذَا وَقَ[q[ب]َ"}, {"id": 6229, "surahId": 113, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 555, "isAinEnd": false, "textUthmani": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "translationId": "dan dari kejahatan wanita-wanita tukang sihir yang menghembus pada buhul-buhul,", "textTajweed": "وَمِ[f:14680[ن ش]َرِّ [h:14681[ٱ][l[ل][g[نّ]َفَّ[n[ـٰ]ثَ[n[ـٰ]تِ فِى [h:14682[ٱ]لْعُقَ[q[د]ِ"}, {"id": 6230, "surahId": 113, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 555, "isAinEnd": true, "textUthmani": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "translationId": "dan dari kejahatan pendengki bila ia dengki\".", "textTajweed": "وَمِ[f:14680[ن ش]َرِّ حَاسِدٍ إِذَا حَسَ[q[د]َ"}]}