{"surah": {"id": 80, "nameArabic": "سُورَةُ عَبَسَ", "nameLatin": "Abasa", "translationId": "Ia Bermuka Masam", "revelationPlace": "Makkiyah", "totalAyahs": 42}, "ayahs": [{"id": 5759, "surahId": 80, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "translationId": "Dia (Muhammad) bermuka masam dan berpaling,", "textTajweed": "عَبَسَ وَتَوَلَّىٰٓ"}, {"id": 5760, "surahId": 80, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "translationId": "karena telah datang seorang buta kepadanya.", "textTajweed": "أَ[f:14298[ن ج][o[َا]ٓءَهُ [h:14299[ٱ]لْأَعْمَىٰ"}, {"id": 5761, "surahId": 80, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "translationId": "Tahukah kamu barangkali ia ingin membersihkan dirinya (dari dosa),", "textTajweed": "وَمَا يُ[q:10898[دْ]رِيكَ لَعَلَّهُ[n[ۥ] يَزَّكَّىٰٓ"}, {"id": 5762, "surahId": 80, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "translationId": "atau dia (ingin) mendapatkan pengajaran, lalu pengajaran itu memberi manfaat kepadanya?", "textTajweed": "أَوْ يَذَّكَّرُ فَتَ[f:14300[نف]َعَهُ [h:14301[ٱ][l[ل]ذِّكْرَىٰٓ"}, {"id": 5763, "surahId": 80, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "translationId": "Adapun orang yang merasa dirinya serba cukup,", "textTajweed": "أَ[g[مّ]َا مَنِ [h:14302[ٱ]سْتَغْنَىٰ"}, {"id": 5764, "surahId": 80, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "translationId": "maka kamu melayaninya.", "textTajweed": "فَأَ[f:14303[نت]َ لَهُ[n[ۥ] تَصَدَّىٰ"}, {"id": 5765, "surahId": 80, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "translationId": "Padahal tidak ada (celaan) atasmu kalau dia tidak membersihkan diri (beriman).", "textTajweed": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"}, {"id": 5766, "surahId": 80, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "translationId": "Dan adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),", "textTajweed": "وَأَ[g[مّ]َا مَ[f:14304[ن ج][o[َا]ٓءَكَ يَسْعَىٰ"}, {"id": 5767, "surahId": 80, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَهُوَ يَخْشَىٰ", "translationId": "sedang ia takut kepada (Allah),", "textTajweed": "وَهُوَ يَخْشَىٰ"}, {"id": 5768, "surahId": 80, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "translationId": "maka kamu mengabaikannya.", "textTajweed": "فَأَ[f:14303[نت]َ عَنْهُ تَلَهَّىٰ"}, {"id": 5769, "surahId": 80, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "translationId": "Sekali-kali jangan (demikian)! Sesungguhnya ajaran-ajaran Tuhan itu adalah suatu peringatan,", "textTajweed": "كَلّ[o[َآ] إِ[g[نّ]َهَا تَذْكِرَةٌ"}, {"id": 5770, "surahId": 80, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَمَن شَآءَ ذَكَرَهُۥ", "translationId": "maka barangsiapa yang menghendaki, tentulah ia memperhatikannya,", "textTajweed": "فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ"}, {"id": 5771, "surahId": 80, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "translationId": "di dalam kitab-kitab yang dimuliakan,", "textTajweed": "فِى صُحُ[a:14305[فٍ م]ُّكَرَّمَةٍ"}, {"id": 5772, "surahId": 80, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "translationId": "yang ditinggikan lagi disucikan,", "textTajweed": "مَّرْفُوعَ[a:14306[ةٍ م]ُّطَهَّرَةِۭ"}, {"id": 5773, "surahId": 80, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "بِأَيْدِى سَفَرَةٍۢ", "translationId": "di tangan para penulis (malaikat),", "textTajweed": "بِأَيْدِى سَفَرَةٍ"}, {"id": 5774, "surahId": 80, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "كِرَامٍۭ بَرَرَةٍۢ", "translationId": "yang mulia lagi berbakti.", "textTajweed": "كِرَا[i:14307[مِۭ ب]َرَرَةٍ"}, {"id": 5775, "surahId": 80, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "translationId": "Binasalah manusia; alangkah amat sangat kekafirannya?", "textTajweed": "قُتِلَ [h:14308[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ م[o[َآ] أَكْفَرَهُۥ"}, {"id": 5776, "surahId": 80, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "translationId": "Dari apakah Allah menciptakannya?", "textTajweed": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"}, {"id": 5777, "surahId": 80, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "translationId": "Dari setetes mani, Allah menciptakannya lalu menentukannya.", "textTajweed": "م[a:7325[ِن ن]ُّ[q:7326[طْ]فَةٍ خَلَقَهُ[n[ۥ] فَقَدَّرَهُۥ"}, {"id": 5778, "surahId": 80, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "translationId": "Kemudian Dia memudahkan jalannya.", "textTajweed": "ثُ[g[مّ]َ [h:14309[ٱ][l[ل]سَّبِيلَ يَسَّرَهُۥ"}, {"id": 5779, "surahId": 80, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "translationId": "kemudian Dia mematikannya dan memasukkannya ke dalam kubur,", "textTajweed": "ثُ[g[مّ]َ أَمَاتَهُ[n[ۥ] فَأَ[q:14310[قْ]بَرَهُۥ"}, {"id": 5780, "surahId": 80, "ayahNumber": 22, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "translationId": "kemudian bila Dia menghendaki, Dia membangkitkannya kembali.", "textTajweed": "ثُ[g[مّ]َ إِذَا ش[o[َا]ٓءَ أَ[f:14311[نش]َرَهُۥ"}, {"id": 5781, "surahId": 80, "ayahNumber": 23, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "translationId": "Sekali-kali jangan; manusia itu belum melaksanakan apa yang diperintahkan Allah kepadanya,", "textTajweed": "كَلَّا لَ[g[مّ]َا يَ[q:14312[قْ]ضِ م[o[َآ] أَمَرَهُۥ"}, {"id": 5782, "surahId": 80, "ayahNumber": 24, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "translationId": "maka hendaklah manusia itu memperhatikan makanannya.", "textTajweed": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِلَىٰ طَعَامِهِۦٓ"}, {"id": 5783, "surahId": 80, "ayahNumber": 25, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "translationId": "Sesungguhnya Kami benar-benar telah mencurahkan air (dari langit),", "textTajweed": "أَ[g[نّ]َا صَبَ[q:14315[بْ]نَا [h:14316[ٱ]لْم[o[َا]ٓءَ صَبًّا"}, {"id": 5784, "surahId": 80, "ayahNumber": 26, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "translationId": "kemudian Kami belah bumi dengan sebaik-baiknya,", "textTajweed": "ثُ[g[مّ]َ شَقَ[q:14317[قْ]نَا [h:14318[ٱ]لْأَرْضَ شَقًّا"}, {"id": 5785, "surahId": 80, "ayahNumber": 27, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "translationId": "lalu Kami tumbuhkan biji-bijian di bumi itu,", "textTajweed": "فَأَ[i:9998[نۢب]َتْنَا فِيهَا حَبًّا"}, {"id": 5786, "surahId": 80, "ayahNumber": 28, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَعِنَبًۭا وَقَضْبًۭا", "translationId": "anggur dan sayur-sayuran,", "textTajweed": "وَعِنَ[a:14319[بًا و]َقَضْبًا"}, {"id": 5787, "surahId": 80, "ayahNumber": 29, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَزَيْتُونًۭا وَنَخْلًۭا", "translationId": "zaitun dan kurma,", "textTajweed": "وَزَيْتُو[a:14320[نًا و]َنَخْلاً"}, {"id": 5788, "surahId": 80, "ayahNumber": 30, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَحَدَآئِقَ غُلْبًۭا", "translationId": "kebun-kebun (yang) lebat,", "textTajweed": "وَحَد[o[َا]ٓئِقَ غُلْبًا"}, {"id": 5789, "surahId": 80, "ayahNumber": 31, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَفَٰكِهَةًۭ وَأَبًّۭا", "translationId": "dan buah-buahan serta rumput-rumputan,", "textTajweed": "وَفَ[n[ـٰ]كِهَ[a:14321[ةً و]َأَبًّا"}, {"id": 5790, "surahId": 80, "ayahNumber": 32, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "translationId": "untuk kesenanganmu dan untuk binatang-binatang ternakmu.", "textTajweed": "مَّتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ"}, {"id": 5791, "surahId": 80, "ayahNumber": 33, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "translationId": "Dan apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),", "textTajweed": "فَإِذَا ج[o[َا]ٓءَتِ [h:14322[ٱ][l[ل]صّ[m[َا]ٓخَّةُ"}, {"id": 5792, "surahId": 80, "ayahNumber": 34, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "translationId": "pada hari ketika manusia lari dari saudaranya,", "textTajweed": "يَوْمَ يَفِرُّ [h:14323[ٱ]لْمَرْءُ مِنْ أَخ[p[ِي]هِ"}, {"id": 5793, "surahId": 80, "ayahNumber": 35, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَأُمِّهِۦ وَأَبِيهِ", "translationId": "dari ibu dan bapaknya,", "textTajweed": "وَأُ[g[مّ]ِه[n[ِۦ] وَأَب[p[ِي]هِ"}, {"id": 5794, "surahId": 80, "ayahNumber": 36, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "translationId": "dari istri dan anak-anaknya.", "textTajweed": "وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَبَن[p[ِي]هِ"}, {"id": 5795, "surahId": 80, "ayahNumber": 37, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "translationId": "Setiap orang dari mereka pada hari itu mempunyai urusan yang cukup menyibukkannya.", "textTajweed": "لِكُلِّ [h:9345[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ يَوْمَئِ[f:14324[ذٍ ش]َأْ[a:14325[نٌ ي]ُغْن[p[ِي]هِ"}, {"id": 5796, "surahId": 80, "ayahNumber": 38, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "translationId": "Banyak muka pada hari itu berseri-seri,", "textTajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14326[ذٍ م]ُّسْفِرَةٌ"}, {"id": 5797, "surahId": 80, "ayahNumber": 39, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "translationId": "tertawa dan bergembira ria,", "textTajweed": "ضَاحِكَ[a:14327[ةٌ م]ُّسْتَ[q:14328[بْ]شِرَةٌ"}, {"id": 5798, "surahId": 80, "ayahNumber": 40, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "translationId": "dan banyak (pula) muka pada hari itu tertutup debu,", "textTajweed": "وَوُجُو[a:14137[هٌ ي]َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"}, {"id": 5799, "surahId": 80, "ayahNumber": 41, "juzNumber": 30, "ainNumber": 522, "isAinEnd": false, "textUthmani": "تَرْهَقُهَا قَتَرَةٌ", "translationId": "dan ditutup lagi oleh kegelapan.", "textTajweed": "تَرْهَقُهَا قَتَرَةٌ"}, {"id": 5800, "surahId": 80, "ayahNumber": 42, "juzNumber": 30, "ainNumber": 522, "isAinEnd": true, "textUthmani": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "translationId": "Mereka itulah orang-orang kafir lagi durhaka.", "textTajweed": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ هُمُ [h:14329[ٱ]لْكَفَرَةُ [h:14330[ٱ]لْفَجَرَةُ"}]}