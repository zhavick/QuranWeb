{"surah": {"id": 94, "nameArabic": "سُورَةُ الشَّرۡحِ", "nameLatin": "Ash-Sharh", "translationId": "Melapangkan", "revelationPlace": "Makkiyah", "totalAyahs": 8}, "ayahs": [{"id": 6091, "surahId": 94, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "translationId": "Bukankah Kami telah melapangkan untukmu dadamu?,", "textTajweed": "أَلَمْ نَشْرَحْ لَكَ صَ[q:14548[دْ]رَكَ"}, {"id": 6092, "surahId": 94, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "translationId": "dan Kami telah menghilangkan daripadamu bebanmu,", "textTajweed": "وَوَضَعْنَا عَ[f:626[نك]َ وِزْرَكَ"}, {"id": 6093, "surahId": 94, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "translationId": "yang memberatkan punggungmu?", "textTajweed": "ٱلَّذ[o[ِىٓ] أَ[f:14549[نق]َضَ ظَهْرَكَ"}, {"id": 6094, "surahId": 94, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "translationId": "Dan Kami tinggikan bagimu sebutan (nama)mu,", "textTajweed": "وَرَفَعْنَا لَكَ ذِكْرَكَ"}, {"id": 6095, "surahId": 94, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "translationId": "Karena sesungguhnya sesudah kesulitan itu ada kemudahan,", "textTajweed": "فَإِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"}, {"id": 6096, "surahId": 94, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "translationId": "sesungguhnya sesudah kesulitan itu ada kemudahan.", "textTajweed": "إِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"}, {"id": 6097, "surahId": 94, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 536, "isAinEnd": false, "textUthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "translationId": "Maka apabila kamu telah selesai (dari sesuatu urusan), kerjakanlah dengan sungguh-sungguh (urusan) yang lain,", "textTajweed": "فَإِذَا فَرَغْتَ فَ[h:14551[ٱ][f:14551[نص]َ[q:14551[بْ]"}, {"id": 6098, "surahId": 94, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 536, "isAinEnd": true, "textUthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "translationId": "dan hanya kepada Tuhanmulah hendaknya kamu berharap.", "textTajweed": "وَإِلَىٰ رَبِّكَ فَ[h:14552[ٱ]رْغَ[q[ب]"}]}