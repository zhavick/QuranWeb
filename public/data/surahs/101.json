{"surah": {"id": 101, "nameArabic": "سُورَةُ القَارِعَةِ", "nameLatin": "Al-Qaari'a", "translationId": "Hari Kiamat", "revelationPlace": "Makkiyah", "totalAyahs": 11}, "ayahs": [{"id": 6158, "surahId": 101, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "translationId": "Hari Kiamat,", "textTajweed": "ٱلْقَارِعَةُ"}, {"id": 6159, "surahId": 101, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "مَا ٱلْقَارِعَةُ", "translationId": "apakah hari Kiamat itu?", "textTajweed": "مَا [h:14619[ٱ]لْقَارِعَةُ"}, {"id": 6160, "surahId": 101, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "translationId": "Tahukah kamu apakah hari Kiamat itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14619[ٱ]لْقَارِعَةُ"}, {"id": 6161, "surahId": 101, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "translationId": "Pada hari itu manusia adalah seperti anai-anai yang bertebaran,", "textTajweed": "يَوْمَ يَكُونُ [h:14620[ٱ][l[ل][g[نّ]َاسُ كَ[h:14621[ٱ]لْفَرَاشِ [h:14622[ٱ]لْمَ[q:14623[بْ]ث[p[ُو]ثِ"}, {"id": 6162, "surahId": 101, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "translationId": "dan gunung-gunung adalah seperti bulu yang dihambur-hamburkan.", "textTajweed": "وَتَكُونُ [h:13919[ٱ]لْجِبَالُ كَ[h:13920[ٱ]لْعِهْنِ [h:14624[ٱ]لْمَ[f:14625[نف][p[ُو]شِ"}, {"id": 6163, "surahId": 101, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "translationId": "Dan adapun orang-orang yang berat timbangan (kebaikan)nya,", "textTajweed": "فَأَ[g[مّ]َا مَ[f:14626[ن ث]َقُلَتْ مَو[n[َٲ]زِينُهُۥ"}, {"id": 6164, "surahId": 101, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "translationId": "maka dia berada dalam kehidupan yang memuaskan.", "textTajweed": "فَهُوَ فِى عِيشَ[u:13890[ةٍ ر]َّاضِيَةٍ"}, {"id": 6165, "surahId": 101, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "translationId": "Dan adapun orang-orang yang ringan timbangan (kebaikan)nya,", "textTajweed": "وَأَ[g[مّ]َا مَنْ خَفَّتْ مَو[n[َٲ]زِينُهُۥ"}, {"id": 6166, "surahId": 101, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "فَأُمُّهُۥ هَاوِيَةٌۭ", "translationId": "maka tempat kembalinya adalah neraka Hawiyah.", "textTajweed": "فَأُ[g[مّ]ُهُ[n[ۥ] هَاوِيَةٌ"}, {"id": 6167, "surahId": 101, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 543, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "translationId": "Tahukah kamu apakah neraka Hawiyah itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا هِيَهْ"}, {"id": 6168, "surahId": 101, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 543, "isAinEnd": true, "textUthmani": "نَارٌ حَامِيَةٌۢ", "translationId": "(Yaitu) api yang sangat panas.", "textTajweed": "نَارٌ حَامِيَةُۢ"}]}