{"surah": {"id": 74, "nameArabic": "سُورَةُ المُدَّثِّرِ", "nameLatin": "Al-Muddaththir", "translationId": "Orang yang Berkemul", "revelationPlace": "Makkiyah", "totalAyahs": 56}, "ayahs": [{"id": 5496, "surahId": 74, "ayahNumber": 1, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ", "translationId": "Hai orang yang berkemul (berselimut),", "textTajweed": "يَ[o[ـٰٓ]أَيُّهَا [h:14069[ٱ]لْمُدَّثِّرُ"}, {"id": 5497, "surahId": 74, "ayahNumber": 2, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "قُمْ فَأَنذِرْ", "translationId": "bangunlah, lalu berilah peringatan!", "textTajweed": "قُمْ فَأَ[f:14070[نذ]ِرْ"}, {"id": 5498, "surahId": 74, "ayahNumber": 3, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَرَبَّكَ فَكَبِّرْ", "translationId": "dan Tuhanmu agungkanlah!", "textTajweed": "وَرَبَّكَ فَكَبِّرْ"}, {"id": 5499, "surahId": 74, "ayahNumber": 4, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَثِيَابَكَ فَطَهِّرْ", "translationId": "dan pakaianmu bersihkanlah,", "textTajweed": "وَثِيَابَكَ فَطَهِّرْ"}, {"id": 5500, "surahId": 74, "ayahNumber": 5, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَٱلرُّجْزَ فَٱهْجُرْ", "translationId": "dan perbuatan dosa tinggalkanlah,", "textTajweed": "وَ[h:9999[ٱ][l[ل]رُّ[q:14071[جْ]زَ فَ[h:14072[ٱ]هْجُرْ"}, {"id": 5501, "surahId": 74, "ayahNumber": 6, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَلَا تَمْنُن تَسْتَكْثِرُ", "translationId": "dan janganlah kamu memberi (dengan maksud) memperoleh (balasan) yang lebih banyak.", "textTajweed": "وَلَا تَمْنُ[f:14073[ن ت]َسْتَكْثِرُ"}, {"id": 5502, "surahId": 74, "ayahNumber": 7, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَلِرَبِّكَ فَٱصْبِرْ", "translationId": "Dan untuk (memenuhi perintah) Tuhanmu, bersabarlah.", "textTajweed": "وَلِرَبِّكَ فَ[h:6374[ٱ]صْبِرْ"}, {"id": 5503, "surahId": 74, "ayahNumber": 8, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ", "translationId": "Apabila ditiup sangkakala,", "textTajweed": "فَإِذَا نُقِرَ فِى [h:14074[ٱ][l[ل][g[نّ]َاق[p[ُو]رِ"}, {"id": 5504, "surahId": 74, "ayahNumber": 9, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ", "translationId": "maka waktu itu adalah waktu (datangnya) hari yang sulit,", "textTajweed": "فَذ[n[َٲ]لِكَ يَوْمَئِ[a:14075[ذٍ ي]َوْمٌ عَس[p[ِي]رٌ"}, {"id": 5505, "surahId": 74, "ayahNumber": 10, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ", "translationId": "bagi orang-orang kafir lagi tidak mudah.", "textTajweed": "عَلَى [h:468[ٱ]لْكَ[n[ـٰ]فِرِينَ غَيْرُ يَس[p[ِي]رٍ"}, {"id": 5506, "surahId": 74, "ayahNumber": 11, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا", "translationId": "Biarkanlah Aku bertindak terhadap orang yang Aku telah menciptakannya sendirian.", "textTajweed": "ذَرْنِى وَمَنْ خَلَ[q:11606[قْ]تُ وَحِيدًا"}, {"id": 5507, "surahId": 74, "ayahNumber": 12, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا", "translationId": "Dan Aku jadikan baginya harta benda yang banyak,", "textTajweed": "وَجَعَلْتُ لَهُ[n[ۥ] مَال[a:14076[اً م]َّمْدُودًا"}, {"id": 5508, "surahId": 74, "ayahNumber": 13, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَبَنِينَ شُهُودًۭا", "translationId": "dan anak-anak yang selalu bersama dia,", "textTajweed": "وَبَنِينَ شُهُودًا"}, {"id": 5509, "surahId": 74, "ayahNumber": 14, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا", "translationId": "dan Ku-lapangkan baginya (rezeki dan kekuasaan) dengan selapang-lapangnya,", "textTajweed": "وَمَهَّ[d:14077[د]تُّ لَهُ[n[ۥ] تَمْهِيدًا"}, {"id": 5510, "surahId": 74, "ayahNumber": 15, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ", "translationId": "kemudian dia ingin sekali supaya Aku menambahnya.", "textTajweed": "ثُ[g[مّ]َ يَ[q:14078[طْ]مَعُ أَنْ أَز[p[ِي][q[د]َ"}, {"id": 5511, "surahId": 74, "ayahNumber": 16, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا", "translationId": "Sekali-kali tidak (akan Aku tambah), karena sesungguhnya dia menentang ayat-ayat Kami (Al Quran).", "textTajweed": "كَلّ[o[َآ‌ۖ] إِ[g[نّ]َهُ[n[ۥ] كَانَ لِأَيَ[n[ـٰ]تِنَا عَنِيدًا"}, {"id": 5512, "surahId": 74, "ayahNumber": 17, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "سَأُرْهِقُهُۥ صَعُودًا", "translationId": "Aku akan membebaninya mendaki pendakian yang memayahkan.", "textTajweed": "سَأُرْهِقُهُ[n[ۥ] صَعُودًا"}, {"id": 5513, "surahId": 74, "ayahNumber": 18, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ", "translationId": "Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),", "textTajweed": "إِ[g[نّ]َهُ[n[ۥ] فَكَّرَ وَقَدَّرَ"}, {"id": 5514, "surahId": 74, "ayahNumber": 19, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "فَقُتِلَ كَيْفَ قَدَّرَ", "translationId": "maka celakalah dia! Bagaimana dia menetapkan?,", "textTajweed": "فَقُتِلَ كَيْفَ قَدَّرَ"}, {"id": 5515, "surahId": 74, "ayahNumber": 20, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ", "translationId": "kemudian celakalah dia! Bagaimanakah dia menetapkan?,", "textTajweed": "ثُ[g[مّ]َ قُتِلَ كَيْفَ قَدَّرَ"}, {"id": 5516, "surahId": 74, "ayahNumber": 21, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ثُمَّ نَظَرَ", "translationId": "kemudian dia memikirkan,", "textTajweed": "ثُ[g[مّ]َ نَظَرَ"}, {"id": 5517, "surahId": 74, "ayahNumber": 22, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ثُمَّ عَبَسَ وَبَسَرَ", "translationId": "sesudah itu dia bermasam muka dan merengut,", "textTajweed": "ثُ[g[مّ]َ عَبَسَ وَبَسَرَ"}, {"id": 5518, "surahId": 74, "ayahNumber": 23, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ", "translationId": "kemudian dia berpaling (dari kebenaran) dan menyombongkan diri,", "textTajweed": "ثُ[g[مّ]َ أَ[q:13927[دْ]بَرَ وَ[h:181[ٱ]سْتَكْبَرَ"}, {"id": 5519, "surahId": 74, "ayahNumber": 24, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ", "translationId": "lalu dia berkata: \"(Al Quran) ini tidak lain hanyalah sihir yang dipelajari (dari orang-orang dahulu),", "textTajweed": "فَقَالَ إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا سِحْ[a:14079[رٌ ي]ُؤْثَرُ"}, {"id": 5520, "surahId": 74, "ayahNumber": 25, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ", "translationId": "ini tidak lain hanyalah perkataan manusia\".", "textTajweed": "إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا قَوْلُ [h:14080[ٱ]لْبَشَرِ"}, {"id": 5521, "surahId": 74, "ayahNumber": 26, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "سَأُصْلِيهِ سَقَرَ", "translationId": "Aku akan memasukkannya ke dalam (neraka) Saqar.", "textTajweed": "سَأُصْلِيهِ سَقَرَ"}, {"id": 5522, "surahId": 74, "ayahNumber": 27, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ", "translationId": "Tahukah kamu apakah (neraka) Saqar itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا سَقَرُ"}, {"id": 5523, "surahId": 74, "ayahNumber": 28, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "لَا تُبْقِى وَلَا تَذَرُ", "translationId": "Saqar itu tidak meninggalkan dan tidak membiarkan.", "textTajweed": "لَا تُ[q:14081[بْ]قِى وَلَا تَذَرُ"}, {"id": 5524, "surahId": 74, "ayahNumber": 29, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "لَوَّاحَةٌۭ لِّلْبَشَرِ", "translationId": "(Neraka Saqar) adalah pembakar kulit manusia.", "textTajweed": "لَوَّاحَ[u:14082[ةٌ ل]ِّلْبَشَرِ"}, {"id": 5525, "surahId": 74, "ayahNumber": 30, "juzNumber": 29, "ainNumber": 510, "isAinEnd": false, "textUthmani": "عَلَيْهَا تِسْعَةَ عَشَرَ", "translationId": "Dan di atasnya ada sembilan belas (malaikat penjaga).", "textTajweed": "عَلَيْهَا تِسْعَةَ عَشَرَ"}, {"id": 5526, "surahId": 74, "ayahNumber": 31, "juzNumber": 29, "ainNumber": 510, "isAinEnd": true, "textUthmani": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ", "translationId": "Dan tiada Kami jadikan penjaga neraka itu melainkan dari malaikat: dan tidaklah Kami menjadikan bilangan mereka itu melainkan untuk jadi cobaan bagi orang-orang kafir, supaya orang-orang yang diberi Al-Kitab menjadi yakin dan supaya orang yang beriman bertambah imannya dan supaya orang-orang yang diberi Al Kitab dan orng-orang mukmin itu tidak ragu-ragu dan supaya orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (mengatakan): \"Apakah yang dikehendaki Allah dengan bilangan ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang dikehendaki-Nya dan memberi petunjuk kepada siapa yang dikehendaki-Nya. Dan tidak ada yang mengetahui tentara Tuhanmu melainkan Dia sendiri. Dan Saqar itu tiada lain hanyalah peringatan bagi manusia.", "textTajweed": "وَمَا جَعَلْن[o[َآ] أَصْحَ[n[ـٰ]بَ [h:4701[ٱ][l[ل][g[نّ]َارِ إِلَّا مَلَ[o[ـٰٓ]ئِكَ[a:14083[ةً‌ۙ و]َمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَ[u:9071[ةً ل]ِّلَّذِينَ كَفَرُو[s[اْ] لِيَسْتَيْقِنَ [h:14084[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَيَزْدَادَ [h:14085[ٱ]لَّذِينَ ءَامَن[o[ُوٓ][s[اْ] إِيمَ[n[ـٰ][a:14086[نًا‌ۙ و]َلَا يَرْتَابَ [h:14087[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَ[h:1709[ٱ]لْمُؤْمِنُونَ‌ۙ وَلِيَقُولَ [h:14088[ٱ]لَّذِينَ فِى قُلُوبِه[w:39[ِم م]َّرَ[a:14089[ضٌ و]َ[h:1467[ٱ]لْكَ[n[ـٰ]فِرُونَ مَاذ[o[َآ] أَرَادَ [h:139[ٱ]للَّهُ بِهَ[n[ـٰ]ذَا مَثَل[f:14090[اً‌ۚ ك]َذ[n[َٲ]لِكَ يُضِلُّ [h:11866[ٱ]للَّهُ م[a:476[َن ي]َش[o[َا]ٓءُ وَيَهْدِى م[a:476[َن ي]َش[o[َا]ٓءُ‌ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ‌ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ"}, {"id": 5527, "surahId": 74, "ayahNumber": 32, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "كَلَّا وَٱلْقَمَرِ", "translationId": "Sekali-kali tidak, demi bulan,", "textTajweed": "كَلَّا وَ[h:14091[ٱ]لْقَمَرِ"}, {"id": 5528, "surahId": 74, "ayahNumber": 33, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "وَٱلَّيْلِ إِذْ أَدْبَرَ", "translationId": "dan malam ketika telah berlalu,", "textTajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذْ أَ[q:13927[دْ]بَرَ"}, {"id": 5529, "surahId": 74, "ayahNumber": 34, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ", "translationId": "dan subuh apabila mulai terang.", "textTajweed": "وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذ[o[َآ] أَسْفَرَ"}, {"id": 5530, "surahId": 74, "ayahNumber": 35, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ", "translationId": "Sesungguhnya Saqar itu adalah salah satu bencana yang amat besar,", "textTajweed": "إِ[g[نّ]َهَا لَإِحْدَى [h:14093[ٱ]لْكُبَرِ"}, {"id": 5531, "surahId": 74, "ayahNumber": 36, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "نَذِيرًۭا لِّلْبَشَرِ", "translationId": "sebagai ancaman bagi manusia.", "textTajweed": "نَذِي[u:14094[رًا ل]ِّلْبَشَرِ"}, {"id": 5532, "surahId": 74, "ayahNumber": 37, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ", "translationId": "(Yaitu) bagi siapa di antaramu yang berkehendak akan maju atau mundur.", "textTajweed": "لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14096[َن ي]َتَقَدَّمَ أَوْ يَتَأَخَّرَ"}, {"id": 5533, "surahId": 74, "ayahNumber": 38, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ", "translationId": "Tiap-tiap diri bertanggung jawab atas apa yang telah diperbuatnya,", "textTajweed": "كُلُّ نَفْ[i:6995[سِۭ ب]ِمَا كَسَبَتْ رَهِينَةٌ"}, {"id": 5534, "surahId": 74, "ayahNumber": 39, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ", "translationId": "kecuali golongan kanan,", "textTajweed": "إِلّ[o[َآ] أَصْحَ[n[ـٰ]بَ [h:14097[ٱ]لْيَم[p[ِي]نِ"}, {"id": 5535, "surahId": 74, "ayahNumber": 40, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ", "translationId": "berada di dalam surga, mereka tanya menanya,", "textTajweed": "فِى جَ[g[نّ]َ[n[ـٰ][a:14098[تٍ ي]َتَس[o[َا]ٓءَل[p[ُو]نَ"}, {"id": 5536, "surahId": 74, "ayahNumber": 41, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "عَنِ ٱلْمُجْرِمِينَ", "translationId": "tentang (keadaan) orang-orang yang berdosa,", "textTajweed": "عَنِ [h:14099[ٱ]لْمُ[q:4093[جْ]رِم[p[ِي]نَ"}, {"id": 5537, "surahId": 74, "ayahNumber": 42, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "مَا سَلَكَكُمْ فِى سَقَرَ", "translationId": "\"Apakah yang memasukkan kamu ke dalam Saqar (neraka)?\"", "textTajweed": "مَا سَلَكَكُمْ فِى سَقَرَ"}, {"id": 5538, "surahId": 74, "ayahNumber": 43, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ", "translationId": "Mereka menjawab: \"Kami dahulu tidak termasuk orang-orang yang mengerjakan shalat,", "textTajweed": "قَالُو[s[اْ] لَمْ نَكُ مِنَ [h:14100[ٱ]لْمُصَلّ[p[ِي]نَ"}, {"id": 5539, "surahId": 74, "ayahNumber": 44, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ", "translationId": "dan kami tidak (pula) memberi makan orang miskin,", "textTajweed": "وَلَمْ نَكُ نُ[q:14101[طْ]عِمُ [h:14102[ٱ]لْمِسْك[p[ِي]نَ"}, {"id": 5540, "surahId": 74, "ayahNumber": 45, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ", "translationId": "dan adalah kami membicarakan yang bathil, bersama dengan orang-orang yang membicarakannya,", "textTajweed": "وَكُ[g[نّ]َا نَخُوضُ مَعَ [h:14103[ٱ]لْخ[o[َا]ٓئِض[p[ِي]نَ"}, {"id": 5541, "surahId": 74, "ayahNumber": 46, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ", "translationId": "dan adalah kami mendustakan hari pembalasan,", "textTajweed": "وَكُ[g[نّ]َا نُكَذِّبُ بِيَوْمِ [h:13931[ٱ][l[ل]دّ[p[ِي]نِ"}, {"id": 5542, "surahId": 74, "ayahNumber": 47, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ", "translationId": "hingga datang kepada kami kematian\".", "textTajweed": "حَتَّ[o[ىٰٓ] أَتَ[n[ـٰ]نَا [h:14104[ٱ]لْيَق[p[ِي]نُ"}, {"id": 5543, "surahId": 74, "ayahNumber": 48, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ", "translationId": "Maka tidak berguna lagi bagi mereka syafa'at dari orang-orang yang memberikan syafa'at.", "textTajweed": "فَمَا تَ[f:14105[نف]َعُهُمْ شَفَ[n[ـٰ]عَةُ [h:14106[ٱ][l[ل]شَّ[n[ـٰ]فِع[p[ِي]نَ"}, {"id": 5544, "surahId": 74, "ayahNumber": 49, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ", "translationId": "Maka mengapa mereka (orang-orang kafir) berpaling dari peringatan (Allah)?,", "textTajweed": "فَمَا لَهُمْ عَنِ [h:14107[ٱ][l[ل]تَّذْكِرَةِ مُعْرِض[p[ِي]نَ"}, {"id": 5545, "surahId": 74, "ayahNumber": 50, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ", "translationId": "seakan-akan mereka itu keledai liar yang lari terkejut,", "textTajweed": "كَأَ[g[نّ]َهُمْ حُمُ[a:14108[رٌ م]ُّسْتَ[f:14109[نف]ِرَةٌ"}, {"id": 5546, "surahId": 74, "ayahNumber": 51, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "فَرَّتْ مِن قَسْوَرَةٍۭ", "translationId": "lari daripada singa.", "textTajweed": "فَرَّتْ مِ[f:14110[ن ق]َسْوَرَةِۭ"}, {"id": 5547, "surahId": 74, "ayahNumber": 52, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ", "translationId": "Bahkan tiap-tiap orang dari mereka berkehendak supaya diberikan kepadanya lembaran-lembaran yang terbuka.", "textTajweed": "بَلْ يُرِيدُ كُلُّ [h:12916[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ أ[a:2024[َن ي]ُؤْتَىٰ صُحُ[a:14111[فًا م]ُّنَشَّرَةً"}, {"id": 5548, "surahId": 74, "ayahNumber": 53, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ", "translationId": "Sekali-kali tidak. Sebenarnya mereka tidak takut kepada negeri akhirat.", "textTajweed": "كَلَّا‌ۖ بَل لَّا يَخَافُونَ [h:14112[ٱ]لْأَخِرَةَ"}, {"id": 5549, "surahId": 74, "ayahNumber": 54, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ", "translationId": "Sekali-kali tidak demikian halnya. Sesungguhnya Al Quran itu adalah peringatan.", "textTajweed": "كَلّ[o[َآ] إِ[g[نّ]َهُ[n[ۥ] تَذْكِرَةٌ"}, {"id": 5550, "surahId": 74, "ayahNumber": 55, "juzNumber": 29, "ainNumber": 511, "isAinEnd": false, "textUthmani": "فَمَن شَآءَ ذَكَرَهُۥ", "translationId": "Maka barangsiapa menghendaki, niscaya dia mengambil pelajaran daripadanya (Al Quran).", "textTajweed": "فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ"}, {"id": 5551, "surahId": 74, "ayahNumber": 56, "juzNumber": 29, "ainNumber": 511, "isAinEnd": true, "textUthmani": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ", "translationId": "Dan mereka tidak akan mengambil pelajaran daripadanya kecuali (jika) Allah menghendakinya. Dia (Allah) adalah Tuhan Yang patut (kita) bertakwa kepada-Nya dan berhak memberi ampun.", "textTajweed": "وَمَا يَذْكُرُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ‌ۚ هُوَ أَهْلُ [h:14113[ٱ][l[ل]تَّ[q:1084[قْ]وَىٰ وَأَهْلُ [h:14114[ٱ]لْمَغْفِرَةِ"}]}