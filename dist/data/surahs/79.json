{"surah": {"id": 79, "nameArabic": "سُورَةُ النَّازِعَاتِ", "nameLatin": "An-Naazi'aat", "translationId": "Malaikat-Malaikat yang Mencabut", "revelationPlace": "Makkiyah", "totalAyahs": 46}, "ayahs": [{"id": 5713, "surahId": 79, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا", "translationId": "Demi (malaikat-malaikat) yang mencabut (nyawa) dengan keras,", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]زِعَ[n[ـٰ]تِ غَرْقًا"}, {"id": 5714, "surahId": 79, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا", "translationId": "dan (malaikat-malaikat) yang mencabut (nyawa) dengan lemah-lembut,", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِطَ[n[ـٰ]تِ نَشْطًا"}, {"id": 5715, "surahId": 79, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا", "translationId": "dan (malaikat-malaikat) yang turun dari langit dengan cepat,", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِحَ[n[ـٰ]تِ سَ[q:14030[بْ]حًا"}, {"id": 5716, "surahId": 79, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا", "translationId": "dan (malaikat-malaikat) yang mendahului dengan kencang,", "textTajweed": "فَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِقَ[n[ـٰ]تِ سَ[q:14265[بْ]قًا"}, {"id": 5717, "surahId": 79, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا", "translationId": "dan (malaikat-malaikat) yang mengatur urusan (dunia).", "textTajweed": "فَ[h:9999[ٱ]لْمُدَبِّر[n[َٲ]تِ أَمْرًا"}, {"id": 5718, "surahId": 79, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ", "translationId": "(Sesungguhnya kamu akan dibangkitkan) pada hari ketika tiupan pertama menggoncang alam,", "textTajweed": "يَوْمَ تَرْجُفُ [h:14266[ٱ][l[ل]رَّاجِفَةُ"}, {"id": 5719, "surahId": 79, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "تَتْبَعُهَا ٱلرَّادِفَةُ", "translationId": "tiupan pertama itu diiringi oleh tiupan kedua.", "textTajweed": "تَتْبَعُهَا [h:14267[ٱ][l[ل]رَّادِفَةُ"}, {"id": 5720, "surahId": 79, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ", "translationId": "Hati manusia pada waktu itu sangat takut,", "textTajweed": "قُلُو[a:14268[بٌ ي]َوْمَئِ[a:14269[ذٍ و]َاجِفَةٌ"}, {"id": 5721, "surahId": 79, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "أَبْصَٰرُهَا خَٰشِعَةٌۭ", "translationId": "Pandangannya tunduk.", "textTajweed": "أَ[q:14270[بْ]صَ[n[ـٰ]رُهَا خَ[n[ـٰ]شِعَةٌ"}, {"id": 5722, "surahId": 79, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ", "translationId": "(Orang-orang kafir) berkata: \"Apakah sesungguhnya kami benar-benar dikembalikan kepada kehidupan semula?", "textTajweed": "يَقُولُونَ أَءِ[g[نّ]َا لَمَرْدُودُونَ فِى [h:14271[ٱ]لْحَافِرَةِ"}, {"id": 5723, "surahId": 79, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ", "translationId": "Apakah (akan dibangkitkan juga) apabila kami telah menjadi tulang belulang yang hancur lumat?\"", "textTajweed": "أَءِذَا كُ[g[نّ]َا عِظَ[n[ـٰ][a:14272[مًا ن]َّخِرَةً"}, {"id": 5724, "surahId": 79, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ", "translationId": "Mereka berkata: \"Kalau demikian, itu adalah suatu pengembalian yang merugikan\".", "textTajweed": "قَالُو[s[اْ] تِلْكَ إِ[f:14273[ذًا ك]َرَّةٌ خَاسِرَةٌ"}, {"id": 5725, "surahId": 79, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ", "translationId": "Sesungguhnya pengembalian itu hanyalah satu kali tiupan saja,", "textTajweed": "فَإِ[g[نّ]َمَا هِىَ زَ[q:11332[جْ]رَ[a:11333[ةٌ و][n[َٲ]حِدَةٌ"}, {"id": 5726, "surahId": 79, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ", "translationId": "maka dengan serta merta mereka hidup kembali di permukaan bumi.", "textTajweed": "فَإِذَا ه[c:14274[ُم ب]ِ[h:14275[ٱ][l[ل]سَّاهِرَةِ"}, {"id": 5727, "surahId": 79, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ", "translationId": "Sudah sampaikah kepadamu (ya Muhammad) kisah Musa.", "textTajweed": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ مُوسَىٰٓ"}, {"id": 5728, "surahId": 79, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى", "translationId": "Tatkala Tuhannya memanggilnya di lembah suci ialah Lembah Thuwa;", "textTajweed": "إِذْ نَادَ[n[ٮٰ]هُ رَبُّهُ[n[ۥ] بِ[h:8451[ٱ]لْوَادِ [h:8452[ٱ]لْمُقَدَّسِ طُوًى"}, {"id": 5729, "surahId": 79, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ", "translationId": "\"Pergilah kamu kepada Fir'aun, sesungguhnya dia telah melampaui batas,", "textTajweed": "ٱذْهَ[q:7814[بْ] إِلَىٰ فِرْعَوْنَ إِ[g[نّ]َهُ[n[ۥ] طَغَىٰ"}, {"id": 5730, "surahId": 79, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ", "translationId": "dan katakanlah (kepada Fir'aun): \"Adakah keinginan bagimu untuk membersihkan diri (dari kesesatan)\".", "textTajweed": "فَقُلْ هَل لَّكَ إِلَ[o[ىٰٓ] أَ[f:14276[ن ت]َزَكَّىٰ"}, {"id": 5731, "surahId": 79, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ", "translationId": "Dan kamu akan kupimpin ke jalan Tuhanmu agar supaya kamu takut kepada-Nya?\"", "textTajweed": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"}, {"id": 5732, "surahId": 79, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ", "translationId": "Lalu Musa memperlihatkan kepadanya mukjizat yang besar.", "textTajweed": "فَأَرَ[n[ٮٰ]هُ [h:14277[ٱ]لْأَيَةَ [h:14278[ٱ]لْكُ[q:8463[بْ]رَىٰ"}, {"id": 5733, "surahId": 79, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَكَذَّبَ وَعَصَىٰ", "translationId": "Tetapi Fir'aun mendustakan dan mendurhakai.", "textTajweed": "فَكَذَّبَ وَعَصَىٰ"}, {"id": 5734, "surahId": 79, "ayahNumber": 22, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "ثُمَّ أَدْبَرَ يَسْعَىٰ", "translationId": "Kemudian dia berpaling seraya berusaha menantang (Musa).", "textTajweed": "ثُ[g[مّ]َ أَ[q:13927[دْ]بَرَ يَسْعَىٰ"}, {"id": 5735, "surahId": 79, "ayahNumber": 23, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَحَشَرَ فَنَادَىٰ", "translationId": "Maka dia mengumpulkan (pembesar-pembesarnya) lalu berseru memanggil kaumnya.", "textTajweed": "فَحَشَرَ فَنَادَىٰ"}, {"id": 5736, "surahId": 79, "ayahNumber": 24, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ", "translationId": "(Seraya) berkata: \"Akulah tuhanmu yang paling tinggi\".", "textTajweed": "فَقَالَ أَنَا۟ رَبُّكُمُ [h:14279[ٱ]لْأَعْلَىٰ"}, {"id": 5737, "surahId": 79, "ayahNumber": 25, "juzNumber": 30, "ainNumber": 520, "isAinEnd": false, "textUthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ", "translationId": "Maka Allah mengazabnya dengan azab di akhirat dan azab di dunia.", "textTajweed": "فَأَخَذَهُ [h:14280[ٱ]للَّهُ نَكَالَ [h:14281[ٱ]لْأَخِرَةِ وَ[h:12987[ٱ]لْأُولَىٰٓ"}, {"id": 5738, "surahId": 79, "ayahNumber": 26, "juzNumber": 30, "ainNumber": 520, "isAinEnd": true, "textUthmani": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ", "translationId": "Sesungguhnya pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Tuhannya).", "textTajweed": "إِ[g[نّ]َ فِى ذ[n[َٲ]لِكَ لَعِ[q:1764[بْ]رَ[u:14282[ةً ل]ِّم[a:8436[َن ي]َخْشَىٰٓ"}, {"id": 5739, "surahId": 79, "ayahNumber": 27, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا", "translationId": "Apakah kamu lebih sulit penciptaanya ataukah langit? Allah telah membinanya,", "textTajweed": "ءَأَ[f:716[نت]ُمْ أَشَدُّ خَلْقًا أَمِ [h:14283[ٱ][l[ل]سَّم[o[َا]ٓءُ‌ۚ بَنَ[n[ـٰ]هَا"}, {"id": 5740, "surahId": 79, "ayahNumber": 28, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا", "translationId": "Dia meninggikan bangunannya lalu menyempurnakannya,", "textTajweed": "رَفَعَ سَمْكَهَا فَسَوَّ[n[ٮٰ]هَا"}, {"id": 5741, "surahId": 79, "ayahNumber": 29, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا", "translationId": "dan Dia menjadikan malamnya gelap gulita, dan menjadikan siangnya terang benderang.", "textTajweed": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَ[n[ـٰ]هَا"}, {"id": 5742, "surahId": 79, "ayahNumber": 30, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ", "translationId": "Dan bumi sesudah itu dihamparkan-Nya.", "textTajweed": "وَ[h:9999[ٱ]لْأَرْضَ بَعْدَ ذ[n[َٲ]لِكَ دَحَ[n[ـٰ]هَآ"}, {"id": 5743, "surahId": 79, "ayahNumber": 31, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا", "translationId": "Ia memancarkan daripadanya mata airnya, dan (menumbuhkan) tumbuh-tumbuhannya.", "textTajweed": "أَخْرَجَ مِنْهَا م[o[َا]ٓءَهَا وَمَرْعَ[n[ـٰ]هَا"}, {"id": 5744, "surahId": 79, "ayahNumber": 32, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَٱلْجِبَالَ أَرْسَىٰهَا", "translationId": "Dan gunung-gunung dipancangkan-Nya dengan teguh,", "textTajweed": "وَ[h:9999[ٱ]لْجِبَالَ أَرْسَ[n[ـٰ]هَا"}, {"id": 5745, "surahId": 79, "ayahNumber": 33, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "translationId": "(semua itu) untuk kesenanganmu dan untuk binatang-binatang ternakmu.", "textTajweed": "مَتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ"}, {"id": 5746, "surahId": 79, "ayahNumber": 34, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ", "translationId": "Maka apabila malapetaka yang sangat besar (hari kiamat) telah datang.", "textTajweed": "فَإِذَا ج[o[َا]ٓءَتِ [h:14284[ٱ][l[ل]طّ[m[َا]ٓ[g[مّ]َةُ [h:14285[ٱ]لْكُ[q:8463[بْ]رَىٰ"}, {"id": 5747, "surahId": 79, "ayahNumber": 35, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ", "translationId": "Pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,", "textTajweed": "يَوْمَ يَتَذَكَّرُ [h:14286[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا سَعَىٰ"}, {"id": 5748, "surahId": 79, "ayahNumber": 36, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ", "translationId": "dan diperlihatkan neraka dengan jelas kepada setiap orang yang melihat.", "textTajweed": "وَبُرِّزَتِ [h:9792[ٱ]لْجَحِيمُ لِم[a:14287[َن ي]َرَىٰ"}, {"id": 5749, "surahId": 79, "ayahNumber": 37, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "فَأَمَّا مَن طَغَىٰ", "translationId": "Adapun orang yang melampaui batas,", "textTajweed": "فَأَ[g[مّ]َا مَ[f:14288[ن ط]َغَىٰ"}, {"id": 5750, "surahId": 79, "ayahNumber": 38, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "translationId": "dan lebih mengutamakan kehidupan dunia,", "textTajweed": "وَءَاثَرَ [h:14289[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا"}, {"id": 5751, "surahId": 79, "ayahNumber": 39, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ", "translationId": "maka sesungguhnya nerakalah tempat tinggal(nya).", "textTajweed": "فَإِ[g[نّ]َ [h:14290[ٱ]لْجَحِيمَ هِىَ [h:14291[ٱ]لْمَأْوَىٰ"}, {"id": 5752, "surahId": 79, "ayahNumber": 40, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ", "translationId": "Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari keinginan hawa nafsunya,", "textTajweed": "وَأَ[g[مّ]َا مَنْ خَافَ مَقَامَ رَبِّه[n[ِۦ] وَنَهَى [h:14292[ٱ][l[ل][g[نّ]َفْسَ عَنِ [h:12957[ٱ]لْهَوَىٰ"}, {"id": 5753, "surahId": 79, "ayahNumber": 41, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ", "translationId": "maka sesungguhnya surgalah tempat tinggal(nya).", "textTajweed": "فَإِ[g[نّ]َ [h:14293[ٱ]لْجَ[g[نّ]َةَ هِىَ [h:14291[ٱ]لْمَأْوَىٰ"}, {"id": 5754, "surahId": 79, "ayahNumber": 42, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا", "translationId": "(Orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari kebangkitan, kapankah terjadinya?", "textTajweed": "يَسْــَٔلُونَكَ عَنِ [h:5172[ٱ][l[ل]سَّاعَةِ أَيَّانَ مُرْسَ[n[ـٰ]هَا"}, {"id": 5755, "surahId": 79, "ayahNumber": 43, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ", "translationId": "Siapakah kamu (maka) dapat menyebutkan (waktunya)?", "textTajweed": "فِيمَ أَ[f:169[نت]َ مِ[f:14294[ن ذ]ِكْرَ[n[ٮٰ]هَآ"}, {"id": 5756, "surahId": 79, "ayahNumber": 44, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ", "translationId": "Kepada Tuhanmulah dikembalikan kesudahannya (ketentuan waktunya).", "textTajweed": "إِلَىٰ رَبِّكَ مُ[f:14295[نت]َهَ[n[ـٰ]هَآ"}, {"id": 5757, "surahId": 79, "ayahNumber": 45, "juzNumber": 30, "ainNumber": 521, "isAinEnd": false, "textUthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا", "translationId": "Kamu hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari berbangkit)", "textTajweed": "إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُ[f:14296[نذ]ِرُ م[a:14297[َن ي]َخْشَ[n[ـٰ]هَا"}, {"id": 5758, "surahId": 79, "ayahNumber": 46, "juzNumber": 30, "ainNumber": 521, "isAinEnd": true, "textUthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا", "translationId": "Pada hari mereka melihat hari berbangkit itu, mereka merasa seakan-akan tidak tinggal (di dunia) melainkan (sebentar saja) di waktu sore atau pagi hari.", "textTajweed": "كَأَ[g[نّ]َهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَث[o[ُوٓ][s[اْ] إِلَّا عَشِيَّةً أَوْ ضُحَ[n[ـٰ]هَا"}]}