{"surah": {"id": 107, "nameArabic": "سُورَةُ المَاعُونِ", "nameLatin": "Al-Maa'un", "translationId": "Barang-Barang yang Berguna", "revelationPlace": "Makkiyah", "totalAyahs": 7}, "ayahs": [{"id": 6198, "surahId": 107, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "translationId": "Tahukah kamu (orang) yang mendustakan agama?", "textTajweed": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يُكَذِّبُ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"id": 6199, "surahId": 107, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "translationId": "Itulah orang yang menghardik anak yatim,", "textTajweed": "فَذ[n[َٲ]لِكَ [h:14654[ٱ]لَّذِى يَدُعُّ [h:14655[ٱ]لْيَت[p[ِي]مَ"}, {"id": 6200, "surahId": 107, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "translationId": "dan tidak menganjurkan memberi makan orang miskin.", "textTajweed": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"id": 6201, "surahId": 107, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "translationId": "Maka kecelakaanlah bagi orang-orang yang shalat,", "textTajweed": "فَوَيْ[u:14656[لٌ ل]ِّلْمُصَلّ[p[ِي]نَ"}, {"id": 6202, "surahId": 107, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "translationId": "(yaitu) orang-orang yang lalai dari shalatnya,", "textTajweed": "ٱلَّذِينَ هُمْ عَ[f:14657[ن ص]َلَاتِهِمْ سَاه[p[ُو]نَ"}, {"id": 6203, "surahId": 107, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 549, "isAinEnd": false, "textUthmani": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "translationId": "orang-orang yang berbuat riya,", "textTajweed": "ٱلَّذِينَ هُمْ يُر[o[َا]ٓء[p[ُو]نَ"}, {"id": 6204, "surahId": 107, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 549, "isAinEnd": true, "textUthmani": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "translationId": "dan enggan (menolong dengan) barang berguna.", "textTajweed": "وَيَمْنَعُونَ [h:14658[ٱ]لْمَاع[p[ُو]نَ"}]}