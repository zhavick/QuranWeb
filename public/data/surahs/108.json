{"surah": {"id": 108, "nameArabic": "سُورَةُ الكَوۡثَرِ", "nameLatin": "Al-Kawthar", "translationId": "Nikmat yang Berlimpah", "revelationPlace": "Makkiyah", "totalAyahs": 3}, "ayahs": [{"id": 6205, "surahId": 108, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 550, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ", "translationId": "Sesungguhnya Kami telah memberikan kepadamu nikmat yang banyak.", "textTajweed": "إِ[g[نّ][o[َآ] أَعْطَيْنَ[n[ـٰ]كَ [h:14659[ٱ]لْكَوْثَرَ"}, {"id": 6206, "surahId": 108, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 550, "isAinEnd": false, "textUthmani": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ", "translationId": "Maka dirikanlah shalat karena Tuhanmu; dan berkorbanlah.", "textTajweed": "فَصَلِّ لِرَبِّكَ وَ[h:14660[ٱ]نْحَرْ"}, {"id": 6207, "surahId": 108, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 550, "isAinEnd": true, "textUthmani": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ", "translationId": "Sesungguhnya orang-orang yang membenci kamu dialah yang terputus.", "textTajweed": "إِ[g[نّ]َ شَانِئَكَ هُوَ [h:14661[ٱ]لْأَ[q:14662[بْ]تَرُ"}]}