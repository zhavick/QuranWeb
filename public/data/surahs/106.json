{"surah": {"id": 106, "nameArabic": "سُورَةُ قُرَيۡشٍ", "nameLatin": "Quraish", "translationId": "Suku Quraisy", "revelationPlace": "Makkiyah", "totalAyahs": 4}, "ayahs": [{"id": 6194, "surahId": 106, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 548, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ", "translationId": "Karena kebiasaan orang-orang Quraisy,", "textTajweed": "لِإِيلَ[n[ـٰ]فِ قُر[p[َي]ْشٍ"}, {"id": 6195, "surahId": 106, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 548, "isAinEnd": false, "textUthmani": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ", "translationId": "(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas.", "textTajweed": "إ[n[ِۦ]لَ[n[ـٰ]فِهِمْ رِحْلَةَ [h:14647[ٱ][l[ل]شِّت[o[َا]ٓءِ وَ[h:14648[ٱ][l[ل]صّ[p[َي]ْفِ"}, {"id": 6196, "surahId": 106, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 548, "isAinEnd": false, "textUthmani": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ", "translationId": "Maka hendaklah mereka menyembah Tuhan Pemilik rumah ini (Ka'bah).", "textTajweed": "فَلْيَعْبُدُو[s[اْ] رَبَّ هَ[n[ـٰ]ذَا [h:14649[ٱ]لْب[p[َي]ْتِ"}, {"id": 6197, "surahId": 106, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 548, "isAinEnd": true, "textUthmani": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ", "translationId": "Yang telah memberi makanan kepada mereka untuk menghilangkan lapar dan mengamankan mereka dari ketakutan.", "textTajweed": "ٱلَّذ[o[ِىٓ] أَ[q:14650[طْ]عَمَه[w:14651[ُم م]ِّ[f:14454[ن ج]ُو[a:14652[عٍ و]َءَامَنَه[w:14653[ُم م]ِّنْ خ[p[َو]ْفِۭ"}]}