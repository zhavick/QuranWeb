{"surah": {"id": 96, "nameArabic": "سُورَةُ العَلَقِ", "nameLatin": "Al-Alaq", "translationId": "Segumpal Darah", "revelationPlace": "Makkiyah", "totalAyahs": 19}, "ayahs": [{"id": 6107, "surahId": 96, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "translationId": "Bacalah dengan (menyebut) nama Tuhanmu Yang menciptakan,", "textTajweed": "ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ"}, {"id": 6108, "surahId": 96, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "translationId": "Dia telah menciptakan manusia dari segumpal darah.", "textTajweed": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ"}, {"id": 6109, "surahId": 96, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "translationId": "Bacalah, dan Tuhanmulah Yang Maha Pemurah,", "textTajweed": "ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ"}, {"id": 6110, "surahId": 96, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "translationId": "Yang mengajar (manusia) dengan perantaran kalam,", "textTajweed": "ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ"}, {"id": 6111, "surahId": 96, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "translationId": "Dia mengajar kepada manusia apa yang tidak diketahuinya.", "textTajweed": "عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ"}, {"id": 6112, "surahId": 96, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "translationId": "Ketahuilah! Sesungguhnya manusia benar-benar melampaui batas,", "textTajweed": "كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ"}, {"id": 6113, "surahId": 96, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "translationId": "karena dia melihat dirinya serba cukup.", "textTajweed": "أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ"}, {"id": 6114, "surahId": 96, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "translationId": "Sesungguhnya hanya kepada Tuhanmulah kembali(mu).", "textTajweed": "إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ"}, {"id": 6115, "surahId": 96, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "translationId": "Bagaimana pendapatmu tentang orang yang melarang,", "textTajweed": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ"}, {"id": 6116, "surahId": 96, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "عَبْدًا إِذَا صَلَّىٰٓ", "translationId": "seorang hamba ketika mengerjakan shalat,", "textTajweed": "عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ"}, {"id": 6117, "surahId": 96, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "translationId": "bagaimana pendapatmu jika orang yang melarang itu berada di atas kebenaran,", "textTajweed": "أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ"}, {"id": 6118, "surahId": 96, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "translationId": "atau dia menyuruh bertakwa (kepada Allah)?", "textTajweed": "أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ"}, {"id": 6119, "surahId": 96, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "translationId": "Bagaimana pendapatmu jika orang yang melarang itu mendustakan dan berpaling?", "textTajweed": "أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ"}, {"id": 6120, "surahId": 96, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "translationId": "Tidaklah dia mengetahui bahwa sesungguhnya Allah melihat segala perbuatannya?", "textTajweed": "أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ"}, {"id": 6121, "surahId": 96, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "translationId": "Ketahuilah, sungguh jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya,", "textTajweed": "كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ"}, {"id": 6122, "surahId": 96, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "translationId": "(yaitu) ubun-ubun orang yang mendustakan lagi durhaka.", "textTajweed": "نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ"}, {"id": 6123, "surahId": 96, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "فَلْيَدْعُ نَادِيَهُۥ", "translationId": "Maka biarlah dia memanggil golongannya (untuk menolongnya),", "textTajweed": "فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ"}, {"id": 6124, "surahId": 96, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 538, "isAinEnd": false, "textUthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ", "translationId": "kelak Kami akan memanggil malaikat Zabaniyah,", "textTajweed": "سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ"}, {"id": 6125, "surahId": 96, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 538, "isAinEnd": true, "textUthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "translationId": "sekali-kali jangan, janganlah kamu patuh kepadanya; dan sujudlah dan dekatkanlah (dirimu kepada Tuhan).", "textTajweed": "كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩"}]}