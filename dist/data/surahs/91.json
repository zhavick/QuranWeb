{"surah": {"id": 91, "nameArabic": "سُورَةُ الشَّمۡسِ", "nameLatin": "Ash-Shams", "translationId": "Matahari", "revelationPlace": "Makkiyah", "totalAyahs": 15}, "ayahs": [{"id": 6044, "surahId": 91, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا", "translationId": "Demi matahari dan cahayanya di pagi hari,", "textTajweed": "وَ[h:9999[ٱ][l[ل]شَّمْسِ وَضُحَ[n[ـٰ]هَا"}, {"id": 6045, "surahId": 91, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "translationId": "dan bulan apabila mengiringinya,", "textTajweed": "وَ[h:9999[ٱ]لْقَمَرِ إِذَا تَلَ[n[ـٰ]هَا"}, {"id": 6046, "surahId": 91, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "translationId": "dan siang apabila menampakkannya,", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا جَلَّ[n[ـٰ]هَا"}, {"id": 6047, "surahId": 91, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "translationId": "dan malam apabila menutupinya,", "textTajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَ[n[ـٰ]هَا"}, {"id": 6048, "surahId": 91, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "translationId": "dan langit serta pembinaannya,", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَمَا بَنَ[n[ـٰ]هَا"}, {"id": 6049, "surahId": 91, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "translationId": "dan bumi serta penghamparannya,", "textTajweed": "وَ[h:9999[ٱ]لْأَرْضِ وَمَا طَحَ[n[ـٰ]هَا"}, {"id": 6050, "surahId": 91, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "translationId": "dan jiwa serta penyempurnaannya (ciptaannya),", "textTajweed": "وَنَفْ[a:14521[سٍ و]َمَا سَوَّ[n[ٮٰ]هَا"}, {"id": 6051, "surahId": 91, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "translationId": "maka Allah mengilhamkan kepada jiwa itu (jalan) kefasikan dan ketakwaannya.", "textTajweed": "فَأَلْهَمَهَا فُجُورَهَا وَتَ[q:14522[قْ]وَ[n[ٮٰ]هَا"}, {"id": 6052, "surahId": 91, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "translationId": "sesungguhnya beruntunglah orang yang mensucikan jiwa itu,", "textTajweed": "قَ[q:298[دْ] أَفْلَحَ مَ[f:14523[ن ز]َكَّ[n[ـٰ]هَا"}, {"id": 6053, "surahId": 91, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "translationId": "dan sesungguhnya merugilah orang yang mengotorinya.", "textTajweed": "وَقَ[q:387[دْ] خَابَ مَ[f:14524[ن د]َسَّ[n[ـٰ]هَا"}, {"id": 6054, "surahId": 91, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "translationId": "(Kaum) Tsamud telah mendustakan (rasulnya) karena mereka melampaui batas,", "textTajweed": "كَذَّبَتْ ثَمُودُ بِطَغْوَ[n[ٮٰ]هَآ"}, {"id": 6055, "surahId": 91, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "translationId": "ketika bangkit orang yang paling celaka di antara mereka,", "textTajweed": "إِذِ [h:14525[ٱ][i:14526[نۢب]َعَثَ أَشْقَ[n[ـٰ]هَا"}, {"id": 6056, "surahId": 91, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "translationId": "lalu Rasul Allah (Saleh) berkata kepada mereka: (\"Biarkanlah) unta betina Allah dan minumannya\".", "textTajweed": "فَقَالَ لَهُمْ رَسُولُ [h:3306[ٱ]للَّهِ نَاقَةَ [h:14527[ٱ]للَّهِ وَسُ[q:14528[قْ]يَ[n[ـٰ]هَا"}, {"id": 6057, "surahId": 91, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 533, "isAinEnd": false, "textUthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "translationId": "Lalu mereka mendustakannya dan menyembelih unta itu, maka Tuhan mereka membinasakan mereka disebabkan dosa mereka, lalu Allah menyama-ratakan mereka (dengan tanah),", "textTajweed": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّه[c:14529[ُم ب]ِذَ[i:13779[نۢب]ِهِمْ فَسَوَّ[n[ٮٰ]هَا"}, {"id": 6058, "surahId": 91, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 533, "isAinEnd": true, "textUthmani": "وَلَا يَخَافُ عُقْبَٰهَا", "translationId": "dan Allah tidak takut terhadap akibat tindakan-Nya itu.", "textTajweed": "وَلَا يَخَافُ عُ[q:14530[قْ]بَ[n[ـٰ]هَا"}]}