{"surah": {"id": 89, "nameArabic": "سُورَةُ الفَجۡرِ", "nameLatin": "Al-Fajr", "translationId": "Fajar", "revelationPlace": "Makkiyah", "totalAyahs": 30}, "ayahs": [{"id": 5994, "surahId": 89, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ", "translationId": "Demi fajar,", "textTajweed": "وَ[h:9999[ٱ]لْفَ[q:14468[جْ]رِ"}, {"id": 5995, "surahId": 89, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَلَيَالٍ عَشْرٍۢ", "translationId": "dan malam yang sepuluh,", "textTajweed": "وَلَيَالٍ عَشْرٍ"}, {"id": 5996, "surahId": 89, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ", "translationId": "dan yang genap dan yang ganjil,", "textTajweed": "وَ[h:9999[ٱ][l[ل]شَّفْعِ وَ[h:14469[ٱ]لْوَتْرِ"}, {"id": 5997, "surahId": 89, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَٱلَّيْلِ إِذَا يَسْرِ", "translationId": "dan malam bila berlalu.", "textTajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَسْرِ"}, {"id": 5998, "surahId": 89, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ", "translationId": "Pada yang demikian itu terdapat sumpah (yang dapat diterima) oleh orang-orang yang berakal.", "textTajweed": "هَلْ فِى ذ[n[َٲ]لِكَ قَسَ[u:14470[مٌ ل]ِّذِى حِ[q:14471[جْ]رٍ"}, {"id": 5999, "surahId": 89, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ", "translationId": "Apakah kamu tidak memperhatikan bagaimana Tuhanmu berbuat terhadap kaum 'Aad?", "textTajweed": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِع[p[َا][q[د]ٍ"}, {"id": 6000, "surahId": 89, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ", "translationId": "(yaitu) penduduk Iram yang mempunyai bangunan-bangunan yang tinggi,", "textTajweed": "إِرَمَ ذَاتِ [h:14472[ٱ]لْعِم[p[َا][q[د]ِ"}, {"id": 6001, "surahId": 89, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ", "translationId": "yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,", "textTajweed": "ٱلَّتِى لَمْ يُخْلَ[q:14473[قْ] مِثْلُهَا فِى [h:2519[ٱ]لْبِلَ[p[ـٰ][q[د]ِ"}, {"id": 6002, "surahId": 89, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ", "translationId": "dan kaum Tsamud yang memotong batu-batu besar di lembah,", "textTajweed": "وَثَمُودَ [h:14474[ٱ]لَّذِينَ جَابُو[s[اْ] [h:14475[ٱ][l[ل]صَّخْرَ بِ[h:8451[ٱ]لْو[p[َا][q[د]ِ"}, {"id": 6003, "surahId": 89, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ", "translationId": "dan kaum Fir'aun yang mempunyai pasak-pasak (tentara yang banyak),", "textTajweed": "وَفِرْعَوْنَ ذِى [h:14476[ٱ]لْأَوْت[p[َا][q[د]ِ"}, {"id": 6004, "surahId": 89, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ", "translationId": "yang berbuat sewenang-wenang dalam negeri,", "textTajweed": "ٱلَّذِينَ طَغَوْ[s[اْ] فِى [h:2519[ٱ]لْبِلَ[p[ـٰ][q[د]ِ"}, {"id": 6005, "surahId": 89, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ", "translationId": "lalu mereka berbuat banyak kerusakan dalam negeri itu,", "textTajweed": "فَأَكْثَرُو[s[اْ] فِيهَا [h:14477[ٱ]لْفَس[p[َا][q[د]َ"}, {"id": 6006, "surahId": 89, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ", "translationId": "karena itu Tuhanmu menimpakan kepada mereka cemeti azab,", "textTajweed": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذ[p[َا][q[ب]ٍ"}, {"id": 6007, "surahId": 89, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ", "translationId": "sesungguhnya Tuhanmu benar-benar mengawasi.", "textTajweed": "إِ[g[نّ]َ رَبَّكَ لَبِ[h:14478[ٱ]لْمِرْص[p[َا][q[د]ِ"}, {"id": 6008, "surahId": 89, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ", "translationId": "Adapun manusia apabila Tuhannya mengujinya lalu dia dimuliakan-Nya dan diberi-Nya kesenangan, maka dia akan berkata: \"Tuhanku telah memuliakanku\".", "textTajweed": "فَأَ[g[مّ]َا [h:14479[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِذَا مَا [h:14480[ٱ][q:14481[بْ]تَلَ[n[ـٰ]هُ رَبُّهُ[n[ۥ] فَأَكْرَمَهُ[n[ۥ] وَنَعَّمَهُ[n[ۥ] فَيَقُولُ رَبّ[o[ِىٓ] أَكْرَمَنِ"}, {"id": 6009, "surahId": 89, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ", "translationId": "Adapun bila Tuhannya mengujinya lalu membatasi rezekinya maka dia berkata: \"Tuhanku menghinakanku\".", "textTajweed": "وَأَ[g[مّ][o[َآ] إِذَا مَا [h:14480[ٱ][q:14481[بْ]تَلَ[n[ـٰ]هُ فَقَدَرَ عَلَيْهِ رِزْقَهُ[n[ۥ] فَيَقُولُ رَبّ[o[ِىٓ] أَهَ[n[ـٰ]نَنِ"}, {"id": 6010, "surahId": 89, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ", "translationId": "Sekali-kali tidak (demikian), sebenarnya kamu tidak memuliakan anak yatim,", "textTajweed": "كَلَّا‌ۖ بَل لَّا تُكْرِمُونَ [h:14482[ٱ]لْيَت[p[ِي]مَ"}, {"id": 6011, "surahId": 89, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "translationId": "dan kamu tidak saling mengajak memberi makan orang miskin,", "textTajweed": "وَلَا تَحَ[m[ـٰٓ]ضُّونَ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"id": 6012, "surahId": 89, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا", "translationId": "dan kamu memakan harta pusaka dengan cara mencampur baurkan (yang halal dan yang bathil),", "textTajweed": "وَتَأْكُلُونَ [h:14483[ٱ][l[ل]تُّرَاثَ أَكْل[u:14484[اً ل]َّ[g[مّ]ًا"}, {"id": 6013, "surahId": 89, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا", "translationId": "dan kamu mencintai harta benda dengan kecintaan yang berlebihan.", "textTajweed": "وَتُحِبُّونَ [h:14485[ٱ]لْمَالَ حُب[f:14486[ًّا ج]َ[g[مّ]ًا"}, {"id": 6014, "surahId": 89, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا", "translationId": "Jangan (berbuat demikian). Apabila bumi digoncangkan berturut-turut,", "textTajweed": "كَلّ[o[َآ] إِذَا دُكَّتِ [h:14487[ٱ]لْأَرْضُ دَك[f:14488[ًّا د]َكًّا"}, {"id": 6015, "surahId": 89, "ayahNumber": 22, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا", "translationId": "dan datanglah Tuhanmu; sedang malaikat berbaris-baris.", "textTajweed": "وَج[o[َا]ٓءَ رَبُّكَ وَ[h:14489[ٱ]لْمَلَكُ صَف[f:14490[ًّا ص]َفًّا"}, {"id": 6016, "surahId": 89, "ayahNumber": 23, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ", "translationId": "Dan pada hari itu diperlihatkan neraka Jahannam; dan pada hari itu ingatlah manusia, akan tetapi tidak berguna lagi mengingat itu baginya.", "textTajweed": "وَجِ[s[اْ][o[ىٓ]ءَ يَوْمَئِ[i:14491[ذِۭ ب]ِجَهَ[g[نّ]َمَ‌ۚ يَوْمَئِ[a:14492[ذٍ ي]َتَذَكَّرُ [h:14286[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ وَأَ[g[نّ]َىٰ لَهُ [h:14493[ٱ][l[ل]ذِّكْرَىٰ"}, {"id": 6017, "surahId": 89, "ayahNumber": 24, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى", "translationId": "Dia mengatakan: \"Alangkah baiknya kiranya aku dahulu mengerjakan (amal saleh) untuk hidupku ini\".", "textTajweed": "يَقُولُ يَ[n[ـٰ]لَيْتَنِى قَدَّمْتُ لِحَيَاتِى"}, {"id": 6018, "surahId": 89, "ayahNumber": 25, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ", "translationId": "Maka pada hari itu tiada seorangpun yang menyiksa seperti siksa-Nya.", "textTajweed": "فَيَوْمَئِ[u:10538[ذٍ ل]َّا يُعَذِّبُ عَذَابَهُ[o[ۥٓ] أَحَ[q[د]ٌ"}, {"id": 6019, "surahId": 89, "ayahNumber": 26, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ", "translationId": "dan tiada seorangpun yang mengikat seperti ikatan-Nya.", "textTajweed": "وَلَا يُوثِقُ وَثَاقَهُ[o[ۥٓ] أَحَ[q[د]ٌ"}, {"id": 6020, "surahId": 89, "ayahNumber": 27, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ", "translationId": "Hai jiwa yang tenang.", "textTajweed": "يَ[o[ـٰٓ]أَيَّتُهَا [h:14494[ٱ][l[ل][g[نّ]َفْسُ [h:14495[ٱ]لْمُ[q:14496[طْ]مَئِ[g[نّ]َةُ"}, {"id": 6021, "surahId": 89, "ayahNumber": 28, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ", "translationId": "Kembalilah kepada Tuhanmu dengan hati yang puas lagi diridhai-Nya.", "textTajweed": "ٱرْجِع[o[ِىٓ] إِلَىٰ رَبِّكِ رَاضِيَ[a:14497[ةً م]َّرْضِيَّةً"}, {"id": 6022, "surahId": 89, "ayahNumber": 29, "juzNumber": 30, "ainNumber": 531, "isAinEnd": false, "textUthmani": "فَٱدْخُلِى فِى عِبَٰدِى", "translationId": "Maka masuklah ke dalam jama'ah hamba-hamba-Ku,", "textTajweed": "فَ[h:9999[ٱ][q:14498[دْ]خُلِى فِى عِبَ[n[ـٰ]دِى"}, {"id": 6023, "surahId": 89, "ayahNumber": 30, "juzNumber": 30, "ainNumber": 531, "isAinEnd": true, "textUthmani": "وَٱدْخُلِى جَنَّتِى", "translationId": "masuklah ke dalam surga-Ku.", "textTajweed": "وَ[h:9999[ٱ][q:14499[دْ]خُلِى جَ[g[نّ]َتِى"}]}