{"surah": {"id": 92, "nameArabic": "سُورَةُ اللَّيۡلِ", "nameLatin": "Al-Lail", "translationId": "Malam", "revelationPlace": "Makkiyah", "totalAyahs": 21}, "ayahs": [{"id": 6059, "surahId": 92, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "translationId": "Demi malam apabila menutupi (cahaya siang),", "textTajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَىٰ"}, {"id": 6060, "surahId": 92, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "translationId": "dan siang apabila terang benderang,", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا تَجَلَّىٰ"}, {"id": 6061, "surahId": 92, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "translationId": "dan penciptaan laki-laki dan perempuan,", "textTajweed": "وَمَا خَلَقَ [h:14531[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"}, {"id": 6062, "surahId": 92, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "translationId": "sesungguhnya usaha kamu memang berbeda-beda.", "textTajweed": "إِ[g[نّ]َ سَعْيَكُمْ لَشَتَّىٰ"}, {"id": 6063, "surahId": 92, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "translationId": "Adapun orang yang memberikan (hartanya di jalan Allah) dan bertakwa,", "textTajweed": "فَأَ[g[مّ]َا مَنْ أَعْطَىٰ وَ[h:2036[ٱ]تَّقَىٰ"}, {"id": 6064, "surahId": 92, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "translationId": "dan membenarkan adanya pahala yang terbaik (surga),", "textTajweed": "وَصَدَّقَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"id": 6065, "surahId": 92, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "translationId": "maka Kami kelak akan menyiapkan baginya jalan yang mudah.", "textTajweed": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْيُسْرَىٰ"}, {"id": 6066, "surahId": 92, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "translationId": "Dan adapun orang-orang yang bakhil dan merasa dirinya cukup,", "textTajweed": "وَأَ[g[مّ]َا م[i:14532[َنۢ ب]َخِلَ وَ[h:13634[ٱ]سْتَغْنَىٰ"}, {"id": 6067, "surahId": 92, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "translationId": "serta mendustakan pahala terbaik,", "textTajweed": "وَكَذَّبَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"id": 6068, "surahId": 92, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "translationId": "maka kelak Kami akan menyiapkan baginya (jalan) yang sukar.", "textTajweed": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْعُسْرَىٰ"}, {"id": 6069, "surahId": 92, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "translationId": "Dan hartanya tidak bermanfaat baginya apabila ia telah binasa.", "textTajweed": "وَمَا يُغْنِى عَنْهُ مَالُهُ[o[ۥٓ] إِذَا تَرَدَّىٰٓ"}, {"id": 6070, "surahId": 92, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "translationId": "Sesungguhnya kewajiban Kamilah memberi petunjuk,", "textTajweed": "إِ[g[نّ]َ عَلَيْنَا لَلْهُدَىٰ"}, {"id": 6071, "surahId": 92, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "translationId": "dan sesungguhnya kepunyaan Kamilah akhirat dan dunia.", "textTajweed": "وَإِ[g[نّ]َ لَنَا لَلْأَخِرَةَ وَ[h:12987[ٱ]لْأُولَىٰ"}, {"id": 6072, "surahId": 92, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "translationId": "Maka, kami memperingatkan kamu dengan neraka yang menyala-nyala.", "textTajweed": "فَأَ[f:14533[نذ]َرْتُكُمْ نَا[f:14534[رًا ت]َلَظَّىٰ"}, {"id": 6073, "surahId": 92, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "translationId": "Tidak ada yang masuk ke dalamnya kecuali orang yang paling celaka,", "textTajweed": "لَا يَصْلَ[n[ـٰ]ه[o[َآ] إِلَّا [h:14535[ٱ]لْأَشْقَى"}, {"id": 6074, "surahId": 92, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "translationId": "yang mendustakan (kebenaran) dan berpaling (dari iman).", "textTajweed": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"}, {"id": 6075, "surahId": 92, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "translationId": "Dan kelak akan dijauhkan orang yang paling takwa dari neraka itu,", "textTajweed": "وَسَيُجَ[g[نّ]َبُهَا [h:14536[ٱ]لْأَتْقَى"}, {"id": 6076, "surahId": 92, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "translationId": "yang menafkahkan hartanya (di jalan Allah) untuk membersihkannya,", "textTajweed": "ٱلَّذِى يُؤْتِى مَالَهُ[n[ۥ] يَتَزَكَّىٰ"}, {"id": 6077, "surahId": 92, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "translationId": "padahal tidak ada seseorangpun memberikan suatu nikmat kepadanya yang harus dibalasnya,", "textTajweed": "وَمَا لِأَحَدٍ عِ[f:719[ند]َهُ[n[ۥ] م[a:7433[ِن ن]ِّعْمَ[f:14537[ةٍ ت]ُ[q:11814[جْ]زَىٰٓ"}, {"id": 6078, "surahId": 92, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 534, "isAinEnd": false, "textUthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "translationId": "tetapi (dia memberikan itu semata-mata) karena mencari keridhaan Tuhannya yang Maha Tinggi.", "textTajweed": "إِلَّا [h:1610[ٱ][q:1130[بْ]تِغ[o[َا]ٓءَ وَ[q:1611[جْ]هِ رَبِّهِ [h:14538[ٱ]لْأَعْلَىٰ"}, {"id": 6079, "surahId": 92, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 534, "isAinEnd": true, "textUthmani": "وَلَسَوْفَ يَرْضَىٰ", "translationId": "Dan kelak dia benar-benar mendapat kepuasan.", "textTajweed": "وَلَسَوْفَ يَرْضَىٰ"}]}