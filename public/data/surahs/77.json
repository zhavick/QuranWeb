{"surah": {"id": 77, "nameArabic": "سُورَةُ المُرۡسَلَاتِ", "nameLatin": "Al-Mursalaat", "translationId": "Malaikat-Malaikat yang Diutus", "revelationPlace": "Makkiyah", "totalAyahs": 50}, "ayahs": [{"id": 5623, "surahId": 77, "ayahNumber": 1, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "translationId": "Demi malaikat-malaikat yang diutus untuk membawa kebaikan,", "textTajweed": "وَ[h:9999[ٱ]لْمُرْسَلَ[n[ـٰ]تِ عُرْفًا"}, {"id": 5624, "surahId": 77, "ayahNumber": 2, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "translationId": "dan (malaikat-malaikat) yang terbang dengan kencangnya,", "textTajweed": "فَ[h:9999[ٱ]لْعَ[n[ـٰ]صِفَ[n[ـٰ]تِ عَصْفًا"}, {"id": 5625, "surahId": 77, "ayahNumber": 3, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "translationId": "dan (malaikat-malaikat) yang menyebarkan (rahmat Tuhannya) dengan seluas-luasnya,", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِر[n[َٲ]تِ نَشْرًا"}, {"id": 5626, "surahId": 77, "ayahNumber": 4, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "translationId": "dan (malaikat-malaikat) yang membedakan (antara yang hak dan yang bathil) dengan sejelas-jelasnya,", "textTajweed": "فَ[h:9999[ٱ]لْفَ[n[ـٰ]رِقَ[n[ـٰ]تِ فَرْقًا"}, {"id": 5627, "surahId": 77, "ayahNumber": 5, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "translationId": "dan (malaikat-malaikat) yang menyampaikan wahyu,", "textTajweed": "فَ[h:9999[ٱ]لْمُلْقِيَ[n[ـٰ]تِ ذِكْرًا"}, {"id": 5628, "surahId": 77, "ayahNumber": 6, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "عُذْرًا أَوْ نُذْرًا", "translationId": "untuk menolak alasan-alasan atau memberi peringatan,", "textTajweed": "عُذْرًا أَوْ نُذْرًا"}, {"id": 5629, "surahId": 77, "ayahNumber": 7, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "translationId": "sesungguhnya apa yang dijanjikan kepadamu itu pasti terjadi.", "textTajweed": "إِ[g[نّ]َمَا تُوعَدُونَ لَو[n[َٲ]قِعٌ"}, {"id": 5630, "surahId": 77, "ayahNumber": 8, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "translationId": "Maka apabila bintang-bintang telah dihapuskan,", "textTajweed": "فَإِذَا [h:14209[ٱ][l[ل][g[نّ]ُجُومُ طُمِسَتْ"}, {"id": 5631, "surahId": 77, "ayahNumber": 9, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "translationId": "dan apabila langit telah dibelah,", "textTajweed": "وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ فُرِجَتْ"}, {"id": 5632, "surahId": 77, "ayahNumber": 10, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "translationId": "dan apabila gunung-gunung telah dihancurkan menjadi debu,", "textTajweed": "وَإِذَا [h:14211[ٱ]لْجِبَالُ نُسِفَتْ"}, {"id": 5633, "surahId": 77, "ayahNumber": 11, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "translationId": "dan apabila rasul-rasul telah ditetapkan waktu (mereka).", "textTajweed": "وَإِذَا [h:14212[ٱ][l[ل]رُّسُلُ أُقِّتَتْ"}, {"id": 5634, "surahId": 77, "ayahNumber": 12, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "translationId": "(Niscaya dikatakan kepada mereka:) \"Sampai hari apakah ditangguhkan (mengazab orang-orang kafir itu)?\"", "textTajweed": "لِأَىِّ يَوْمٍ أُجِّلَتْ"}, {"id": 5635, "surahId": 77, "ayahNumber": 13, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "لِيَوْمِ ٱلْفَصْلِ", "translationId": "Sampai hari keputusan.", "textTajweed": "لِيَوْمِ [h:14213[ٱ]لْفَصْلِ"}, {"id": 5636, "surahId": 77, "ayahNumber": 14, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "translationId": "Dan tahukah kamu apakah hari keputusan itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11336[ٱ]لْفَصْلِ"}, {"id": 5637, "surahId": 77, "ayahNumber": 15, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5638, "surahId": 77, "ayahNumber": 16, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "translationId": "Bukankah Kami telah membinasakan orang-orang yang dahulu?", "textTajweed": "أَلَمْ نُهْلِكِ [h:14215[ٱ]لْأَوَّل[p[ِي]نَ"}, {"id": 5639, "surahId": 77, "ayahNumber": 17, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "translationId": "Lalu Kami iringkan (azab Kami terhadap) mereka dengan (mengazab) orang-orang yang datang kemudian.", "textTajweed": "ثُ[g[مّ]َ نُتْبِعُهُمُ [h:14216[ٱ]لْأَخِر[p[ِي]نَ"}, {"id": 5640, "surahId": 77, "ayahNumber": 18, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "translationId": "Demikianlah Kami berbuat terhadap orang-orang yang berdosa.", "textTajweed": "كَذ[n[َٲ]لِكَ نَفْعَلُ بِ[h:11348[ٱ]لْمُ[q:11348[جْ]رِم[p[ِي]نَ"}, {"id": 5641, "surahId": 77, "ayahNumber": 19, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5642, "surahId": 77, "ayahNumber": 20, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "translationId": "Bukankah Kami menciptakan kamu dari air yang hina?", "textTajweed": "أَلَمْ نَخْلُ[b:14217[ق]كّ[w:14218[ُم م]ّ[a:840[ِن م]ّ[o[َا]ٓ[a:10629[ءٍ م]َّه[p[ِي]نٍ"}, {"id": 5643, "surahId": 77, "ayahNumber": 21, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "translationId": "kemudian Kami letakkan dia dalam tempat yang kokoh (rahim),", "textTajweed": "فَجَعَلْنَ[n[ـٰ]هُ فِى قَرَا[a:9148[رٍ م]َّك[p[ِي]نٍ"}, {"id": 5644, "surahId": 77, "ayahNumber": 22, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "translationId": "sampai waktu yang ditentukan,", "textTajweed": "إِلَىٰ قَدَ[a:14219[رٍ م]َّعْل[p[ُو]مٍ"}, {"id": 5645, "surahId": 77, "ayahNumber": 23, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "translationId": "lalu Kami tentukan (bentuknya), maka Kami-lah sebaik-baik yang menentukan.", "textTajweed": "فَقَدَرْنَا فَنِعْمَ [h:14220[ٱ]لْقَ[n[ـٰ]دِر[p[ُو]نَ"}, {"id": 5646, "surahId": 77, "ayahNumber": 24, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5647, "surahId": 77, "ayahNumber": 25, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "translationId": "Bukankah Kami menjadikan bumi (tempat) berkumpul,", "textTajweed": "أَلَمْ نَ[q:14221[جْ]عَلِ [h:14222[ٱ]لْأَرْضَ كِفَاتًا"}, {"id": 5648, "surahId": 77, "ayahNumber": 26, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "translationId": "orang-orang hidup dan orang-orang mati?", "textTajweed": "أَحْي[o[َا]ٓ[a:14223[ءً و]َأَمْو[n[َٲ]تًا"}, {"id": 5649, "surahId": 77, "ayahNumber": 27, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "translationId": "dan Kami jadikan padanya gunung-gunung yang tinggi, dan Kami beri minum kamu dengan air tawar?", "textTajweed": "وَجَعَلْنَا فِيهَا رَو[n[َٲ]سِىَ شَ[n[ـٰ]مِخَ[n[ـٰ][a:14224[تٍ و]َأَسْقَيْنَ[n[ـٰ]ك[w:14225[ُم م]ّ[o[َا]ٓ[f:14226[ءً ف]ُرَاتًا"}, {"id": 5650, "surahId": 77, "ayahNumber": 28, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5651, "surahId": 77, "ayahNumber": 29, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "translationId": "(Dikatakan kepada mereka pada hari kiamat): \"Pergilah kamu mendapatkan azab yang dahulunya kamu mendustakannya.", "textTajweed": "ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ مَا كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ"}, {"id": 5652, "surahId": 77, "ayahNumber": 30, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "translationId": "Pergilah kamu mendapatkan naungan yang mempunyai tiga cabang,", "textTajweed": "ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ ظِ[f:14228[لٍّ ذ]ِى ثَلَ[n[ـٰ]ثِ شُعَ[q[ب]ٍ"}, {"id": 5653, "surahId": 77, "ayahNumber": 31, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "translationId": "yang tidak melindungi dan tidak pula menolak nyala api neraka\".", "textTajweed": "لَّا ظَلِي[a:14229[لٍ و]َلَا يُغْنِى مِنَ [h:14230[ٱ][l[ل]لَّهَ[q[ب]ِ"}, {"id": 5654, "surahId": 77, "ayahNumber": 32, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "translationId": "Sesungguhnya neraka itu melontarkan bunga api sebesar dan setinggi istana.", "textTajweed": "إِ[g[نّ]َهَا تَرْمِى بِشَرَ[f:14231[رٍ ك]َ[h:14232[ٱ]لْقَصْرِ"}, {"id": 5655, "surahId": 77, "ayahNumber": 33, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "translationId": "Seolah-olah ia iringan unta yang kuning.", "textTajweed": "كَأَ[g[نّ]َهُ[n[ۥ] جِمَ[n[ـٰ]لَ[f:14233[تٌ ص]ُفْرٌ"}, {"id": 5656, "surahId": 77, "ayahNumber": 34, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5657, "surahId": 77, "ayahNumber": 35, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "translationId": "Ini adalah hari, yang mereka tidak dapat berbicara (pada hari itu),", "textTajweed": "هَ[n[ـٰ]ذَا يَوْمُ لَا يَ[f:8795[نط]ِق[p[ُو]نَ"}, {"id": 5658, "surahId": 77, "ayahNumber": 36, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "translationId": "dan tidak diizinkan kepada mereka minta uzur sehingga mereka (dapat) minta uzur.", "textTajweed": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِر[p[ُو]نَ"}, {"id": 5659, "surahId": 77, "ayahNumber": 37, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5660, "surahId": 77, "ayahNumber": 38, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "translationId": "Ini adalah hari keputusan; (pada hari ini) Kami mengumpulkan kamu dan orang-orang terdahulu.", "textTajweed": "هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ‌ۖ جَمَعْنَ[n[ـٰ]كُمْ وَ[h:14234[ٱ]لْأَوَّل[p[ِي]نَ"}, {"id": 5661, "surahId": 77, "ayahNumber": 39, "juzNumber": 29, "ainNumber": 516, "isAinEnd": false, "textUthmani": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "translationId": "Jika kamu mempunyai tipu daya, maka lakukanlah tipu dayamu itu terhadap-Ku.", "textTajweed": "فَإِ[f:1670[ن ك]َانَ لَكُمْ كَيْ[f:14235[دٌ ف]َكِيد[p[ُو]نِ"}, {"id": 5662, "surahId": 77, "ayahNumber": 40, "juzNumber": 29, "ainNumber": 516, "isAinEnd": true, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5663, "surahId": 77, "ayahNumber": 41, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "translationId": "Sesungguhnya orang-orang yang bertakwa berada dalam naungan (yang teduh) dan (di sekitar) mata-mata air.", "textTajweed": "إِ[g[نّ]َ [h:7256[ٱ]لْمُتَّقِينَ فِى ظِلَ[n[ـٰ][a:14236[لٍ و]َعُي[p[ُو]نٍ"}, {"id": 5664, "surahId": 77, "ayahNumber": 42, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "translationId": "Dan (mendapat) buah-buahan dari (macam-macam) yang mereka ingini.", "textTajweed": "وَفَو[n[َٲ]كِهَ مِ[g[مّ]َا يَشْتَه[p[ُو]نَ"}, {"id": 5665, "surahId": 77, "ayahNumber": 43, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "translationId": "(Dikatakan kepada mereka): \"Makan dan minumlah kamu dengan enak karena apa yang telah kamu kerjakan\".", "textTajweed": "كُلُو[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِمَا كُ[f:100[نت]ُمْ تَعْمَل[p[ُو]نَ"}, {"id": 5666, "surahId": 77, "ayahNumber": 44, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "translationId": "Sesungguhnya demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.", "textTajweed": "إِ[g[نّ]َا كَذ[n[َٲ]لِكَ نَ[q:4214[جْ]زِى [h:4215[ٱ]لْمُحْسِن[p[ِي]نَ"}, {"id": 5667, "surahId": 77, "ayahNumber": 45, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5668, "surahId": 77, "ayahNumber": 46, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "translationId": "(Dikatakan kepada orang-orang kafir): \"Makanlah dan bersenang-senanglah kamu (di dunia dalam waktu) yang pendek; sesungguhnya kamu adalah orang-orang yang berdosa\".", "textTajweed": "كُلُو[s[اْ] وَتَمَتَّعُو[s[اْ] قَلِيلاً إِ[g[نّ]َك[w:14237[ُم م]ُّ[q:12353[جْ]رِم[p[ُو]نَ"}, {"id": 5669, "surahId": 77, "ayahNumber": 47, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5670, "surahId": 77, "ayahNumber": 48, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "translationId": "Dan apabila dikatakan kepada mereka: \"Rukuklah, niscaya mereka tidak mau ruku'.", "textTajweed": "وَإِذَا قِيلَ لَهُمُ [h:14238[ٱ]رْكَعُو[s[اْ] لَا يَرْكَع[p[ُو]نَ"}, {"id": 5671, "surahId": 77, "ayahNumber": 49, "juzNumber": 29, "ainNumber": 517, "isAinEnd": false, "textUthmani": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translationId": "Kecelakaan yang besarlah pada hari itu bagi orang-orang yang mendustakan.", "textTajweed": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"id": 5672, "surahId": 77, "ayahNumber": 50, "juzNumber": 29, "ainNumber": 517, "isAinEnd": true, "textUthmani": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "translationId": "Maka kepada perkataan apakah selain Al Quran ini mereka akan beriman?", "textTajweed": "فَبِأَىِّ حَدِي[i:5170[ثِۭ ب]َعْدَهُ[n[ۥ] يُؤْمِن[p[ُو]نَ"}]}