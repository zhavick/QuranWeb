{"surah": {"id": 114, "nameArabic": "سُورَةُ النَّاسِ", "nameLatin": "An-Naas", "translationId": "Umat Manusia", "revelationPlace": "Makkiyah", "totalAyahs": 6}, "ayahs": [{"id": 6231, "surahId": 114, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 556, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "translationId": "Katakanlah: \"Aku berlindung kepada Tuhan (yang memelihara dan menguasai) manusia.", "textTajweed": "قُلْ أَعُوذُ بِرَبِّ [h:14683[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"id": 6232, "surahId": 114, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 556, "isAinEnd": false, "textUthmani": "مَلِكِ ٱلنَّاسِ", "translationId": "Raja manusia.", "textTajweed": "مَلِكِ [h:14684[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"id": 6233, "surahId": 114, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 556, "isAinEnd": false, "textUthmani": "إِلَٰهِ ٱلنَّاسِ", "translationId": "Sembahan manusia.", "textTajweed": "إِلَ[n[ـٰ]هِ [h:14685[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"id": 6234, "surahId": 114, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 556, "isAinEnd": false, "textUthmani": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "translationId": "Dari kejahatan (bisikan) syaitan yang biasa bersembunyi,", "textTajweed": "مِ[f:14679[ن ش]َرِّ [h:14686[ٱ]لْوَسْوَاسِ [h:14687[ٱ]لْخَ[g[نّ][p[َا]سِ"}, {"id": 6235, "surahId": 114, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 556, "isAinEnd": false, "textUthmani": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "translationId": "yang membisikkan (kejahatan) ke dalam dada manusia,", "textTajweed": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ [h:14688[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"id": 6236, "surahId": 114, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 556, "isAinEnd": true, "textUthmani": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "translationId": "dari (golongan) jin dan manusia.", "textTajweed": "مِنَ [h:6531[ٱ]لْجِ[g[نّ]َةِ وَ[h:824[ٱ][l[ل][g[نّ][p[َا]سِ"}]}