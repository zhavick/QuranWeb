{"surah": {"id": 75, "nameArabic": "سُورَةُ القِيَامَةِ", "nameLatin": "Al-Qiyaama", "translationId": "Hari Berbangkit", "revelationPlace": "Makkiyah", "totalAyahs": 40}, "ayahs": [{"id": 5552, "surahId": 75, "ayahNumber": 1, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "translationId": "Aku bersumpah demi hari kiamat,", "textTajweed": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِيَوْمِ [h:14115[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"id": 5553, "surahId": 75, "ayahNumber": 2, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "translationId": "dan aku bersumpah dengan jiwa yang amat menyesali (dirinya sendiri).", "textTajweed": "وَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:3575[ٱ][l[ل][g[نّ]َفْسِ [h:14116[ٱ][l[ل]لَّوَّامَةِ"}, {"id": 5554, "surahId": 75, "ayahNumber": 3, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "translationId": "Apakah manusia mengira, bahwa Kami tidak akan mengumpulkan (kembali) tulang belulangnya?", "textTajweed": "أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أَلّ[a:14118[َن ن]َّ[q:14119[جْ]مَعَ عِظَامَهُۥ"}, {"id": 5555, "surahId": 75, "ayahNumber": 4, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "translationId": "Bukan demikian, sebenarnya Kami kuasa menyusun (kembali) jari jemarinya dengan sempurna.", "textTajweed": "بَلَىٰ قَ[n[ـٰ]دِرِينَ عَلَ[o[ىٰٓ] أ[a:14120[َن ن]ُّسَوِّىَ بَنَانَهُۥ"}, {"id": 5556, "surahId": 75, "ayahNumber": 5, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "translationId": "Bahkan manusia itu hendak membuat maksiat terus menerus.", "textTajweed": "بَلْ يُرِيدُ [h:14121[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ لِيَفْجُرَ أَمَامَهُۥ"}, {"id": 5557, "surahId": 75, "ayahNumber": 6, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "translationId": "Ia berkata: \"Bilakah hari kiamat itu?\"", "textTajweed": "يَسْــَٔلُ أَيَّانَ يَوْمُ [h:14122[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"id": 5558, "surahId": 75, "ayahNumber": 7, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "translationId": "Maka apabila mata terbelalak (ketakutan),", "textTajweed": "فَإِذَا بَرِقَ [h:14123[ٱ]لْبَصَرُ"}, {"id": 5559, "surahId": 75, "ayahNumber": 8, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَخَسَفَ ٱلْقَمَرُ", "translationId": "dan apabila bulan telah hilang cahayanya,", "textTajweed": "وَخَسَفَ [h:14124[ٱ]لْقَمَرُ"}, {"id": 5560, "surahId": 75, "ayahNumber": 9, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "translationId": "dan matahari dan bulan dikumpulkan,", "textTajweed": "وَجُمِعَ [h:14125[ٱ][l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ"}, {"id": 5561, "surahId": 75, "ayahNumber": 10, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "translationId": "pada hari itu manusia berkata: \"Ke mana tempat berlari?\"", "textTajweed": "يَقُولُ [h:14126[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِذٍ أَيْنَ [h:14127[ٱ]لْمَفَرُّ"}, {"id": 5562, "surahId": 75, "ayahNumber": 11, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "كَلَّا لَا وَزَرَ", "translationId": "sekali-kali tidak! Tidak ada tempat berlindung!", "textTajweed": "كَلَّا لَا وَزَرَ"}, {"id": 5563, "surahId": 75, "ayahNumber": 12, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "translationId": "Hanya kepada Tuhanmu sajalah pada hari itu tempat kembali.", "textTajweed": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14128[ٱ]لْمُسْتَقَرُّ"}, {"id": 5564, "surahId": 75, "ayahNumber": 13, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "translationId": "Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya.", "textTajweed": "يُنَبَّؤُ[s[اْ] [h:14129[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِ[i:14130[ذِۭ ب]ِمَا قَدَّمَ وَأَخَّرَ"}, {"id": 5565, "surahId": 75, "ayahNumber": 14, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "translationId": "Bahkan manusia itu menjadi saksi atas dirinya sendiri,", "textTajweed": "بَلِ [h:14131[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ عَلَىٰ نَفْسِه[n[ِۦ] بَصِيرَةٌ"}, {"id": 5566, "surahId": 75, "ayahNumber": 15, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "translationId": "meskipun dia mengemukakan alasan-alasannya.", "textTajweed": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"}, {"id": 5567, "surahId": 75, "ayahNumber": 16, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "translationId": "Janganlah kamu gerakkan lidahmu untuk (membaca) Al Quran karena hendak cepat-cepat (menguasai)nya.", "textTajweed": "لَا تُحَرِّكْ بِه[n[ِۦ] لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"}, {"id": 5568, "surahId": 75, "ayahNumber": 17, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "translationId": "Sesungguhnya atas tanggungan Kamilah mengumpulkannya (di dadamu) dan (membuatmu pandai) membacanya.", "textTajweed": "إِ[g[نّ]َ عَلَيْنَا جَمْعَهُ[n[ۥ] وَقُرْءَانَهُۥ"}, {"id": 5569, "surahId": 75, "ayahNumber": 18, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "translationId": "Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu.", "textTajweed": "فَإِذَا قَرَأْنَ[n[ـٰ]هُ فَ[h:14132[ٱ]تَّبِعْ قُرْءَانَهُۥ"}, {"id": 5570, "surahId": 75, "ayahNumber": 19, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "translationId": "Kemudian, sesungguhnya atas tanggungan Kamilah penjelasannya.", "textTajweed": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا بَيَانَهُۥ"}, {"id": 5571, "surahId": 75, "ayahNumber": 20, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "translationId": "Sekali-kali janganlah demikian. Sebenarnya kamu (hai manusia) mencintai kehidupan dunia,", "textTajweed": "كَلَّا بَلْ تُحِبُّونَ [h:14133[ٱ]لْعَاجِلَةَ"}, {"id": 5572, "surahId": 75, "ayahNumber": 21, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "translationId": "dan meninggalkan (kehidupan) akhirat.", "textTajweed": "وَتَذَرُونَ [h:14134[ٱ]لْأَخِرَةَ"}, {"id": 5573, "surahId": 75, "ayahNumber": 22, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "translationId": "Wajah-wajah (orang-orang mukmin) pada hari itu berseri-seri.", "textTajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14136[ذٍ ن]َّاضِرَةٌ"}, {"id": 5574, "surahId": 75, "ayahNumber": 23, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "translationId": "Kepada Tuhannyalah mereka melihat.", "textTajweed": "إِلَىٰ رَبِّهَا نَاظِرَةٌ"}, {"id": 5575, "surahId": 75, "ayahNumber": 24, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "translationId": "Dan wajah-wajah (orang kafir) pada hari itu muram,", "textTajweed": "وَوُجُو[a:14137[هٌ ي]َوْمَئِ[i:14138[ذِۭ ب]َاسِرَةٌ"}, {"id": 5576, "surahId": 75, "ayahNumber": 25, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "translationId": "mereka yakin bahwa akan ditimpakan kepadanya malapetaka yang amat dahsyat.", "textTajweed": "تَظُ[g[نّ]ُ أ[a:14139[َن ي]ُفْعَلَ بِهَا فَاقِرَةٌ"}, {"id": 5577, "surahId": 75, "ayahNumber": 26, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "translationId": "Sekali-kali jangan. Apabila nafas (seseorang) telah (mendesak) sampai ke kerongkongan,", "textTajweed": "كَلّ[o[َآ] إِذَا بَلَغَتِ [h:14140[ٱ][l[ل]تَّرَاقِىَ"}, {"id": 5578, "surahId": 75, "ayahNumber": 27, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "translationId": "dan dikatakan (kepadanya): \"Siapakah yang dapat menyembuhkan?\",", "textTajweed": "وَقِيلَ م[u:14141[َنْۜ ر][p[َا][q[ق]ٍ"}, {"id": 5579, "surahId": 75, "ayahNumber": 28, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "translationId": "dan dia yakin bahwa sesungguhnya itulah waktu perpisahan (dengan dunia),", "textTajweed": "وَظَ[g[نّ]َ أَ[g[نّ]َهُ [h:14142[ٱ]لْفِر[p[َا][q[ق]ُ"}, {"id": 5580, "surahId": 75, "ayahNumber": 29, "juzNumber": 29, "ainNumber": 512, "isAinEnd": false, "textUthmani": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "translationId": "dan bertaut betis (kiri) dan betis (kanan),", "textTajweed": "وَ[h:9999[ٱ]لْتَفَّتِ [h:14143[ٱ][l[ل]سَّاقُ بِ[h:14144[ٱ][l[ل]سّ[p[َا][q[ق]ِ"}, {"id": 5581, "surahId": 75, "ayahNumber": 30, "juzNumber": 29, "ainNumber": 512, "isAinEnd": true, "textUthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "translationId": "kepada Tuhanmulah pada hari itu kamu dihalau.", "textTajweed": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14145[ٱ]لْمَس[p[َا][q[ق]ُ"}, {"id": 5582, "surahId": 75, "ayahNumber": 31, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "translationId": "Dan ia tidak mau membenarkan (Rasul dan Al Quran) dan tidak mau mengerjakan shalat,", "textTajweed": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"}, {"id": 5583, "surahId": 75, "ayahNumber": 32, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "translationId": "tetapi ia mendustakan (Rasul) dam berpaling (dari kebenaran),", "textTajweed": "وَلَ[n[ـٰ]كِ[f:14146[ن ك]َذَّبَ وَتَوَلَّىٰ"}, {"id": 5584, "surahId": 75, "ayahNumber": 33, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "translationId": "kemudian ia pergi kepada ahlinya dengan berlagak (sombong).", "textTajweed": "ثُ[g[مّ]َ ذَهَبَ إِلَ[o[ىٰٓ] أَهْلِه[n[ِۦ] يَتَمَطَّىٰٓ"}, {"id": 5585, "surahId": 75, "ayahNumber": 34, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "translationId": "Kecelakaanlah bagimu (hai orang kafir) dan kecelakaanlah bagimu,", "textTajweed": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"}, {"id": 5586, "surahId": 75, "ayahNumber": 35, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "translationId": "kemudian kecelakaanlah bagimu (hai orang kafir) dan kecelakaanlah bagimu.", "textTajweed": "ثُ[g[مّ]َ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"}, {"id": 5587, "surahId": 75, "ayahNumber": 36, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "translationId": "Apakah manusia mengira, bahwa ia akan dibiarkan begitu saja (tanpa pertanggung jawaban)?", "textTajweed": "أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أ[a:14147[َن ي]ُتْرَكَ سُدًى"}, {"id": 5588, "surahId": 75, "ayahNumber": 37, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "translationId": "Bukankah dia dahulu setetes mani yang ditumpahkan (ke dalam rahim),", "textTajweed": "أَلَمْ يَكُ نُ[q:9146[طْ]فَ[a:14148[ةً م]ّ[a:14149[ِن م]َّنِ[a:14150[ىٍّ ي]ُمْنَىٰ"}, {"id": 5589, "surahId": 75, "ayahNumber": 38, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "translationId": "kemudian mani itu menjadi segumpal darah, lalu Allah menciptakannya, dan menyempurnakannya,", "textTajweed": "ثُ[g[مّ]َ كَانَ عَلَقَ[f:14151[ةً ف]َخَلَقَ فَسَوَّىٰ"}, {"id": 5590, "surahId": 75, "ayahNumber": 39, "juzNumber": 29, "ainNumber": 513, "isAinEnd": false, "textUthmani": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "translationId": "lalu Allah menjadikan daripadanya sepasang: laki-laki dan perempuan.", "textTajweed": "فَجَعَلَ مِنْهُ [h:14152[ٱ][l[ل]زَّوْجَيْنِ [h:13018[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"}, {"id": 5591, "surahId": 75, "ayahNumber": 40, "juzNumber": 29, "ainNumber": 513, "isAinEnd": true, "textUthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "translationId": "Bukankah (Allah yang berbuat) demikian berkuasa (pula) menghidupkan orang mati?", "textTajweed": "أَلَيْسَ ذ[n[َٲ]لِكَ بِقَ[n[ـٰ]دِرٍ عَلَ[o[ىٰٓ] أ[a:12519[َن ي]ُحْــِۧىَ [h:12520[ٱ]لْمَوْتَىٰ"}]}