{"surah": {"id": 90, "nameArabic": "سُورَةُ البَلَدِ", "nameLatin": "Al-Balad", "translationId": "Negeri", "revelationPlace": "Makkiyah", "totalAyahs": 20}, "ayahs": [{"id": 6024, "surahId": 90, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ", "translationId": "Aku benar-benar bersumpah dengan kota ini (Mekah),", "textTajweed": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"id": 6025, "surahId": 90, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ", "translationId": "dan kamu (Muhammad) bertempat di kota Mekah ini,", "textTajweed": "وَأَ[f:3893[نت]َ حِل[i:14501[ُّۢ ب]ِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"id": 6026, "surahId": 90, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَوَالِدٍۢ وَمَا وَلَدَ", "translationId": "dan demi bapak dan anaknya.", "textTajweed": "وَوَالِ[a:14502[دٍ و]َمَا وَلَ[q[د]َ"}, {"id": 6027, "surahId": 90, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ", "translationId": "Sesungguhnya Kami telah menciptakan manusia berada dalam susah payah.", "textTajweed": "لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ فِى كَبَ[q[د]ٍ"}, {"id": 6028, "surahId": 90, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ", "translationId": "Apakah manusia itu menyangka bahwa sekali-kali tiada seorangpun yang berkuasa atasnya?", "textTajweed": "أَيَحْسَبُ أ[u:8842[َن ل]ّ[a:14503[َن ي]َ[q:14504[قْ]دِرَ عَلَيْهِ أَحَ[q[د]ٌ"}, {"id": 6029, "surahId": 90, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا", "translationId": "Dan mengatakan: \"Aku telah menghabiskan harta yang banyak\".", "textTajweed": "يَقُولُ أَهْلَكْتُ مَال[u:14505[اً ل]ُّبَدًا"}, {"id": 6030, "surahId": 90, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ", "translationId": "Apakah dia menyangka bahwa tiada seorangpun yang melihatnya?", "textTajweed": "أَيَحْسَبُ أ[u:4423[َن ل]َّمْ يَرَهُ[o[ۥٓ] أَحَ[q[د]ٌ"}, {"id": 6031, "surahId": 90, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "translationId": "Bukankah Kami telah memberikan kepadanya dua buah mata,", "textTajweed": "أَلَمْ نَ[q:8219[جْ]عَل لَّهُ[n[ۥ] عَيْنَ[p[يْ]نِ"}, {"id": 6032, "surahId": 90, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَلِسَانًۭا وَشَفَتَيْنِ", "translationId": "lidah dan dua buah bibir.", "textTajweed": "وَلِسَا[a:14506[نًا و]َشَفَتَ[p[يْ]نِ"}, {"id": 6033, "surahId": 90, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ", "translationId": "Dan Kami telah menunjukkan kepadanya dua jalan,", "textTajweed": "وَهَدَيْنَ[n[ـٰ]هُ [h:14507[ٱ][l[ل][g[نّ]َ[q:14508[جْ]دَ[p[يْ]نِ"}, {"id": 6034, "surahId": 90, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ", "translationId": "Tetapi dia tiada menempuh jalan yang mendaki lagi sukar.", "textTajweed": "فَلَا [h:14509[ٱ][q:14510[قْ]تَحَمَ [h:14511[ٱ]لْعَقَبَةَ"}, {"id": 6035, "surahId": 90, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ", "translationId": "Tahukah kamu apakah jalan yang mendaki lagi sukar itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14512[ٱ]لْعَقَبَةُ"}, {"id": 6036, "surahId": 90, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "فَكُّ رَقَبَةٍ", "translationId": "(yaitu) melepaskan budak dari perbudakan,", "textTajweed": "فَكُّ رَقَبَةٍ"}, {"id": 6037, "surahId": 90, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ", "translationId": "atau memberi makan pada hari kelaparan,", "textTajweed": "أَوْ إِ[q:14513[طْ]عَ[n[ـٰ][f:14514[مٌ ف]ِى يَوْ[f:14515[مٍ ذ]ِى مَسْغَبَةٍ"}, {"id": 6038, "surahId": 90, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "يَتِيمًۭا ذَا مَقْرَبَةٍ", "translationId": "(kepada) anak yatim yang ada hubungan kerabat,", "textTajweed": "يَتِي[f:14516[مًا ذ]َا مَ[q:14517[قْ]رَبَةٍ"}, {"id": 6039, "surahId": 90, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ", "translationId": "atau kepada orang miskin yang sangat fakir.", "textTajweed": "أَوْ مِسْكِي[f:14518[نًا ذ]َا مَتْرَبَةٍ"}, {"id": 6040, "surahId": 90, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ", "translationId": "Dan dia (tidak pula) termasuk orang-orang yang beriman dan saling berpesan untuk bersabar dan saling berpesan untuk berkasih sayang.", "textTajweed": "ثُ[g[مّ]َ كَانَ مِنَ [h:523[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَتَوَاصَوْ[s[اْ] بِ[h:223[ٱ][l[ل]صَّ[q:223[بْ]رِ وَتَوَاصَوْ[s[اْ] بِ[h:14519[ٱ]لْمَرْحَمَةِ"}, {"id": 6041, "surahId": 90, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "translationId": "Mereka (orang-orang yang beriman dan saling berpesan itu) adalah golongan kanan.", "textTajweed": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"}, {"id": 6042, "surahId": 90, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 532, "isAinEnd": false, "textUthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "translationId": "Dan orang-orang yang kafir kepada ayat-ayat Kami, mereka itu adalah golongan kiri.", "textTajweed": "وَ[h:9999[ٱ]لَّذِينَ كَفَرُو[s[اْ] بِـَٔـايَ[n[ـٰ]تِنَا هُمْ أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"}, {"id": 6043, "surahId": 90, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 532, "isAinEnd": true, "textUthmani": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ", "translationId": "Mereka berada dalam neraka yang ditutup rapat.", "textTajweed": "عَلَيْهِمْ نَا[a:14520[رٌ م]ُّؤْصَدَةُۢ"}]}