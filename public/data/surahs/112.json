{"surah": {"id": 112, "nameArabic": "سُورَةُ الإِخۡلَاصِ", "nameLatin": "Al-Ikhlaas", "translationId": "Ikhlas", "revelationPlace": "Makkiyah", "totalAyahs": 4}, "ayahs": [{"id": 6222, "surahId": 112, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 554, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ", "translationId": "Katakanlah: \"Dialah Allah, Yang Maha Esa.", "textTajweed": "قُلْ هُوَ [h:8078[ٱ]للَّهُ أَحَ[q[د]ٌ"}, {"id": 6223, "surahId": 112, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 554, "isAinEnd": false, "textUthmani": "ٱللَّهُ ٱلصَّمَدُ", "translationId": "Allah adalah Tuhan yang bergantung kepada-Nya segala sesuatu.", "textTajweed": "ٱللَّهُ [h:14675[ٱ][l[ل]صَّمَ[q[د]ُ"}, {"id": 6224, "surahId": 112, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 554, "isAinEnd": false, "textUthmani": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "translationId": "Dia tiada beranak dan tidak pula diperanakkan,", "textTajweed": "لَمْ يَلِ[q:14676[دْ] وَلَمْ يُولَ[q:14677[دْ]"}, {"id": 6225, "surahId": 112, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 554, "isAinEnd": true, "textUthmani": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ", "translationId": "dan tidak ada seorangpun yang setara dengan Dia\".", "textTajweed": "وَلَمْ يَك[u:2596[ُن ل]َّهُ[n[ۥ] كُفُوًا أَحَ[q[د]ُۢ"}]}