{"surah": {"id": 100, "nameArabic": "سُورَةُ العَادِيَاتِ", "nameLatin": "Al-Aadiyaat", "translationId": "Berlari Kencang", "revelationPlace": "Makkiyah", "totalAyahs": 11}, "ayahs": [{"id": 6147, "surahId": 100, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "translationId": "Demi kuda perang yang berlari kencang dengan terengah-engah,", "textTajweed": "وَ[h:9999[ٱ]لْعَ[n[ـٰ]دِيَ[n[ـٰ]تِ ضَ[q:14611[بْ]حًا"}, {"id": 6148, "surahId": 100, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "translationId": "dan kuda yang mencetuskan api dengan pukulan (kuku kakinya),", "textTajweed": "فَ[h:9999[ٱ]لْمُورِيَ[n[ـٰ]تِ قَ[q:14612[دْ]حًا"}, {"id": 6149, "surahId": 100, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "translationId": "dan kuda yang menyerang dengan tiba-tiba di waktu pagi,", "textTajweed": "فَ[h:9999[ٱ]لْمُغِير[n[َٲ]تِ صُ[q:14613[بْ]حًا"}, {"id": 6150, "surahId": 100, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "translationId": "maka ia menerbangkan debu,", "textTajweed": "فَأَثَرْنَ بِه[n[ِۦ] نَ[q:14614[قْ]عًا"}, {"id": 6151, "surahId": 100, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا", "translationId": "dan menyerbu ke tengah-tengah kumpulan musuh,", "textTajweed": "فَوَسَ[q:14615[طْ]نَ بِه[n[ِۦ] جَمْعًا"}, {"id": 6152, "surahId": 100, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "translationId": "sesungguhnya manusia itu sangat ingkar, tidak berterima kasih kepada Tuhannya,", "textTajweed": "إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لِرَبِّه[n[ِۦ] لَكَن[p[ُو][q[د]ٌ"}, {"id": 6153, "surahId": 100, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "translationId": "dan sesungguhnya manusia itu menyaksikan (sendiri) keingkarannya,", "textTajweed": "وَإِ[g[نّ]َهُ[n[ۥ] عَلَىٰ ذ[n[َٲ]لِكَ لَشَه[p[ِي][q[د]ٌ"}, {"id": 6154, "surahId": 100, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "translationId": "dan sesungguhnya dia sangat bakhil karena cintanya kepada harta.", "textTajweed": "وَإِ[g[نّ]َهُ[n[ۥ] لِحُبِّ [h:14616[ٱ]لْخَيْرِ لَشَد[p[ِي][q[د]ٌ"}, {"id": 6155, "surahId": 100, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "translationId": "Maka apakah dia tidak mengetahui apabila dibangkitkan apa yang ada di dalam kubur,", "textTajweed": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى [h:8926[ٱ]لْقُب[p[ُو]رِ"}, {"id": 6156, "surahId": 100, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 542, "isAinEnd": false, "textUthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "translationId": "dan dilahirkan apa yang ada di dalam dada,", "textTajweed": "وَحُصِّلَ مَا فِى [h:6095[ٱ][l[ل]صُّد[p[ُو]رِ"}, {"id": 6157, "surahId": 100, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 542, "isAinEnd": true, "textUthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "translationId": "sesungguhnya Tuhan mereka pada hari itu Maha Mengetahui keadaan mereka.", "textTajweed": "إِ[g[نّ]َ رَبَّه[c:14617[ُم ب]ِهِمْ يَوْمَئِ[u:14618[ذٍ ل]َّخَب[p[ِي]رُۢ"}]}