{"surah": {"id": 88, "nameArabic": "سُورَةُ الغَاشِيَةِ", "nameLatin": "Al-Ghaashiya", "translationId": "Hari Pembalasan", "revelationPlace": "Makkiyah", "totalAyahs": 26}, "ayahs": [{"id": 5968, "surahId": 88, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "translationId": "Sudah datangkah kepadamu berita (tentang) hari pembalasan?", "textTajweed": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ"}, {"id": 5969, "surahId": 88, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "translationId": "Banyak muka pada hari itu tunduk terhina,", "textTajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ"}, {"id": 5970, "surahId": 88, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "translationId": "bekerja keras lagi kepayahan,", "textTajweed": "عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ"}, {"id": 5971, "surahId": 88, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "translationId": "memasuki api yang sangat panas (neraka),", "textTajweed": "تَصْلَىٰ نَارًا حَامِيَةً"}, {"id": 5972, "surahId": 88, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "translationId": "diberi minum (dengan air) dari sumber yang sangat panas.", "textTajweed": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"}, {"id": 5973, "surahId": 88, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "translationId": "Mereka tiada memperoleh makanan selain dari pohon yang berduri,", "textTajweed": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ"}, {"id": 5974, "surahId": 88, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "translationId": "yang tidak menggemukkan dan tidak pula menghilangkan lapar.", "textTajweed": "لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ"}, {"id": 5975, "surahId": 88, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "translationId": "Banyak muka pada hari itu berseri-seri,", "textTajweed": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ"}, {"id": 5976, "surahId": 88, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "لِّسَعْيِهَا رَاضِيَةٌۭ", "translationId": "merasa senang karena usahanya,", "textTajweed": "لِّسَعْيِهَا رَاضِيَةٌ"}, {"id": 5977, "surahId": 88, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "فِى جَنَّةٍ عَالِيَةٍۢ", "translationId": "dalam surga yang tinggi,", "textTajweed": "فِى جَ[g[نّ]َةٍ عَالِيَةٍ"}, {"id": 5978, "surahId": 88, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "translationId": "tidak kamu dengar di dalamnya perkataan yang tidak berguna.", "textTajweed": "لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً"}, {"id": 5979, "surahId": 88, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "translationId": "Di dalamnya ada mata air yang mengalir.", "textTajweed": "فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ"}, {"id": 5980, "surahId": 88, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "translationId": "Di dalamnya ada takhta-takhta yang ditinggikan,", "textTajweed": "فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ"}, {"id": 5981, "surahId": 88, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "translationId": "dan gelas-gelas yang terletak (di dekatnya),", "textTajweed": "وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ"}, {"id": 5982, "surahId": 88, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "translationId": "dan bantal-bantal sandaran yang tersusun,", "textTajweed": "وَنَمَارِقُ مَصْفُوفَةٌ"}, {"id": 5983, "surahId": 88, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ", "translationId": "dan permadani-permadani yang terhampar.", "textTajweed": "وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ"}, {"id": 5984, "surahId": 88, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "translationId": "Maka apakah mereka tidak memperhatikan unta bagaimana dia diciptakan,", "textTajweed": "أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ"}, {"id": 5985, "surahId": 88, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "translationId": "Dan langit, bagaimana ia ditinggikan?", "textTajweed": "وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ"}, {"id": 5986, "surahId": 88, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "translationId": "Dan gunung-gunung bagaimana ia ditegakkan?", "textTajweed": "وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ"}, {"id": 5987, "surahId": 88, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "translationId": "Dan bumi bagaimana ia dihamparkan?", "textTajweed": "وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ"}, {"id": 5988, "surahId": 88, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "translationId": "Maka berilah peringatan, karena sesungguhnya kamu hanyalah orang yang memberi peringatan.", "textTajweed": "فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ"}, {"id": 5989, "surahId": 88, "ayahNumber": 22, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "translationId": "Kamu bukanlah orang yang berkuasa atas mereka,", "textTajweed": "لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ"}, {"id": 5990, "surahId": 88, "ayahNumber": 23, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "translationId": "tetapi orang yang berpaling dan kafir,", "textTajweed": "إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ"}, {"id": 5991, "surahId": 88, "ayahNumber": 24, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "translationId": "maka Allah akan mengazabnya dengan azab yang besar.", "textTajweed": "فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ"}, {"id": 5992, "surahId": 88, "ayahNumber": 25, "juzNumber": 30, "ainNumber": 530, "isAinEnd": false, "textUthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "translationId": "Sesungguhnya kepada Kami-lah kembali mereka,", "textTajweed": "إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ"}, {"id": 5993, "surahId": 88, "ayahNumber": 26, "juzNumber": 30, "ainNumber": 530, "isAinEnd": true, "textUthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "translationId": "kemudian sesungguhnya kewajiban Kami-lah menghisab mereka.", "textTajweed": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم"}]}