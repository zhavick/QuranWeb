{"surah": {"id": 56, "nameArabic": "سُورَةُ الوَاقِعَةِ", "nameLatin": "Al-Waaqia", "translationId": "Hari Kiamat", "revelationPlace": "Makkiyah", "totalAyahs": 96}, "ayahs": [{"id": 4980, "surahId": 56, "ayahNumber": 1, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ", "translationId": "Apabila terjadi hari kiamat,", "textTajweed": "إِذَا وَقَعَتِ [h:13200[ٱ]لْوَاقِعَةُ"}, {"id": 4981, "surahId": 56, "ayahNumber": 2, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ", "translationId": "tidak seorangpun dapat berdusta tentang kejadiannya.", "textTajweed": "لَيْسَ لِوَ[q:13201[قْ]عَتِهَا كَاذِبَةٌ"}, {"id": 4982, "surahId": 56, "ayahNumber": 3, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "خَافِضَةٌۭ رَّافِعَةٌ", "translationId": "(Kejadian itu) merendahkan (satu golongan) dan meninggikan (golongan yang lain),", "textTajweed": "خَافِضَ[u:13202[ةٌ ر]َّافِعَةٌ"}, {"id": 4983, "surahId": 56, "ayahNumber": 4, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا", "translationId": "apabila bumi digoncangkan sedahsyat-dahsyatnya,", "textTajweed": "إِذَا رُجَّتِ [h:13203[ٱ]لْأَرْضُ رَجًّا"}, {"id": 4984, "surahId": 56, "ayahNumber": 5, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا", "translationId": "dan gunung-gunung dihancur luluhkan seluluh-luluhnya,", "textTajweed": "وَبُسَّتِ [h:13204[ٱ]لْجِبَالُ بَسًّا"}, {"id": 4985, "surahId": 56, "ayahNumber": 6, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا", "translationId": "maka jadilah ia debu yang beterbangan,", "textTajweed": "فَكَانَتْ هَب[o[َا]ٓ[a:13205[ءً م]ُّ[i:13206[نۢب]َثًّا"}, {"id": 4986, "surahId": 56, "ayahNumber": 7, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ", "translationId": "dan kamu menjadi tiga golongan.", "textTajweed": "وَكُ[f:151[نت]ُمْ أَزْو[n[َٲ][f:13207[جًا ث]َلَ[n[ـٰ]ثَةً"}, {"id": 4987, "surahId": 56, "ayahNumber": 8, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "translationId": "Yaitu golongan kanan. Alangkah mulianya golongan kanan itu.", "textTajweed": "فَأَصْحَ[n[ـٰ]بُ [h:13208[ٱ]لْمَيْمَنَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"}, {"id": 4988, "surahId": 56, "ayahNumber": 9, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "translationId": "Dan golongan kiri. Alangkah sengsaranya golongan kiri itu.", "textTajweed": "وَأَصْحَ[n[ـٰ]بُ [h:13210[ٱ]لْمَشْــَٔمَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"}, {"id": 4989, "surahId": 56, "ayahNumber": 10, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ", "translationId": "Dan orang-orang yang beriman paling dahulu,", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِقُونَ [h:13212[ٱ][l[ل]سَّ[n[ـٰ]بِق[p[ُو]نَ"}, {"id": 4990, "surahId": 56, "ayahNumber": 11, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ", "translationId": "Mereka itulah yang didekatkan kepada Allah.", "textTajweed": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ [h:13213[ٱ]لْمُقَرَّب[p[ُو]نَ"}, {"id": 4991, "surahId": 56, "ayahNumber": 12, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ", "translationId": "Berada dalam jannah kenikmatan.", "textTajweed": "فِى جَ[g[نّ]َ[n[ـٰ]تِ [h:3680[ٱ][l[ل][g[نّ]َع[p[ِي]مِ"}, {"id": 4992, "surahId": 56, "ayahNumber": 13, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "translationId": "Segolongan besar dari orang-orang yang terdahulu,", "textTajweed": "ثُلَّ[a:13214[ةٌ م]ِّنَ [h:11455[ٱ]لْأَوَّل[p[ِي]نَ"}, {"id": 4993, "surahId": 56, "ayahNumber": 14, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ", "translationId": "dan segolongan kecil dari orang-orang yang kemudian", "textTajweed": "وَقَلِي[a:13215[لٌ م]ِّنَ [h:13216[ٱ]لْأَخِر[p[ِي]نَ"}, {"id": 4994, "surahId": 56, "ayahNumber": 15, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ", "translationId": "Mereka berada di atas dipan yang bertahta emas dan permata,", "textTajweed": "عَلَىٰ سُرُ[a:13217[رٍ م]َّوْضُونَةٍ"}, {"id": 4995, "surahId": 56, "ayahNumber": 16, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ", "translationId": "seraya bertelekan di atasnya berhadap-hadapan.", "textTajweed": "مُّتَّكِــِٔينَ عَلَيْهَا مُتَقَ[n[ـٰ]بِل[p[ِي]نَ"}, {"id": 4996, "surahId": 56, "ayahNumber": 17, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ", "translationId": "Mereka dikelilingi oleh anak-anak muda yang tetap muda,", "textTajweed": "يَطُوفُ عَلَيْهِمْ وِلْد[n[َٲ][a:13218[نٌ م]ُّخَلَّد[p[ُو]نَ"}, {"id": 4997, "surahId": 56, "ayahNumber": 18, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ", "translationId": "dengan membawa gelas, cerek dan minuman yang diambil dari air yang mengalir,", "textTajweed": "بِأَكْوَا[a:13219[بٍ و]َأَبَارِيقَ وَكَأْ[a:13220[سٍ م]ّ[a:11360[ِن م]َّع[p[ِي]نٍ"}, {"id": 4998, "surahId": 56, "ayahNumber": 19, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ", "translationId": "mereka tidak pening karenanya dan tidak pula mabuk,", "textTajweed": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُ[f:13221[نز]ِف[p[ُو]نَ"}, {"id": 4999, "surahId": 56, "ayahNumber": 20, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ", "translationId": "dan buah-buahan dari apa yang mereka pilih,", "textTajweed": "وَفَ[n[ـٰ]كِهَ[a:13222[ةٍ م]ِّ[g[مّ]َا يَتَخَيَّر[p[ُو]نَ"}, {"id": 5000, "surahId": 56, "ayahNumber": 21, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ", "translationId": "dan daging burung dari apa yang mereka inginkan.", "textTajweed": "وَلَحْمِ طَيْ[a:13223[رٍ م]ِّ[g[مّ]َا يَشْتَه[p[ُو]نَ"}, {"id": 5001, "surahId": 56, "ayahNumber": 22, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَحُورٌ عِينٌۭ", "translationId": "Dan ada bidadari-bidadari bermata jeli,", "textTajweed": "وَحُورٌ ع[p[ِي]نٌ"}, {"id": 5002, "surahId": 56, "ayahNumber": 23, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ", "translationId": "laksana mutiara yang tersimpan baik.", "textTajweed": "كَأَمْثَ[n[ـٰ]لِ [h:13224[ٱ][l[ل]لُّؤْلُوِٕ [h:13225[ٱ]لْمَكْن[p[ُو]نِ"}, {"id": 5003, "surahId": 56, "ayahNumber": 24, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ", "translationId": "Sebagai balasan bagi apa yang telah mereka kerjakan.", "textTajweed": "جَز[o[َا]ٓ[i:3537[ءَۢ ب]ِمَا كَانُو[s[اْ] يَعْمَل[p[ُو]نَ"}, {"id": 5004, "surahId": 56, "ayahNumber": 25, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا", "translationId": "Mereka tidak mendengar di dalamnya perkataan yang sia-sia dan tidak pula perkataan yang menimbulkan dosa,", "textTajweed": "لَا يَسْمَعُونَ فِيهَا لَغْ[a:13226[وًا و]َلَا تَأْثِيمًا"}, {"id": 5005, "surahId": 56, "ayahNumber": 26, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا", "translationId": "akan tetapi mereka mendengar ucapan salam.", "textTajweed": "إِلَّا قِيل[f:13227[اً س]َلَ[n[ـٰ][f:13228[مًا س]َلَ[n[ـٰ]مًا"}, {"id": 5006, "surahId": 56, "ayahNumber": 27, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ", "translationId": "Dan golongan kanan, alangkah bahagianya golongan kanan itu.", "textTajweed": "وَأَصْحَ[n[ـٰ]بُ [h:13229[ٱ]لْيَمِينِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13230[ٱ]لْيَم[p[ِي]نِ"}, {"id": 5007, "surahId": 56, "ayahNumber": 28, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "فِى سِدْرٍۢ مَّخْضُودٍۢ", "translationId": "Berada di antara pohon bidara yang tak berduri,", "textTajweed": "فِى سِ[q:10979[دْ][a:13231[رٍ م]َّخْض[p[ُو][q[د]ٍ"}, {"id": 5008, "surahId": 56, "ayahNumber": 29, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَطَلْحٍۢ مَّنضُودٍۢ", "translationId": "dan pohon pisang yang bersusun-susun (buahnya),", "textTajweed": "وَطَلْ[a:13232[حٍ م]َّ[f:6447[نض][p[ُو][q[د]ٍ"}, {"id": 5009, "surahId": 56, "ayahNumber": 30, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَظِلٍّۢ مَّمْدُودٍۢ", "translationId": "dan naungan yang terbentang luas,", "textTajweed": "وَظِ[a:13233[لٍّ م]َّمْد[p[ُو][q[د]ٍ"}, {"id": 5010, "surahId": 56, "ayahNumber": 31, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَمَآءٍۢ مَّسْكُوبٍۢ", "translationId": "dan air yang tercurah,", "textTajweed": "وَم[o[َا]ٓ[a:13234[ءٍ م]َّسْك[p[ُو][q[ب]ٍ"}, {"id": 5011, "surahId": 56, "ayahNumber": 32, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ", "translationId": "dan buah-buahan yang banyak,", "textTajweed": "وَفَ[n[ـٰ]كِهَ[f:13235[ةٍ ك]َثِيرَةٍ"}, {"id": 5012, "surahId": 56, "ayahNumber": 33, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ", "translationId": "yang tidak berhenti (berbuah) dan tidak terlarang mengambilnya.", "textTajweed": "لَّا مَ[q:13236[قْ]طُوعَ[a:13237[ةٍ و]َلَا مَمْنُوعَةٍ"}, {"id": 5013, "surahId": 56, "ayahNumber": 34, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "وَفُرُشٍۢ مَّرْفُوعَةٍ", "translationId": "dan kasur-kasur yang tebal lagi empuk.", "textTajweed": "وَفُرُ[a:13238[شٍ م]َّرْفُوعَةٍ"}, {"id": 5014, "surahId": 56, "ayahNumber": 35, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ", "translationId": "Sesungguhnya Kami menciptakan mereka (bidadari-bidadari) dengan langsung", "textTajweed": "إِ[g[نّ][o[َآ] أَ[f:13239[نش]َأْنَ[n[ـٰ]هُ[g[نّ]َ إِ[f:13240[نش][o[َا]ٓءً"}, {"id": 5015, "surahId": 56, "ayahNumber": 36, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "فَجَعَلْنَٰهُنَّ أَبْكَارًا", "translationId": "dan Kami jadikan mereka gadis-gadis perawan.", "textTajweed": "فَجَعَلْنَ[n[ـٰ]هُ[g[نّ]َ أَ[q:13241[بْ]كَارًا"}, {"id": 5016, "surahId": 56, "ayahNumber": 37, "juzNumber": 27, "ainNumber": 469, "isAinEnd": false, "textUthmani": "عُرُبًا أَتْرَابًۭا", "translationId": "penuh cinta lagi sebaya umurnya.", "textTajweed": "عُرُبًا أَتْرَابًا"}, {"id": 5017, "surahId": 56, "ayahNumber": 38, "juzNumber": 27, "ainNumber": 469, "isAinEnd": true, "textUthmani": "لِّأَصْحَٰبِ ٱلْيَمِينِ", "translationId": "(Kami ciptakan mereka) untuk golongan kanan,", "textTajweed": "لِّأَصْحَ[n[ـٰ]بِ [h:13242[ٱ]لْيَم[p[ِي]نِ"}, {"id": 5018, "surahId": 56, "ayahNumber": 39, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "translationId": "(yaitu) segolongan besar dari orang-orang yang terdahulu.", "textTajweed": "ثُلَّ[a:13214[ةٌ م]ِّنَ [h:11455[ٱ]لْأَوَّل[p[ِي]نَ"}, {"id": 5019, "surahId": 56, "ayahNumber": 40, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ", "translationId": "dan segolongan besar pula dari orang-orang yang kemudian.", "textTajweed": "وَثُلَّ[a:13243[ةٌ م]ِّنَ [h:13216[ٱ]لْأَخِر[p[ِي]نَ"}, {"id": 5020, "surahId": 56, "ayahNumber": 41, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ", "translationId": "Dan golongan kiri, siapakah golongan kiri itu?", "textTajweed": "وَأَصْحَ[n[ـٰ]بُ [h:13244[ٱ][l[ل]شِّمَالِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13245[ٱ][l[ل]شِّم[p[َا]لِ"}, {"id": 5021, "surahId": 56, "ayahNumber": 42, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "فِى سَمُومٍۢ وَحَمِيمٍۢ", "translationId": "Dalam (siksaan) angin yang amat panas, dan air panas yang mendidih,", "textTajweed": "فِى سَمُو[a:13246[مٍ و]َحَم[p[ِي]مٍ"}, {"id": 5022, "surahId": 56, "ayahNumber": 43, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَظِلٍّۢ مِّن يَحْمُومٍۢ", "translationId": "dan dalam naungan asap yang hitam.", "textTajweed": "وَظِ[a:13247[لٍّ م]ّ[a:13248[ِن ي]َحْم[p[ُو]مٍ"}, {"id": 5023, "surahId": 56, "ayahNumber": 44, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ", "translationId": "Tidak sejuk dan tidak menyenangkan.", "textTajweed": "لَّا بَارِ[a:13249[دٍ و]َلَا كَر[p[ِي]مٍ"}, {"id": 5024, "surahId": 56, "ayahNumber": 45, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ", "translationId": "Sesungguhnya mereka sebelum itu hidup bermewahan.", "textTajweed": "إِ[g[نّ]َهُمْ كَانُو[s[اْ] قَ[q:3282[بْ]لَ ذ[n[َٲ]لِكَ مُتْرَف[p[ِي]نَ"}, {"id": 5025, "surahId": 56, "ayahNumber": 46, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ", "translationId": "Dan mereka terus-menerus mengerjakan dosa besar.", "textTajweed": "وَكَانُو[s[اْ] يُصِرُّونَ عَلَى [h:13250[ٱ]لْحِ[f:13251[نث]ِ [h:13252[ٱ]لْعَظ[p[ِي]مِ"}, {"id": 5026, "surahId": 56, "ayahNumber": 47, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "translationId": "Dan mereka selalu mengatakan: \"Apakah bila kami mati dan menjadi tanah dan tulang belulang, apakah sesungguhnya kami akan benar-benar dibangkitkan kembali?", "textTajweed": "وَكَانُو[s[اْ] يَقُولُونَ أَئِذَا مِتْنَا وَكُ[g[نّ]َا تُرَا[a:9207[بًا و]َعِظَ[n[ـٰ]مًا أَءِ[g[نّ]َا لَمَ[q:7784[بْ]عُوث[p[ُو]نَ"}, {"id": 5027, "surahId": 56, "ayahNumber": 48, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "translationId": "apakah bapak-bapak kami yang terdahulu (juga)?\"", "textTajweed": "أَوَءَاب[o[َا]ٓؤُنَا [h:11331[ٱ]لْأَوَّل[p[ُو]نَ"}, {"id": 5028, "surahId": 56, "ayahNumber": 49, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ", "translationId": "Katakanlah: \"Sesungguhnya orang-orang yang terdahulu dan orang-orang yang terkemudian,", "textTajweed": "قُلْ إِ[g[نّ]َ [h:13253[ٱ]لْأَوَّلِينَ وَ[h:13254[ٱ]لْأَخِر[p[ِي]نَ"}, {"id": 5029, "surahId": 56, "ayahNumber": 50, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ", "translationId": "benar-benar akan dikumpulkan di waktu tertentu pada hari yang dikenal.", "textTajweed": "لَمَ[q:13255[جْ]مُوعُونَ إِلَىٰ مِيقَ[n[ـٰ]تِ يَوْ[a:9746[مٍ م]َّعْل[p[ُو]مٍ"}, {"id": 5030, "surahId": 56, "ayahNumber": 51, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ", "translationId": "Kemudian sesungguhnya kamu hai orang-orang yang sesat lagi mendustakan,", "textTajweed": "ثُ[g[مّ]َ إِ[g[نّ]َكُمْ أَيُّهَا [h:13256[ٱ][l[ل]ضّ[m[َا]ٓلُّونَ [h:13257[ٱ]لْمُكَذِّب[p[ُو]نَ"}, {"id": 5031, "surahId": 56, "ayahNumber": 52, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ", "translationId": "benar-benar akan memakan pohon zaqqum,", "textTajweed": "لَأَكِلُونَ مِ[f:13258[ن ش]َجَ[a:13259[رٍ م]ِّ[f:13260[ن ز]َقّ[p[ُو]مٍ"}, {"id": 5032, "surahId": 56, "ayahNumber": 53, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ", "translationId": "dan akan memenuhi perutmu dengannya.", "textTajweed": "فَمَالِــُٔونَ مِنْهَا [h:11382[ٱ]لْبُط[p[ُو]نَ"}, {"id": 5033, "surahId": 56, "ayahNumber": 54, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ", "translationId": "Sesudah itu kamu akan meminum air yang sangat panas.", "textTajweed": "فَشَ[n[ـٰ]رِبُونَ عَلَيْهِ مِنَ [h:13261[ٱ]لْحَم[p[ِي]مِ"}, {"id": 5034, "surahId": 56, "ayahNumber": 55, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ", "translationId": "Maka kamu minum seperti unta yang sangat haus minum.", "textTajweed": "فَشَ[n[ـٰ]رِبُونَ شُرْبَ [h:13262[ٱ]لْه[p[ِي]مِ"}, {"id": 5035, "surahId": 56, "ayahNumber": 56, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ", "translationId": "Itulah hidangan untuk mereka pada hari Pembalasan\".", "textTajweed": "هَ[n[ـٰ]ذَا نُزُلُهُمْ يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ"}, {"id": 5036, "surahId": 56, "ayahNumber": 57, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ", "translationId": "Kami telah menciptakan kamu, maka mengapa kamu tidak membenarkan?", "textTajweed": "نَحْنُ خَلَ[q:4250[قْ]نَ[n[ـٰ]كُمْ فَلَوْلَا تُصَدِّق[p[ُو]نَ"}, {"id": 5037, "surahId": 56, "ayahNumber": 58, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "أَفَرَءَيْتُم مَّا تُمْنُونَ", "translationId": "Maka terangkanlah kepadaku tentang nutfah yang kamu pancarkan.", "textTajweed": "أَفَرَءَيْت[w:9776[ُم م]َّا تُمْن[p[ُو]نَ"}, {"id": 5038, "surahId": 56, "ayahNumber": 59, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ", "translationId": "Kamukah yang menciptakannya, atau Kamikah yang menciptakannya?", "textTajweed": "ءَأَ[f:716[نت]ُمْ تَخْلُقُونَهُ[o[ۥٓ] أَمْ نَحْنُ [h:13263[ٱ]لْخَ[n[ـٰ]لِق[p[ُو]نَ"}, {"id": 5039, "surahId": 56, "ayahNumber": 60, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ", "translationId": "Kami telah menentukan kematian di antara kamu dan Kami sekali-sekali tidak akan dapat dikalahkan,", "textTajweed": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ [h:13264[ٱ]لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوق[p[ِي]نَ"}, {"id": 5040, "surahId": 56, "ayahNumber": 61, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ", "translationId": "untuk menggantikan kamu dengan orang-orang yang seperti kamu (dalam dunia) dan menciptakan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui.", "textTajweed": "عَلَ[o[ىٰٓ] أ[a:13265[َن ن]ُّبَدِّلَ أَمْثَ[n[ـٰ]لَكُمْ وَنُ[f:13266[نش]ِئَكُمْ فِى مَا لَا تَعْلَم[p[ُو]نَ"}, {"id": 5041, "surahId": 56, "ayahNumber": 62, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ", "translationId": "Dan Sesungguhnya kamu telah mengetahui penciptaan yang pertama, maka mengapakah kamu tidak mengambil pelajaran (untuk penciptaan yang kedua)?", "textTajweed": "وَلَقَ[q:341[دْ] عَلِمْتُمُ [h:13267[ٱ][l[ل][g[نّ]َشْأَةَ [h:13268[ٱ]لْأُولَىٰ فَلَوْلَا تَذَكَّر[p[ُو]نَ"}, {"id": 5042, "surahId": 56, "ayahNumber": 63, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ", "translationId": "Maka terangkanlah kepadaku tentang yang kamu tanam.", "textTajweed": "أَفَرَءَيْت[w:9776[ُم م]َّا تَحْرُث[p[ُو]نَ"}, {"id": 5043, "surahId": 56, "ayahNumber": 64, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ", "translationId": "Kamukah yang menumbuhkannya atau Kamikah yang menumbuhkannya?", "textTajweed": "ءَأَ[f:716[نت]ُمْ تَزْرَعُونَهُ[o[ۥٓ] أَمْ نَحْنُ [h:13269[ٱ][l[ل]زّ[n[َٲ]رِع[p[ُو]نَ"}, {"id": 5044, "surahId": 56, "ayahNumber": 65, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ", "translationId": "Kalau Kami kehendaki, benar-benar Kami jadikan dia hancur dan kering, maka jadilah kamu heran dan tercengang.", "textTajweed": "لَوْ نَش[o[َا]ٓءُ لَجَعَلْنَ[n[ـٰ]هُ حُطَ[n[ـٰ][f:13270[مًا ف]َظَلْتُمْ تَفَكَّه[p[ُو]نَ"}, {"id": 5045, "surahId": 56, "ayahNumber": 66, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "إِنَّا لَمُغْرَمُونَ", "translationId": "(Sambil berkata): \"Sesungguhnya kami benar-benar menderita kerugian\",", "textTajweed": "إِ[g[نّ]َا لَمُغْرَم[p[ُو]نَ"}, {"id": 5046, "surahId": 56, "ayahNumber": 67, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "بَلْ نَحْنُ مَحْرُومُونَ", "translationId": "bahkan kami menjadi orang-orang yang tidak mendapat hasil apa-apa.", "textTajweed": "بَلْ نَحْنُ مَحْرُوم[p[ُو]نَ"}, {"id": 5047, "surahId": 56, "ayahNumber": 68, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ", "translationId": "Maka terangkanlah kepadaku tentang air yang kamu minum.", "textTajweed": "أَفَرَءَيْتُمُ [h:13271[ٱ]لْم[o[َا]ٓءَ [h:13272[ٱ]لَّذِى تَشْرَب[p[ُو]نَ"}, {"id": 5048, "surahId": 56, "ayahNumber": 69, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ", "translationId": "Kamukah yang menurunkannya atau Kamikah yang menurunkannya?", "textTajweed": "ءَأَ[f:716[نت]ُمْ أَ[f:13273[نز]َلْتُمُوهُ مِنَ [h:13274[ٱ]لْمُزْنِ أَمْ نَحْنُ [h:13275[ٱ]لْمُ[f:13276[نز]ِل[p[ُو]نَ"}, {"id": 5049, "surahId": 56, "ayahNumber": 70, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ", "translationId": "Kalau Kami kehendaki, niscaya Kami jadikan dia asin, maka mengapakah kamu tidak bersyukur?", "textTajweed": "لَوْ نَش[o[َا]ٓءُ جَعَلْنَ[n[ـٰ]هُ أُجَا[f:13277[جًا ف]َلَوْلَا تَشْكُر[p[ُو]نَ"}, {"id": 5050, "surahId": 56, "ayahNumber": 71, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ", "translationId": "Maka terangkanlah kepadaku tentang api yang kamu nyalakan (dengan menggosok-gosokkan kayu).", "textTajweed": "أَفَرَءَيْتُمُ [h:13278[ٱ][l[ل][g[نّ]َارَ [h:114[ٱ]لَّتِى تُور[p[ُو]نَ"}, {"id": 5051, "surahId": 56, "ayahNumber": 72, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ", "translationId": "Kamukah yang menjadikan kayu itu atau Kamikah yang menjadikannya?", "textTajweed": "ءَأَ[f:716[نت]ُمْ أَ[f:13279[نش]َأْتُمْ شَجَرَتَه[o[َآ] أَمْ نَحْنُ [h:13280[ٱ]لْمُ[f:13281[نش]ِــٔ[p[ُو]نَ"}, {"id": 5052, "surahId": 56, "ayahNumber": 73, "juzNumber": 27, "ainNumber": 470, "isAinEnd": false, "textUthmani": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ", "translationId": "Kami jadikan api itu untuk peringatan dan bahan yang berguna bagi musafir di padang pasir.", "textTajweed": "نَحْنُ جَعَلْنَ[n[ـٰ]هَا تَذْكِرَ[a:13282[ةً و]َمَتَ[n[ـٰ][u:13283[عًا ل]ِّلْمُ[q:13284[قْ]و[p[ِي]نَ"}, {"id": 5053, "surahId": 56, "ayahNumber": 74, "juzNumber": 27, "ainNumber": 470, "isAinEnd": true, "textUthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "translationId": "Maka bertasbihlah dengan (menyebut) nama Rabbmu Yang Maha Besar.", "textTajweed": "فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:13286[ٱ]لْعَظ[p[ِي]مِ"}, {"id": 5054, "surahId": 56, "ayahNumber": 75, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ", "translationId": "Maka Aku bersumpah dengan masa turunnya bagian-bagian Al-Quran.", "textTajweed": "۞ فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِمَو[n[َٲ]قِعِ [h:13288[ٱ][l[ل][g[نّ]ُج[p[ُو]مِ"}, {"id": 5055, "surahId": 56, "ayahNumber": 76, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ", "translationId": "Sesungguhnya sumpah itu adalah sumpah yang besar kalau kamu mengetahui.", "textTajweed": "وَإِ[g[نّ]َهُ[n[ۥ] لَقَسَ[u:13289[مٌ ل]َّوْ تَعْلَمُونَ عَظ[p[ِي]مٌ"}, {"id": 5056, "surahId": 56, "ayahNumber": 77, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ", "translationId": "Sesungguhnya Al-Quran ini adalah bacaan yang sangat mulia,", "textTajweed": "إِ[g[نّ]َهُ[n[ۥ] لَقُرْءَا[f:13290[نٌ ك]َر[p[ِي]مٌ"}, {"id": 5057, "surahId": 56, "ayahNumber": 78, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ", "translationId": "pada kitab yang terpelihara (Lauhul Mahfuzh),", "textTajweed": "فِى كِتَ[n[ـٰ][a:13291[بٍ م]َّكْن[p[ُو]نٍ"}, {"id": 5058, "surahId": 56, "ayahNumber": 79, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ", "translationId": "tidak menyentuhnya kecuali orang-orang yang disucikan.", "textTajweed": "لَّا يَمَسُّهُ[o[ۥٓ] إِلَّا [h:13292[ٱ]لْمُطَهَّر[p[ُو]نَ"}, {"id": 5059, "surahId": 56, "ayahNumber": 80, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "translationId": "Diturunkan dari Rabbil 'alamiin.", "textTajweed": "تَ[f:11949[نز]ِي[a:12045[لٌ م]ّ[u:4772[ِن ر]َّبِّ [h:4[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}, {"id": 5060, "surahId": 56, "ayahNumber": 81, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ", "translationId": "Maka apakah kamu menganggap remeh saja Al-Quran ini?", "textTajweed": "أَفَبِهَ[n[ـٰ]ذَا [h:13293[ٱ]لْحَدِيثِ أَ[f:428[نت][w:13294[ُم م]ُّ[q:13295[دْ]هِن[p[ُو]نَ"}, {"id": 5061, "surahId": 56, "ayahNumber": 82, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ", "translationId": "kamu mengganti rezeki (yang Allah berikan) dengan mendustakan Allah.", "textTajweed": "وَتَ[q:11964[جْ]عَلُونَ رِزْقَكُمْ أَ[g[نّ]َكُمْ تُكَذِّب[p[ُو]نَ"}, {"id": 5062, "surahId": 56, "ayahNumber": 83, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ", "translationId": "Maka mengapa ketika nyawa sampai di kerongkongan,", "textTajweed": "فَلَوْل[o[َآ] إِذَا بَلَغَتِ [h:13296[ٱ]لْحُلْق[p[ُو]مَ"}, {"id": 5063, "surahId": 56, "ayahNumber": 84, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ", "translationId": "padahal kamu ketika itu melihat,", "textTajweed": "وَأَ[f:98[نت]ُمْ حِينَئِ[f:13297[ذٍ ت]َ[f:248[نظ]ُر[p[ُو]نَ"}, {"id": 5064, "surahId": 56, "ayahNumber": 85, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ", "translationId": "dan Kami lebih dekat kepadanya dari pada kamu. Tetapi kamu tidak melihat,", "textTajweed": "وَنَحْنُ أَ[q:1355[قْ]رَبُ إِلَيْهِ مِ[f:344[نك]ُمْ وَلَ[n[ـٰ]ك[u:46[ِن ل]َّا تُ[q:8674[بْ]صِر[p[ُو]نَ"}, {"id": 5065, "surahId": 56, "ayahNumber": 86, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ", "translationId": "maka mengapa jika kamu tidak dikuasai (oleh Allah)?", "textTajweed": "فَلَوْل[o[َآ] إِ[f:109[ن ك]ُ[f:100[نت]ُمْ غَيْرَ مَدِين[p[ِي]نَ"}, {"id": 5066, "surahId": 56, "ayahNumber": 87, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ", "translationId": "Kamu tidak mengembalikan nyawa itu (kepada tempatnya) jika kamu adalah orang-orang yang benar?", "textTajweed": "تَرْجِعُونَه[o[َآ] إِ[f:109[ن ك]ُ[f:100[نت]ُمْ صَ[n[ـٰ]دِق[p[ِي]نَ"}, {"id": 5067, "surahId": 56, "ayahNumber": 88, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ", "translationId": "adapun jika dia (orang yang mati) termasuk orang-orang yang didekatkan (kepada Allah),", "textTajweed": "فَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنَ [h:13298[ٱ]لْمُقَرَّب[p[ِي]نَ"}, {"id": 5068, "surahId": 56, "ayahNumber": 89, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ", "translationId": "maka dia memperoleh ketenteraman dan rezeki serta jannah kenikmatan.", "textTajweed": "فَرَوْ[a:13299[حٌ و]َرَيْحَا[a:13300[نٌ و]َجَ[g[نّ]َتُ نَع[p[ِي]مٍ"}, {"id": 5069, "surahId": 56, "ayahNumber": 90, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "translationId": "Dan adapun jika dia termasuk golongan kanan,", "textTajweed": "وَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنْ أَصْحَ[n[ـٰ]بِ [h:13301[ٱ]لْيَم[p[ِي]نِ"}, {"id": 5070, "surahId": 56, "ayahNumber": 91, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ", "translationId": "maka keselamatanlah bagimu karena kamu dari golongan kanan.", "textTajweed": "فَسَلَ[n[ـٰ][u:13302[مٌ ل]َّكَ مِنْ أَصْحَ[n[ـٰ]بِ [h:13301[ٱ]لْيَم[p[ِي]نِ"}, {"id": 5071, "surahId": 56, "ayahNumber": 92, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ", "translationId": "Dan adapun jika dia termasuk golongan yang mendustakan lagi sesat,", "textTajweed": "وَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنَ [h:13303[ٱ]لْمُكَذِّبِينَ [h:13304[ٱ][l[ل]ضّ[m[َا]ٓلّ[p[ِي]نَ"}, {"id": 5072, "surahId": 56, "ayahNumber": 93, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "فَنُزُلٌۭ مِّنْ حَمِيمٍۢ", "translationId": "maka dia mendapat hidangan air yang mendidih,", "textTajweed": "فَنُزُ[a:13305[لٌ م]ِّنْ حَم[p[ِي]مٍ"}, {"id": 5073, "surahId": 56, "ayahNumber": 94, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "وَتَصْلِيَةُ جَحِيمٍ", "translationId": "dan dibakar di dalam jahannam.", "textTajweed": "وَتَصْلِيَةُ جَح[p[ِي]مٍ"}, {"id": 5074, "surahId": 56, "ayahNumber": 95, "juzNumber": 27, "ainNumber": 471, "isAinEnd": false, "textUthmani": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ", "translationId": "Sesungguhnya (yang disebutkan ini) adalah suatu keyakinan yang benar.", "textTajweed": "إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَهُوَ حَقُّ [h:13306[ٱ]لْيَق[p[ِي]نِ"}, {"id": 5075, "surahId": 56, "ayahNumber": 96, "juzNumber": 27, "ainNumber": 471, "isAinEnd": true, "textUthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "translationId": "Maka bertasbihlah dengan (menyebut) nama Rabbmu yang Maha Besar.", "textTajweed": "فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:13286[ٱ]لْعَظ[p[ِي]مِ"}]}