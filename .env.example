# ========================================================
# QuranWeb - Docker Deployment Environment Variables
# ========================================================
# Salin berkas ini menjadi .env sebelum menjalankan docker compose:
# cp .env.example .env

# Port Ekspos Aplikasi Web (Nginx Frontend)
WEB_PORT=3382

# Port Ekspos Database PostgreSQL ke Host
DB_PORT=5572

# Port Internal Service Backend API
API_PORT=4000

# Kredensial Database PostgreSQL
POSTGRES_DB=quranweb
POSTGRES_USER=quran_user
POSTGRES_PASSWORD=quran_secret_password

# Node Environment
NODE_ENV=production
