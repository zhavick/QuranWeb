{"surah": {"id": 103, "nameArabic": "سُورَةُ العَصۡرِ", "nameLatin": "Al-Asr", "translationId": "Masa", "revelationPlace": "Makkiyah", "totalAyahs": 3}, "ayahs": [{"id": 6177, "surahId": 103, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 545, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ", "translationId": "Demi masa.", "textTajweed": "وَ[h:9999[ٱ]لْعَصْرِ"}, {"id": 6178, "surahId": 103, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 545, "isAinEnd": false, "textUthmani": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ", "translationId": "Sesungguhnya manusia itu benar-benar dalam kerugian,", "textTajweed": "إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَفِى خُسْرٍ"}, {"id": 6179, "surahId": 103, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 545, "isAinEnd": true, "textUthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ", "translationId": "kecuali orang-orang yang beriman dan mengerjakan amal saleh dan nasehat menasehati supaya mentaati kebenaran dan nasehat menasehati supaya menetapi kesabaran.", "textTajweed": "إِلَّا [h:778[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ وَتَوَاصَوْ[s[اْ] بِ[h:370[ٱ]لْحَقِّ وَتَوَاصَوْ[s[اْ] بِ[h:223[ٱ][l[ل]صَّ[q:223[بْ]رِ"}]}