{"surah": {"id": 55, "nameArabic": "سُورَةُ الرَّحۡمَٰن", "nameLatin": "Ar-Rahmaan", "translationId": "Yang Maha Pemurah", "revelationPlace": "Madaniyah", "totalAyahs": 78}, "ayahs": [{"id": 4902, "surahId": 55, "ayahNumber": 1, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ", "translationId": "(Tuhan) Yang Maha Pemurah,", "textTajweed": "ٱ[l[ل]رَّحْمَ[p[ـٰ]نُ"}, {"id": 4903, "surahId": 55, "ayahNumber": 2, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "عَلَّمَ ٱلْقُرْءَانَ", "translationId": "Yang telah mengajarkan al Quran.", "textTajweed": "عَلَّمَ [h:13123[ٱ]لْقُرْء[p[َا]نَ"}, {"id": 4904, "surahId": 55, "ayahNumber": 3, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "خَلَقَ ٱلْإِنسَٰنَ", "translationId": "Dia menciptakan manusia.", "textTajweed": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[p[ـٰ]نَ"}, {"id": 4905, "surahId": 55, "ayahNumber": 4, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "عَلَّمَهُ ٱلْبَيَانَ", "translationId": "Mengajarnya pandai berbicara.", "textTajweed": "عَلَّمَهُ [h:13124[ٱ]لْبَي[p[َا]نَ"}, {"id": 4906, "surahId": 55, "ayahNumber": 5, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ", "translationId": "Matahari dan bulan (beredar) menurut perhitungan.", "textTajweed": "ٱ[l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ بِحُسْب[p[َا]نٍ"}, {"id": 4907, "surahId": 55, "ayahNumber": 6, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ", "translationId": "Dan tumbuh-tumbuhan dan pohon-pohonan kedua-duanya tunduk kepada-Nya.", "textTajweed": "وَ[h:9999[ٱ][l[ل][g[نّ]َ[q:13125[جْ]مُ وَ[h:8958[ٱ][l[ل]شَّجَرُ يَسْجُد[p[َا]نِ"}, {"id": 4908, "surahId": 55, "ayahNumber": 7, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ", "translationId": "Dan Allah telah meninggikan langit dan Dia meletakkan neraca (keadilan).", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءَ رَفَعَهَا وَوَضَعَ [h:13126[ٱ]لْمِيز[p[َا]نَ"}, {"id": 4909, "surahId": 55, "ayahNumber": 8, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ", "translationId": "Supaya kamu jangan melampaui batas tentang neraca itu.", "textTajweed": "أَلَّا تَ[q:6515[طْ]غَوْ[s[اْ] فِى [h:13127[ٱ]لْمِيز[p[َا]نِ"}, {"id": 4910, "surahId": 55, "ayahNumber": 9, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ", "translationId": "Dan tegakkanlah timbangan itu dengan adil dan janganlah kamu mengurangi neraca itu.", "textTajweed": "وَأَقِيمُو[s[اْ] [h:13128[ٱ]لْوَزْنَ بِ[h:1800[ٱ]لْقِسْطِ وَلَا تُخْسِرُو[s[اْ] [h:13129[ٱ]لْمِيز[p[َا]نَ"}, {"id": 4911, "surahId": 55, "ayahNumber": 10, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ", "translationId": "Dan Allah telah meratakan bumi untuk makhluk(Nya).", "textTajweed": "وَ[h:9999[ٱ]لْأَرْضَ وَضَعَهَا لِلْأَن[p[َا]مِ"}, {"id": 4912, "surahId": 55, "ayahNumber": 11, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ", "translationId": "Di bumi itu ada buah-buahan dan pohon kurma yang mempunyai kelopak mayang.", "textTajweed": "فِيهَا فَ[n[ـٰ]كِهَ[a:13130[ةٌ و]َ[h:13131[ٱ][l[ل][g[نّ]َخْلُ ذَاتُ [h:13132[ٱ]لْأَكْم[p[َا]مِ"}, {"id": 4913, "surahId": 55, "ayahNumber": 12, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ", "translationId": "Dan biji-bijian yang berkulit dan bunga-bunga yang harum baunya.", "textTajweed": "وَ[h:9999[ٱ]لْحَبُّ ذُو [h:13133[ٱ]لْعَصْفِ وَ[h:13134[ٱ][l[ل]رَّيْح[p[َا]نُ"}, {"id": 4914, "surahId": 55, "ayahNumber": 13, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4915, "surahId": 55, "ayahNumber": 14, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ", "translationId": "Dia menciptakan manusia dari tanah kering seperti tembikar,", "textTajweed": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِ[f:7229[ن ص]َلْصَ[n[ـٰ][f:13135[لٍ ك]َ[h:13136[ٱ]لْفَخّ[p[َا]رِ"}, {"id": 4916, "surahId": 55, "ayahNumber": 15, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ", "translationId": "dan Dia menciptakan jin dari nyala api.", "textTajweed": "وَخَلَقَ [h:13137[ٱ]لْج[m[َا]ٓ[g[نّ]َ م[a:13138[ِن م]َّارِ[a:13139[جٍ م]ّ[a:4598[ِن ن]ّ[p[َا]رٍ"}, {"id": 4917, "surahId": 55, "ayahNumber": 16, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4918, "surahId": 55, "ayahNumber": 17, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ", "translationId": "Tuhan yang memelihara kedua tempat terbit matahari dan Tuhan yang memelihara kedua tempat terbenamnya", "textTajweed": "رَبُّ [h:13140[ٱ]لْمَشْرِقَيْنِ وَرَبُّ [h:13141[ٱ]لْمَغْرِبَ[p[يْ]نِ"}, {"id": 4919, "surahId": 55, "ayahNumber": 18, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4920, "surahId": 55, "ayahNumber": 19, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ", "translationId": "Dia membiarkan dua lautan mengalir yang keduanya kemudian bertemu,", "textTajweed": "مَرَجَ [h:9669[ٱ]لْبَحْرَيْنِ يَلْتَقِي[p[َا]نِ"}, {"id": 4921, "surahId": 55, "ayahNumber": 20, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ", "translationId": "antara keduanya ada batas yang tidak dilampaui masing-masing.", "textTajweed": "بَيْنَهُمَا بَرْزَ[u:13142[خٌ ل]َّا يَ[q:13143[بْ]غِي[p[َا]نِ"}, {"id": 4922, "surahId": 55, "ayahNumber": 21, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4923, "surahId": 55, "ayahNumber": 22, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ", "translationId": "Dari keduanya keluar mutiara dan marjan.", "textTajweed": "يَخْرُجُ مِنْهُمَا [h:13144[ٱ][l[ل]لُّؤْلُؤُ وَ[h:13145[ٱ]لْمَرْج[p[َا]نُ"}, {"id": 4924, "surahId": 55, "ayahNumber": 23, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4925, "surahId": 55, "ayahNumber": 24, "juzNumber": 27, "ainNumber": 466, "isAinEnd": false, "textUthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ", "translationId": "Dan kepunyaan-Nya lah bahtera-bahtera yang tinggi layarnya di lautan laksana gunung-gunung.", "textTajweed": "وَلَهُ [h:13146[ٱ]لْجَوَارِ [h:13147[ٱ]لْمُ[f:13148[نش]َـَٔـاتُ فِى [h:837[ٱ]لْبَحْرِ كَ[h:12143[ٱ]لْأَعْلَ[p[ـٰ]مِ"}, {"id": 4926, "surahId": 55, "ayahNumber": 25, "juzNumber": 27, "ainNumber": 466, "isAinEnd": true, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4927, "surahId": 55, "ayahNumber": 26, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ", "translationId": "Semua yang ada di bumi itu akan binasa.", "textTajweed": "كُلُّ مَنْ عَلَيْهَا ف[p[َا]نٍ"}, {"id": 4928, "surahId": 55, "ayahNumber": 27, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "translationId": "Dan tetap kekal Dzat Tuhanmu yang mempunyai kebesaran dan kemuliaan.", "textTajweed": "وَيَ[q:13149[بْ]قَىٰ وَ[q:603[جْ]هُ رَبِّكَ ذُو [h:13150[ٱ]لْجَلَ[n[ـٰ]لِ وَ[h:13151[ٱ]لْإِكْر[p[َا]مِ"}, {"id": 4929, "surahId": 55, "ayahNumber": 28, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4930, "surahId": 55, "ayahNumber": 29, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ", "translationId": "Semua yang ada di langit dan bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan.", "textTajweed": "يَسْــَٔلُهُ[n[ۥ] مَ[f:2074[ن ف]ِى [h:609[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ‌ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"}, {"id": 4931, "surahId": 55, "ayahNumber": 30, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Rabb-mu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4932, "surahId": 55, "ayahNumber": 31, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ", "translationId": "Kami akan memperhatikan sepenuhnya kepadamu hai manusia dan jin.", "textTajweed": "سَنَفْرُغُ لَكُمْ أَيُّهَ [h:13152[ٱ][l[ل]ثَّقَل[p[َا]نِ"}, {"id": 4933, "surahId": 55, "ayahNumber": 32, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4934, "surahId": 55, "ayahNumber": 33, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ", "translationId": "Hai jama'ah jin dan manusia, jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka lintasilah, kamu tidak dapat menembusnya kecuali dengan kekuatan.", "textTajweed": "يَ[n[ـٰ]مَعْشَرَ [h:4407[ٱ]لْجِ[g[نّ]ِ وَ[h:4418[ٱ]لْإِ[f:4418[نس]ِ إِنِ [h:13153[ٱ]سْتَطَعْتُمْ أَ[f:13154[ن ت]َ[f:13155[نف]ُذُو[s[اْ] مِنْ أَ[q:13156[قْ]طَارِ [h:13157[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ فَ[h:13158[ٱ][f:13158[نف]ُذُو[s[اْ‌ۚ] لَا تَ[f:13159[نف]ُذُونَ إِلَّا بِسُلْطَ[p[ـٰ]نٍ"}, {"id": 4935, "surahId": 55, "ayahNumber": 34, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4936, "surahId": 55, "ayahNumber": 35, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ", "translationId": "Kepada kamu, (jin dan manusia) dilepaskan nyala api dan cairan tembaga maka kamu tidak dapat menyelamatkan diri (dari padanya).", "textTajweed": "يُرْسَلُ عَلَيْكُمَا شُوَا[a:13160[ظٌ م]ّ[a:4598[ِن ن]َّا[a:13161[رٍ و]َنُحَا[f:13162[سٌ ف]َلَا تَ[f:13163[نت]َصِر[p[َا]نِ"}, {"id": 4937, "surahId": 55, "ayahNumber": 36, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4938, "surahId": 55, "ayahNumber": 37, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ", "translationId": "Maka apabila langit telah terbelah dan menjadi merah mawar seperti (kilapan) minyak.", "textTajweed": "فَإِذَا [h:13164[ٱ][f:13165[نش]َقَّتِ [h:13166[ٱ][l[ل]سَّم[o[َا]ٓءُ فَكَانَتْ وَرْدَ[f:13167[ةً ك]َ[h:13168[ٱ][l[ل]دِّه[p[َا]نِ"}, {"id": 4939, "surahId": 55, "ayahNumber": 38, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4940, "surahId": 55, "ayahNumber": 39, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ", "translationId": "Pada waktu itu manusia dan jin tidak ditanya tentang dosanya.", "textTajweed": "فَيَوْمَئِ[u:10538[ذٍ ل]َّا يُسْــَٔلُ عَ[f:13169[ن ذ]َ[i:13170[نۢب]ِه[o[ِۦٓ] إِن[a:13171[سٌ و]َلَا ج[m[َا]ٓ[g[نّ]ٌ"}, {"id": 4941, "surahId": 55, "ayahNumber": 40, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4942, "surahId": 55, "ayahNumber": 41, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ", "translationId": "Orang-orang yang berdosa dikenal dengan tanda-tandannya, lalu dipegang ubun-ubun dan kaki mereka.", "textTajweed": "يُعْرَفُ [h:13172[ٱ]لْمُ[q:5255[جْ]رِمُونَ بِسِيمَ[n[ـٰ]هُمْ فَيُؤْخَذُ بِ[h:13173[ٱ][l[ل][g[نّ]َو[n[َٲ]صِى وَ[h:13174[ٱ]لْأَ[q:13174[قْ]د[p[َا]مِ"}, {"id": 4943, "surahId": 55, "ayahNumber": 42, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4944, "surahId": 55, "ayahNumber": 43, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ", "translationId": "Inilah neraka Jahannam yang didustakan oleh orang-orang berdosa.", "textTajweed": "هَ[n[ـٰ]ذِه[n[ِۦ] جَهَ[g[نّ]َمُ [h:11279[ٱ]لَّتِى يُكَذِّبُ بِهَا [h:13175[ٱ]لْمُ[q:5255[جْ]رِم[p[ُو]نَ"}, {"id": 4945, "surahId": 55, "ayahNumber": 44, "juzNumber": 27, "ainNumber": 467, "isAinEnd": false, "textUthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ", "translationId": "Mereka berkeliling di antaranya dan di antara air mendidih yang memuncak panasnya.", "textTajweed": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ء[p[َا]نٍ"}, {"id": 4946, "surahId": 55, "ayahNumber": 45, "juzNumber": 27, "ainNumber": 467, "isAinEnd": true, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4947, "surahId": 55, "ayahNumber": 46, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ", "translationId": "Dan bagi orang yang takut akan saat menghadap Tuhannya ada dua surga.", "textTajweed": "وَلِمَنْ خَافَ مَقَامَ رَبِّه[n[ِۦ] جَ[g[نّ]َت[p[َا]نِ"}, {"id": 4948, "surahId": 55, "ayahNumber": 47, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?,", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4949, "surahId": 55, "ayahNumber": 48, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "ذَوَاتَآ أَفْنَانٍۢ", "translationId": "kedua surga itu mempunyai pohon-pohonan dan buah-buahan.", "textTajweed": "ذَوَات[o[َآ] أَفْن[p[َا]نٍ"}, {"id": 4950, "surahId": 55, "ayahNumber": 49, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4951, "surahId": 55, "ayahNumber": 50, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ", "translationId": "Di dalam kedua surga itu ada dua buah mata air yang mengalir", "textTajweed": "فِيهِمَا عَيْنَانِ تَ[q:13176[جْ]رِي[p[َا]نِ"}, {"id": 4952, "surahId": 55, "ayahNumber": 51, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4953, "surahId": 55, "ayahNumber": 52, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِمَا مِن كُلِّ فَٰكِهَةٍۢ زَوْجَانِ", "translationId": "Di dalam kedua surga itu terdapat segala macam buah-buahan yang berpasangan.", "textTajweed": "فِيهِمَا مِ[f:843[ن ك]ُلِّ فَ[n[ـٰ]كِهَ[f:13177[ةٍ ز]َوْج[p[َا]نِ"}, {"id": 4954, "surahId": 55, "ayahNumber": 53, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4955, "surahId": 55, "ayahNumber": 54, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ", "translationId": "Mereka bertelekan di atas permadani yang sebelah dalamnya dari sutera. Dan buah-buahan di kedua surga itu dapat (dipetik) dari dekat.", "textTajweed": "مُتَّكِــِٔينَ عَلَىٰ فُرُ[i:13178[شِۭ ب]َط[o[َا]ٓئِنُهَا مِنْ إِسْتَ[q:13179[بْ]رَ[a:13180[قٍ‌ۚ و]َجَنَى [h:13181[ٱ]لْجَ[g[نّ]َتَيْنِ د[p[َا]نٍ"}, {"id": 4956, "surahId": 55, "ayahNumber": 55, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4957, "surahId": 55, "ayahNumber": 56, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "translationId": "Di dalam surga itu ada bidadari-bidadari yang sopan menundukkan pandangannya, tidak pernah disentuh oleh manusia sebelum mereka (penghuni-penghuni surga yang menjadi suami mereka), dan tidak pula oleh jin.", "textTajweed": "فِيهِ[g[نّ]َ قَ[n[ـٰ]صِر[n[َٲ]تُ [h:11365[ٱ][l[ل]طَّرْفِ لَمْ يَ[q:13182[طْ]مِثْهُ[g[نّ]َ إِ[f:13183[نس][f:13184[ٌ ق]َ[q:8394[بْ]لَهُمْ وَلَا ج[m[َا]ٓ[g[نّ]ٌ"}, {"id": 4958, "surahId": 55, "ayahNumber": 57, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4959, "surahId": 55, "ayahNumber": 58, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ", "translationId": "Seakan-akan bidadari itu permata yakut dan marjan.", "textTajweed": "كَأَ[g[نّ]َهُ[g[نّ]َ [h:13185[ٱ]لْيَاقُوتُ وَ[h:13145[ٱ]لْمَرْج[p[َا]نُ"}, {"id": 4960, "surahId": 55, "ayahNumber": 59, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4961, "surahId": 55, "ayahNumber": 60, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ", "translationId": "Tidak ada balasan kebaikan kecuali kebaikan (pula).", "textTajweed": "هَلْ جَز[o[َا]ٓءُ [h:13186[ٱ]لْإِحْسَ[n[ـٰ]نِ إِلَّا [h:13187[ٱ]لْإِحْسَ[p[ـٰ]نُ"}, {"id": 4962, "surahId": 55, "ayahNumber": 61, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4963, "surahId": 55, "ayahNumber": 62, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "وَمِن دُونِهِمَا جَنَّتَانِ", "translationId": "Dan selain dari dua surga itu ada dua surga lagi", "textTajweed": "وَمِ[f:13188[ن د]ُونِهِمَا جَ[g[نّ]َت[p[َا]نِ"}, {"id": 4964, "surahId": 55, "ayahNumber": 63, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4965, "surahId": 55, "ayahNumber": 64, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "مُدْهَآمَّتَانِ", "translationId": "Kedua surga itu (kelihatan) hijau tua warnanya.", "textTajweed": "مُ[q:13189[دْ]ه[m[َا]ٓ[g[مّ]َت[p[َا]نِ"}, {"id": 4966, "surahId": 55, "ayahNumber": 65, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4967, "surahId": 55, "ayahNumber": 66, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ", "translationId": "Di dalam kedua surga itu ada dua buah mata air yang memancar.", "textTajweed": "فِيهِمَا عَيْنَانِ نَضَّاخَت[p[َا]نِ"}, {"id": 4968, "surahId": 55, "ayahNumber": 67, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4969, "surahId": 55, "ayahNumber": 68, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِمَا فَٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ", "translationId": "Di dalam keduanya (ada macam-macam) buah-buahan dan kurma serta delima.", "textTajweed": "فِيهِمَا فَ[n[ـٰ]كِهَ[a:13190[ةٌ و]َنَخْ[a:13191[لٌ و]َرُ[g[مّ][p[َا]نٌ"}, {"id": 4970, "surahId": 55, "ayahNumber": 69, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4971, "surahId": 55, "ayahNumber": 70, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ", "translationId": "Di dalam surga itu ada bidadari-bidadari yang baik-baik lagi cantik-cantik.", "textTajweed": "فِيهِ[g[نّ]َ خَيْر[n[َٲ]تٌ حِس[p[َا]نٌ"}, {"id": 4972, "surahId": 55, "ayahNumber": 71, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4973, "surahId": 55, "ayahNumber": 72, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ", "translationId": "(Bidadari-bidadari) yang jelita, putih bersih, dipingit dalam rumah.", "textTajweed": "حُو[a:13192[رٌ م]َّ[q:13193[قْ]صُور[n[َٲ][f:13194[تٌ ف]ِى [h:13195[ٱ]لْخِي[p[َا]مِ"}, {"id": 4974, "surahId": 55, "ayahNumber": 73, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4975, "surahId": 55, "ayahNumber": 74, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "translationId": "Mereka tidak pernah disentuh oleh manusia sebelum mereka (penghuni-penghuni surga yang menjadi suami mereka), dan tidak pula oleh jin.", "textTajweed": "لَمْ يَ[q:13182[طْ]مِثْهُ[g[نّ]َ إِ[f:13183[نس][f:13184[ٌ ق]َ[q:8394[بْ]لَهُمْ وَلَا ج[m[َا]ٓ[g[نّ]ٌ"}, {"id": 4976, "surahId": 55, "ayahNumber": 75, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4977, "surahId": 55, "ayahNumber": 76, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ", "translationId": "Mereka bertelekan pada bantal-bantal yang hijau dan permadani-permadani yang indah.", "textTajweed": "مُتَّكِــِٔينَ عَلَىٰ رَفْرَفٍ خُضْ[a:13196[رٍ و]َعَ[q:13197[بْ]قَرِىٍّ حِس[p[َا]نٍ"}, {"id": 4978, "surahId": 55, "ayahNumber": 77, "juzNumber": 27, "ainNumber": 468, "isAinEnd": false, "textUthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "translationId": "Maka nikmat Tuhan kamu yang manakah yang kamu dustakan?", "textTajweed": "فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"}, {"id": 4979, "surahId": 55, "ayahNumber": 78, "juzNumber": 27, "ainNumber": 468, "isAinEnd": true, "textUthmani": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "translationId": "Maha Agung nama Tuhanmu Yang Mempunyai Kebesaran dan Karunia.", "textTajweed": "تَبَ[n[ـٰ]رَكَ [h:13198[ٱ]سْمُ رَبِّكَ ذِى [h:13199[ٱ]لْجَلَ[n[ـٰ]لِ وَ[h:13151[ٱ]لْإِكْر[p[َا]مِ"}]}