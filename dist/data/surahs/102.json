{"surah": {"id": 102, "nameArabic": "سُورَةُ التَّكَاثُرِ", "nameLatin": "At-Takaathur", "translationId": "Bermegah-Megahan", "revelationPlace": "Makkiyah", "totalAyahs": 8}, "ayahs": [{"id": 6169, "surahId": 102, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "translationId": "Bermegah-megahan telah melalaikan kamu,", "textTajweed": "أَلْهَ[n[ـٰ]كُمُ [h:14627[ٱ][l[ل]تَّكَاثُرُ"}, {"id": 6170, "surahId": 102, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "translationId": "sampai kamu masuk ke dalam kubur.", "textTajweed": "حَتَّىٰ زُرْتُمُ [h:14628[ٱ]لْمَقَابِرَ"}, {"id": 6171, "surahId": 102, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "كَلَّا سَوْفَ تَعْلَمُونَ", "translationId": "Janganlah begitu, kelak kamu akan mengetahui (akibat perbuatanmu itu),", "textTajweed": "كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ"}, {"id": 6172, "surahId": 102, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "translationId": "dan janganlah begitu, kelak kamu akan mengetahui.", "textTajweed": "ثُ[g[مّ]َ كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ"}, {"id": 6173, "surahId": 102, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "translationId": "Janganlah begitu, jika kamu mengetahui dengan pengetahuan yang yakin,", "textTajweed": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ [h:14629[ٱ]لْيَق[p[ِي]نِ"}, {"id": 6174, "surahId": 102, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "لَتَرَوُنَّ ٱلْجَحِيمَ", "translationId": "niscaya kamu benar-benar akan melihat neraka Jahiim,", "textTajweed": "لَتَرَوُ[g[نّ]َ [h:14630[ٱ]لْجَح[p[ِي]مَ"}, {"id": 6175, "surahId": 102, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 544, "isAinEnd": false, "textUthmani": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "translationId": "dan sesungguhnya kamu benar-benar akan melihatnya dengan 'ainul yaqin.", "textTajweed": "ثُ[g[مّ]َ لَتَرَوُ[g[نّ]َهَا عَيْنَ [h:14631[ٱ]لْيَق[p[ِي]نِ"}, {"id": 6176, "surahId": 102, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 544, "isAinEnd": true, "textUthmani": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "translationId": "kemudian kamu pasti akan ditanyai pada hari itu tentang kenikmatan (yang kamu megah-megahkan di dunia itu).", "textTajweed": "ثُ[g[مّ]َ لَتُسْــَٔلُ[g[نّ]َ يَوْمَئِذٍ عَنِ [h:14632[ٱ][l[ل][g[نّ]َع[p[ِي]مِ"}]}