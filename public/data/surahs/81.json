{"surah": {"id": 81, "nameArabic": "سُورَةُ التَّكۡوِيرِ", "nameLatin": "At-Takwir", "translationId": "Menggulung", "revelationPlace": "Makkiyah", "totalAyahs": 29}, "ayahs": [{"id": 5801, "surahId": 81, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "translationId": "Apabila matahari digulung,", "textTajweed": "إِذَا [h:14331[ٱ][l[ل]شَّمْسُ كُوِّرَتْ"}, {"id": 5802, "surahId": 81, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "translationId": "dan apabila bintang-bintang berjatuhan,", "textTajweed": "وَإِذَا [h:14332[ٱ][l[ل][g[نّ]ُجُومُ [h:14333[ٱ][f:14334[نك]َدَرَتْ"}, {"id": 5803, "surahId": 81, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "translationId": "dan apabila gunung-gunung dihancurkan,", "textTajweed": "وَإِذَا [h:14211[ٱ]لْجِبَالُ سُيِّرَتْ"}, {"id": 5804, "surahId": 81, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "translationId": "dan apabila unta-unta yang bunting ditinggalkan (tidak diperdulikan)", "textTajweed": "وَإِذَا [h:14335[ٱ]لْعِشَارُ عُطِّلَتْ"}, {"id": 5805, "surahId": 81, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "translationId": "dan apabila binatang-binatang liar dikumpulkan,", "textTajweed": "وَإِذَا [h:14336[ٱ]لْوُحُوشُ حُشِرَتْ"}, {"id": 5806, "surahId": 81, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "translationId": "dan apabila lautan dijadikan meluap", "textTajweed": "وَإِذَا [h:14337[ٱ]لْبِحَارُ سُجِّرَتْ"}, {"id": 5807, "surahId": 81, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "translationId": "dan apabila ruh-ruh dipertemukan (dengan tubuh)", "textTajweed": "وَإِذَا [h:14338[ٱ][l[ل][g[نّ]ُفُوسُ زُوِّجَتْ"}, {"id": 5808, "surahId": 81, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "translationId": "dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,", "textTajweed": "وَإِذَا [h:14339[ٱ]لْمَوْءُ[n[ۥ]دَةُ سُئِلَتْ"}, {"id": 5809, "surahId": 81, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "translationId": "karena dosa apakah dia dibunuh,", "textTajweed": "بِأَىِّ ذَ[i:14340[نۢب][f:14341[ٍ ق]ُتِلَتْ"}, {"id": 5810, "surahId": 81, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "translationId": "dan apabila catatan-catatan (amal perbuatan manusia) dibuka,", "textTajweed": "وَإِذَا [h:14342[ٱ][l[ل]صُّحُفُ نُشِرَتْ"}, {"id": 5811, "surahId": 81, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "translationId": "dan apabila langit dilenyapkan,", "textTajweed": "وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ كُشِطَتْ"}, {"id": 5812, "surahId": 81, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "translationId": "dan apabila neraka Jahim dinyalakan,", "textTajweed": "وَإِذَا [h:14343[ٱ]لْجَحِيمُ سُعِّرَتْ"}, {"id": 5813, "surahId": 81, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "translationId": "dan apabila surga didekatkan,", "textTajweed": "وَإِذَا [h:14344[ٱ]لْجَ[g[نّ]َةُ أُزْلِفَتْ"}, {"id": 5814, "surahId": 81, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "translationId": "maka tiap-tiap jiwa akan mengetahui apa yang telah dikerjakannya.", "textTajweed": "عَلِمَتْ نَفْ[a:10644[سٌ م]ّ[o[َآ] أَحْضَرَتْ"}, {"id": 5815, "surahId": 81, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "translationId": "Sungguh, Aku bersumpah dengan bintang-bintang,", "textTajweed": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14345[ٱ]لْخُ[g[نّ]َسِ"}, {"id": 5816, "surahId": 81, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ", "translationId": "yang beredar dan terbenam,", "textTajweed": "ٱلْجَوَارِ [h:14346[ٱ]لْكُ[g[نّ]َسِ"}, {"id": 5817, "surahId": 81, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "translationId": "demi malam apabila telah hampir meninggalkan gelapnya,", "textTajweed": "وَ[h:9999[ٱ]لَّيْلِ إِذَا عَسْعَسَ"}, {"id": 5818, "surahId": 81, "ayahNumber": 18, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "translationId": "dan demi subuh apabila fajarnya mulai menyingsing,", "textTajweed": "وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذَا تَنَفَّسَ"}, {"id": 5819, "surahId": 81, "ayahNumber": 19, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "translationId": "sesungguhnya Al Quran itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril),", "textTajweed": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ"}, {"id": 5820, "surahId": 81, "ayahNumber": 20, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "translationId": "yang mempunyai kekuatan, yang mempunyai kedudukan tinggi di sisi Allah yang mempunyai 'Arsy,", "textTajweed": "ذِى قُوَّةٍ عِ[f:264[ند]َ ذِى [h:7769[ٱ]لْعَرْشِ مَك[p[ِي]نٍ"}, {"id": 5821, "surahId": 81, "ayahNumber": 21, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "translationId": "yang ditaati di sana (di alam malaikat) lagi dipercaya.", "textTajweed": "مُّطَا[f:14347[عٍ ث]َ[g[مّ]َ أَم[p[ِي]نٍ"}, {"id": 5822, "surahId": 81, "ayahNumber": 22, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "translationId": "Dan temanmu (Muhammad) itu bukanlah sekali-kali orang yang gila.", "textTajweed": "وَمَا صَاحِبُك[c:14348[ُم ب]ِمَ[q:13812[جْ]ن[p[ُو]نٍ"}, {"id": 5823, "surahId": 81, "ayahNumber": 23, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "translationId": "Dan sesungguhnya Muhammad itu melihat Jibril di ufuk yang terang.", "textTajweed": "وَلَقَ[q:341[دْ] رَءَاهُ بِ[h:12961[ٱ]لْأُفُقِ [h:14349[ٱ]لْمُب[p[ِي]نِ"}, {"id": 5824, "surahId": 81, "ayahNumber": 24, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "translationId": "Dan dia (Muhammad) bukanlah orang yang bakhil untuk menerangkan yang ghaib.", "textTajweed": "وَمَا هُوَ عَلَى [h:2453[ٱ]لْغَيْبِ بِضَن[p[ِي]نٍ"}, {"id": 5825, "surahId": 81, "ayahNumber": 25, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "translationId": "Dan Al Quran itu bukanlah perkataan syaitan yang terkutuk,", "textTajweed": "وَمَا هُوَ بِقَوْلِ شَيْطَ[n[ـٰ][u:7213[نٍ ر]َّج[p[ِي]مٍ"}, {"id": 5826, "surahId": 81, "ayahNumber": 26, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "فَأَيْنَ تَذْهَبُونَ", "translationId": "maka ke manakah kamu akan pergi?", "textTajweed": "فَأَيْنَ تَذْهَب[p[ُو]نَ"}, {"id": 5827, "surahId": 81, "ayahNumber": 27, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "translationId": "Al Quran itu tiada lain hanyalah peringatan bagi semesta alam,", "textTajweed": "إِنْ هُوَ إِلَّا ذِكْ[u:6839[رٌ ل]ِّلْعَ[n[ـٰ]لَم[p[ِي]نَ"}, {"id": 5828, "surahId": 81, "ayahNumber": 28, "juzNumber": 30, "ainNumber": 523, "isAinEnd": false, "textUthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "translationId": "(yaitu) bagi siapa di antara kamu yang mau menempuh jalan yang lurus.", "textTajweed": "لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14350[َن ي]َسْتَق[p[ِي]مَ"}, {"id": 5829, "surahId": 81, "ayahNumber": 29, "juzNumber": 30, "ainNumber": 523, "isAinEnd": true, "textUthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "translationId": "Dan kamu tidak dapat menghendaki (menempuh jalan itu) kecuali apabila dikehendaki Allah, Tuhan semesta alam.", "textTajweed": "وَمَا تَش[o[َا]ٓءُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ رَبُّ [h:4750[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}]}