{"surah": {"id": 86, "nameArabic": "سُورَةُ الطَّارِقِ", "nameLatin": "At-Taariq", "translationId": "Yang Datang di Malam Hari", "revelationPlace": "Makkiyah", "totalAyahs": 17}, "ayahs": [{"id": 5932, "surahId": 86, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ", "translationId": "Demi langit dan yang datang pada malam hari,", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ"}, {"id": 5933, "surahId": 86, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "translationId": "tahukah kamu apakah yang datang pada malam hari itu?", "textTajweed": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ"}, {"id": 5934, "surahId": 86, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ", "translationId": "(yaitu) bintang yang cahayanya menembus,", "textTajweed": "ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ"}, {"id": 5935, "surahId": 86, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "translationId": "tidak ada suatu jiwapun (diri) melainkan ada penjaganya.", "textTajweed": "إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ"}, {"id": 5936, "surahId": 86, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "translationId": "Maka hendaklah manusia memperhatikan dari apakah dia diciptakan?", "textTajweed": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ"}, {"id": 5937, "surahId": 86, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "translationId": "Dia diciptakan dari air yang dipancarkan,", "textTajweed": "خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ"}, {"id": 5938, "surahId": 86, "ayahNumber": 7, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "translationId": "yang keluar dari antara tulang sulbi laki-laki dan tulang dada perempuan.", "textTajweed": "يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ"}, {"id": 5939, "surahId": 86, "ayahNumber": 8, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "translationId": "Sesungguhnya Allah benar-benar kuasa untuk mengembalikannya (hidup sesudah mati).", "textTajweed": "إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ"}, {"id": 5940, "surahId": 86, "ayahNumber": 9, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "translationId": "Pada hari dinampakkan segala rahasia,", "textTajweed": "يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ"}, {"id": 5941, "surahId": 86, "ayahNumber": 10, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "translationId": "maka sekali-kali tidak ada bagi manusia itu suatu kekuatanpun dan tidak (pula) seorang penolong.", "textTajweed": "فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ"}, {"id": 5942, "surahId": 86, "ayahNumber": 11, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "translationId": "Demi langit yang mengandung hujan", "textTajweed": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ"}, {"id": 5943, "surahId": 86, "ayahNumber": 12, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "translationId": "dan bumi yang mempunyai tumbuh-tumbuhan,", "textTajweed": "وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ"}, {"id": 5944, "surahId": 86, "ayahNumber": 13, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "translationId": "sesungguhnya Al Quran itu benar-benar firman yang memisahkan antara yang hak dan yang bathil.", "textTajweed": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ"}, {"id": 5945, "surahId": 86, "ayahNumber": 14, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "وَمَا هُوَ بِٱلْهَزْلِ", "translationId": "dan sekali-kali bukanlah dia senda gurau.", "textTajweed": "وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ"}, {"id": 5946, "surahId": 86, "ayahNumber": 15, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "translationId": "Sesungguhnya orang kafir itu merencanakan tipu daya yang jahat dengan sebenar-benarnya.", "textTajweed": "إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا"}, {"id": 5947, "surahId": 86, "ayahNumber": 16, "juzNumber": 30, "ainNumber": 528, "isAinEnd": false, "textUthmani": "وَأَكِيدُ كَيْدًۭا", "translationId": "Dan Akupun membuat rencana (pula) dengan sebenar-benarnya.", "textTajweed": "وَأَكِيدُ كَيْدًا"}, {"id": 5948, "surahId": 86, "ayahNumber": 17, "juzNumber": 30, "ainNumber": 528, "isAinEnd": true, "textUthmani": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "translationId": "Karena itu beri tangguhlah orang-orang kafir itu yaitu beri tangguhlah mereka itu barang sebentar.", "textTajweed": "فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا"}]}