{"surah": {"id": 109, "nameArabic": "سُورَةُ الكَافِرُونَ", "nameLatin": "Al-Kaafiroon", "translationId": "Orang-Orang Kafir", "revelationPlace": "Makkiyah", "totalAyahs": 6}, "ayahs": [{"id": 6208, "surahId": 109, "ayahNumber": 1, "juzNumber": 30, "ainNumber": 551, "isAinEnd": false, "textUthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ", "translationId": "Katakanlah: \"Hai orang-orang kafir,", "textTajweed": "قُلْ يَ[o[ـٰٓ]أَيُّهَا [h:14663[ٱ]لْكَ[n[ـٰ]فِر[p[ُو]نَ"}, {"id": 6209, "surahId": 109, "ayahNumber": 2, "juzNumber": 30, "ainNumber": 551, "isAinEnd": false, "textUthmani": "لَآ أَعْبُدُ مَا تَعْبُدُونَ", "translationId": "Aku tidak akan menyembah apa yang kamu sembah.", "textTajweed": "ل[o[َآ] أَعْبُدُ مَا تَعْبُد[p[ُو]نَ"}, {"id": 6210, "surahId": 109, "ayahNumber": 3, "juzNumber": 30, "ainNumber": 551, "isAinEnd": false, "textUthmani": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "translationId": "Dan kamu bukan penyembah Tuhan yang aku sembah.", "textTajweed": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"id": 6211, "surahId": 109, "ayahNumber": 4, "juzNumber": 30, "ainNumber": 551, "isAinEnd": false, "textUthmani": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ", "translationId": "Dan aku tidak pernah menjadi penyembah apa yang kamu sembah,", "textTajweed": "وَل[o[َآ] أَنَا۟ عَابِ[a:14664[دٌ م]َّا عَبَ[d:14665[د]تُّمْ"}, {"id": 6212, "surahId": 109, "ayahNumber": 5, "juzNumber": 30, "ainNumber": 551, "isAinEnd": false, "textUthmani": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "translationId": "dan kamu tidak pernah (pula) menjadi penyembah Tuhan yang aku sembah.", "textTajweed": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"id": 6213, "surahId": 109, "ayahNumber": 6, "juzNumber": 30, "ainNumber": 551, "isAinEnd": true, "textUthmani": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ", "translationId": "Untukmu agamamu, dan untukkulah, agamaku\".", "textTajweed": "لَكُمْ دِينُكُمْ وَلِىَ د[p[ِي]نِ"}]}